3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/067166AB0D9FC1000183132373835373934.mp3"},{"id":"064496AB0DA011000183632353832383731","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"技能语音（C）-2","category":"技能","seq":2,"text":"旅途由你定义！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/064496AB0DA011000183632353832383731.mp3"},{"id":"063746AB0DA001000183730363331383730","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"技能语音（B）-2","category":"技能","seq":2,"text":"再来一张！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/063746AB0DA001000183730363331383730.mp3"},{"id":"061556AB0DA001000183136313432343734","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"技能语音（A）-2","category":"技能","seq":2,"text":"行程规划完毕，出发！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/061556AB0DA001000183136313432343734.mp3"},{"id":"063656AB0D9FD1000183434353933393339","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-2","category":"移动","seq":2,"text":"有人负责天马行空，也有人负责安全落地。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/063656AB0D9FD1000183434353933393339.mp3"},{"id":"065066AB0D9FD1000183137393735353832","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"大厅语音-2","category":"大厅","seq":2,"text":"心有所向，路有所往！","hasText":true,"duration":13,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/065066AB0D9FD1000183137393735353832.mp3"},{"id":"065336AB0DA011000183637373230303039","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"技能语音（C）-3","category":"技能","seq":3,"text":"快门按下，时光暂停！","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/065336AB0DA011000183637373230303039.mp3"},{"id":"060626AB0D9FE1000183733313430383732","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-3","category":"移动","seq":3,"text":"构图完美的照片要留下，笑到模糊的抓拍也不能丢。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/060626AB0D9FE1000183733313430383732.mp3"},{"id":"063666AB0D9FD1000183630353434313438","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"大厅语音-3","category":"大厅","seq":3,"text":"好风景，就不该只是路过。","hasText":true,"duration":13.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/063666AB0D9FD1000183630353434313438.mp3"},{"id":"064686AB0D9FE1000183530343539323736","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-4","category":"移动","seq":4,"text":"（叹气）算准了今天的天气，没算准某人的临时起意。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/064686AB0D9FE1000183530343539323736.mp3"},{"id":"069086AB0D9FE1000183139303131373534","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-5","category":"移动","seq":5,"text":"驱蚊液、雨伞、备用药……外加一颗欢迎意外的心。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/069086AB0D9FE1000183139303131373534.mp3"},{"id":"062866AB0D9FE1000183131363232353739","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-6","category":"移动","seq":6,"text":"与其一直向往，不如即刻启程！","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/062866AB0D9FE1000183131363232353739.mp3"},{"id":"065756AB0D9FF1000183639343131373438","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-7","category":"移动","seq":7,"text":"攻略做了七八版，总有一版对得上她的脑回路……（迟疑）吧。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/065756AB0D9FF1000183639343131373438.mp3"},{"id":"062716AB0D9FF1000183636393331323736","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"移动语音-8","category":"移动","seq":8,"text":"计划让我们准时出发，但意外让我们真正抵达。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/062716AB0D9FF1000183636393331323736.mp3"},{"id":"062336AB0DA021000183939373236333336","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"相遇语音（友方-166亚瑟|安琪拉）-S1_L4","category":"相遇","seq":166,"text":"我猜你的“计划”分成了三部分：出发、随缘、以及“哎呀忘了”。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/062336AB0DA021000183939373236333336.mp3"},{"id":"069326AB0DA021000183136383835393737","heroId":"237","skinId":"1786","skinName":"旅行日记","title":"相遇语音（友方-166亚瑟|安琪拉）-S1_L1","category":"相遇","seq":166,"text":"天气预报说今天可能下雨，我带了雨衣和防水鞋套。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/069326AB0DA021000183136383835393737.mp3"},{"id":"06226692952AC1000183738393138333136","heroId":"237","skinId":"609","skinName":"圣骑之力","title":"亚瑟-拾年声藏贺文","category":"台词","seq":null,"text":"实话说，我很喜欢老亚瑟这个称呼。\n自拿起这把剑，已有十年了吧？\n从一无所知到慢慢熟练，直到背负起王者的荣耀……\n相信你和我一样，从未忘记过，骑士永不背叛的誓言！\n下个十年，让我们以圣剑的名义，继续冲锋","hasText":true,"duration":24.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/06226692952AC1000183738393138333136.mp3"},{"id":"0608565C2EBE11000183138393836313933","heroId":"237","skinId":"609","skinName":"圣骑之力","title":"亚瑟_我福了","category":"台词","seq":null,"text":"我福了","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/0608565C2EBE11000183138393836313933.mp3"},{"id":"0666065C2EC091000183631373337383138","heroId":"237","skinId":"609","skinName":"圣骑之力","title":"亚瑟_新年快乐","category":"台词","seq":null,"text":"新年快乐","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/0666065C2EC091000183631373337383138.mp3"},{"id":"0642265C2EC411000183134393036343734","heroId":"237","skinId":"609","skinName":"圣骑之力","title":"亚瑟_我在王者峡谷藏了三千万，在线等一个全能高手帮我解除封印！","category":"台词","seq":null,"text":"我在王者峡谷藏了三千万，在线等一个全能高手帮我解除封印！","hasText":true,"duration":25.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/0642265C2EC411000183134393036343734.mp3"},{"id":"06366648BE96D1000183139323934373933","heroId":"237","skinId":"609","skinName":"圣骑之力","title":"亚瑟_圣骑之力_技能语音3","category":"技能","seq":null,"text":"Excalibur！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/237/06366648BE96D1000183139323934373933.mp3"},{"id":"06903648BE
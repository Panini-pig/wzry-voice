06880648BE6481000183934393731373339.mp3"},{"id":"06006648BE6481000183338323333323638","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_进入蓝区野区","category":"台词","seq":null,"text":"比风景更美的，是旅途中的人和故事。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06006648BE6481000183338323333323638.mp3"},{"id":"06027648BE6481000183634343932323838","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_路过河道遇见河道灵","category":"台词","seq":null,"text":"你也有自己的萤火，只是暂时看不见而已。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06027648BE6481000183634343932323838.mp3"},{"id":"06126648BE6471000183136363334363134","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_重生1","category":"复活","seq":null,"text":"这一页故事讲完了，让我们翻开下一页。","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06126648BE6471000183136363334363134.mp3"},{"id":"06565648BE6471000183136353739333137","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_重生2","category":"复活","seq":null,"text":"桑启，是不会垂头丧气的。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06565648BE6471000183136353739333137.mp3"},{"id":"06027648BE6471000183137393538373337","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_低血量回城","category":"回城","seq":null,"text":"有故事和萤火的地方，就是家乡。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06027648BE6471000183137393538373337.mp3"},{"id":"06962648BE6471000183131323935393537","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_出生","category":"台词","seq":null,"text":"我会去许多地方，许多，伙伴们都想去的地方。","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/119/06962648BE6471000183131323935393537.mp3"},{"id":"06314648BE6441000183130363735343131","heroId":"119","skinId":"803","skinName":"萤火之旅","title":"桑启_萤火之旅_普攻治疗队友1","category":"台词","seq":null,"text":"生","hasText":true,"duration":1,"audio":
32.mp3"},{"id":"0699869A695DF1000183536383735363536","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"回城","category":"回城","seq":null,"text":"回首无人间，举目皆仇雠。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0699869A695DF1000183536383735363536.mp3"},{"id":"0695269A695DF1000183135373330303538","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"个性待机","category":"待机","seq":null,"text":"尚不到安枕之时。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0695269A695DF1000183135373330303538.mp3"},{"id":"0614869A695DE1000183334313134323639","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"击杀语音","category":"击杀","seq":null,"text":"下一个，又会是谁？","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0614869A695DE1000183334313134323639.mp3"},{"id":"0666169A695DE1000183834303835373631","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"击杀语音","category":"击杀","seq":null,"text":"就为这无边夜色，再添一盏魂灯！","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0666169A695DE1000183834303835373631.mp3"},{"id":"0641769A695DE1000183136373431373630","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"挑衅语音","category":"挑衅","seq":null,"text":"假面戴久了，可还记得自己的真容？","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0641769A695DE1000183136373431373630.mp3"},{"id":"0682969A695DC1000183331333434343336","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话2","category":"移动","seq":null,"text":"琼浆化作脓血，珍馐尽是腐肉，金阙实为鬼国！","hasText":true,"duration":11.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0682969A695DC1000183331333434343336.mp3"},{"id":"0629269A695DE1000183131363033363530","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话9","category":"移动","seq":null,"text":"花面逢迎，世情如鬼；嗜痂之癖，举世一辙。","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0629269A695DE1000183131363033363530.mp3"},{"id":"0683769A695DD1000183931353537393936","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话6","category":"移动","seq":null,"text":"满城奇珍又与我何干？我只要阿姊归来！","hasText":true,"duration":6.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0683769A695DD1000183931353537393936.mp3"},{"id":"0670369A695DC1000183134323733333937","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话4","category":"移动","seq":null,"text":"活下去，无论以何种方式。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0670369A695DC1000183134323733333937.mp3"},{"id":"0657169A695DC1000183130393837333035","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话5","category":"移动","seq":null,"text":"这风中呜咽，皆是未雪之冤。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0657169A695DC1000183130393837333035.mp3"},{"id":"0654269A695DD1000183132353937343236","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话8","category":"移动","seq":null,"text":"那引路的舟楫，此刻又在何方，垂钓新的血食？","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0654269A695DD1000183132353937343236.mp3"},{"id":"0618869A695DC1000183331343534333236","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话3","category":"移动","seq":null,"text":"披着人皮的鬼，与披着鬼皮的人，世道真是有趣。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0618869A695DC1000183331343534333236.mp3"},{"id":"0655569A695DD1000183134323533383034","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话7","category":"移动","seq":null,"text":"舍得人身化罗刹，必叫恶鬼伪装——无所遁形！","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0655569A695DD1000183134323533383034.mp3"},{"id":"0620069A695DA1000183733393337313139","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"大厅出现1","category":"大厅","seq":null,"text":"朱门绮宴，皆是饿鬼道场；罗刹魔窟，也敢妄称人间？！","hasText":true,"duration":18,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0620069A695DA1000183733393337313139.mp3"},{"id":"0638969A695DB1000183131373338343336","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"移动喊话1","category":"移动","seq":null,"text":"她说海市有仙药，能治人间百病……可真正的良方，是掌中利刃！","hasText":true,"duration":9.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0638969A695DB1000183131373338343336.mp3"},{"id":"0617669A695DB1000183334323538383532","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"大厅出现3","category":"大厅","seq":null,"text":"焚尽煌煌海市，照见枯骨如山！","hasText":true,"duration":16.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0617669A695DB1000183334323538383532.mp3"},{"id":"0649769A695DB1000183138323235383339","heroId":"199","skinId":"1724","skinName":"罗刹妄海","title":"大厅出现2","category":"大厅","seq":null,"text":"仇寇骨铸刃，故人血淬锋，请诸位——共赴黄泉！","hasText":true,"duration":16.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/0649769A695DB1000183138323235383339.mp3"},{"id":"06575692952791000183231373035313636","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲-拾年声藏贺文","category":"台词","seq":null,"text":"别紧张，是我。\n跟在你后面的尾巴，我已经解决了。\n别那么惊讶。\n毕竟，利刃出现，就总得有人流血，不是么？\n放心开启下个十年的旅程吧。\n我这飘忽不定的身法，于敌人是致命的。\n但于你，是可以绝对安心的存在","hasText":true,"duration":24.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06575692952791000183231373035313636.mp3"},{"id":"06758648BED9D1000183530333130353032","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"别打这主意，谢谢了。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06758648BED9D1000183530333130353032.mp3"},{"id":"06656648BED9D1000183137363333333334","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"藏起刀来，重要的是节奏。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06656648BED9D1000183137363333333334.mp3"},{"id":"06571648BED9D1000183937343731373732","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"（短暂的大笑——让演员看视频）ahahahahahahahaha ahahaha","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06571648BED9D1000183937343731373732.mp3"},{"id":"06217648BED9C1000183339343830353837","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"没哭！眼睛里进沙子了！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06217648BED9C1000183339343830353837.mp3"},{"id":"06321648BED9C1000183536353135393236","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"包容失败，却不会包容轻率的失败！","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06321648BED9C1000183536353135393236.mp3"},{"id":"06647648BED9C1000183436393737343738","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"长得漂亮不如干得漂亮，而你两样都做到了。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06647648BED9C1000183436393737343738.mp3"},{"id":"06529648BED9C1000183734373238363935","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_个性动作","category":"动作","seq":null,"text":"我知道你不会怕输，你只会怕我","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06529648BED9C1000183734373238363935.mp3"},{"id":"06292648BED9A1000183138383537353431","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_击杀语音","category":"击杀","seq":null,"text":"永别了！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06292648BED9A1000183138383537353431.mp3"},{"id":"06200648BED9A1000183136333335353734","heroId":"199","skinId":"563","skinName":"信念之刃","title":"阿轲_信念之刃_技能语音3","category":"技能","seq":null,"text":"就是偷袭！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/199/06200648BED9A1000183136333335353734.mp3"},{"id":"06711648BED9A1000183133313532333537","heroId":"199","skinId":"563","skinName":"信念
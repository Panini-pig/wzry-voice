[{"id":"064276503CB541000183132313632353331","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"大厅语音","category":"大厅","seq":null,"text":"寄希望于神明，不如亲手撕碎这黑夜！","hasText":true,"duration":17.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/064276503CB541000183132313632353331.mp3"},{"id":"065136503CB541000183736383731383238","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"大厅语音","category":"大厅","seq":null,"text":"地火煅体，天雷淬身，凭我残躯，洞穿地狱！","hasText":true,"duration":17.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/065136503CB541000183736383731383238.mp3"},{"id":"069436503CB551000183230343133303135","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"在世人眼中，此地囚禁的都是十恶不赦之徒……包括我。","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/069436503CB551000183230343133303135.mp3"},{"id":"062176503CB551000183137363334363237","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"欲盖弥彰，抑焰弥旺。","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/062176503CB551000183137363334363237.mp3"},{"id":"068016503CB541000183131383138313937","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"大厅语音","category":"大厅","seq":null,"text":"地狱不空，心火不休。","hasText":true,"duration":17.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/068016503CB541000183131383138313937.mp3"},{"id":"064406503CB551000183335363334303134","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"这方天地倒也有些铁骨铮铮的汉子。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/064406503CB551000183335363334303134.mp3"},{"id":"061486503CB551000183134393838313234","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"高高在上的地狱之主，（嗤笑声），也是被神明遗弃的可怜虫。","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/061486503CB551000183134393838313234.mp3"},{"id":"068476503CB551000183231373136363537","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"焚尽旧日，方能迎来新生。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/068476503CB551000183231373136363537.mp3"},{"id":"065646503CB561000183133323937373538","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"一技能语音","category":"技能","seq":null,"text":"一往无前！","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/065646503CB561000183133323937373538.mp3"},{"id":"069316503CB561000183535343439343336","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"烈火不能带来真正的光明，但至少能让它来得早一些。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/069316503CB561000183535343439343336.mp3"},{"id":"066316503CB561000183830323734323639","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"一技能语音","category":"技能","seq":null,"text":"如火掠行！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/066316503CB561000183830323734323639.mp3"},{"id":"065746503CB551000183730333133353136","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"移动语音","category":"移动","seq":null,"text":"自谓终天路，忽然下沉渊。（选自曹植《吁嗟篇》）","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/065746503CB551000183730333133353136.mp3"},{"id":"061486503CB561000183136363935303639","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"二技能语音","category":"技能","seq":null,"text":"诸行无常！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/061486503CB561000183136363935303639.mp3"},{"id":"067186503CB571000183138323936383039","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"三技能语音","category":"技能","seq":null,"text":"灼灼地火，煌煌其雷！","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/067186503CB571000183138323936383039.mp3"},{"id":"062226503CB571000183238313139353631","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"三技能语音","category":"技能","seq":null,"text":"万物燃尽！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/062226503CB571000183238313139353631.mp3"},{"id":"063126503CB561000183131333333303830","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"一技能语音","category":"技能","seq":null,"text":"没有退路可言！","hasText":true,"duration":0.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/063126503CB561000183131333333303830.mp3"},{"id":"068546503CB561000183132343238353533","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"一技能语音","category":"技能","seq":null,"text":"火趁风威，遄遄疾行！","hasText":true,"duration":0.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/068546503CB561000183132343238353533.mp3"},{"id":"060806503CB561000183333373531303836","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"二技能语音","category":"技能","seq":null,"text":"摧烧之！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/060806503CB561000183333373531303836.mp3"},{"id":"065756503CB571000183337303338383038","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"击杀语音","category":"击杀","seq":null,"text":"哼，扑火飞蛾。","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/065756503CB571000183337303338383038.mp3"},{"id":"067676503CB571000183539393736353033","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"三技能语音","category":"技能","seq":null,"text":"登临绝顶，日月齐光！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/067676503CB571000183539393736353033.mp3"},{"id":"060586503CB571000183138323839323638","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"特殊动作","category":"动作","seq":null,"text":"长夜漫漫，我自持火前行。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/060586503CB571000183138323839323638.mp3"},{"id":"062836503CB571000183330323137303138","heroId":"133","skinId":"1023","skinName":"地狱燃心","title":"挑衅","category":"挑衅","seq":null,"text":"抱薪救焚，扇火止沸。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/062836503CB571000183330323137303138.mp3"},{"id":"0630367A9CD2B1000183131303531323236","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-蔡文姬-1","category":"相遇","seq":1,"text":"司空震:身为安定之神，一当慎思，二当笃行……","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0630367A9CD2B1000183131303531323236.mp3"},{"id":"0656667A9CD2A1000183835333137323736","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-澜-1","category":"相遇","seq":1,"text":"司空震:“深淘滩，低作堰”……应是后辈杰作，当称百世之功","hasText":true,"duration":9.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0656667A9CD2A1000183835333137323736.mp3"},{"id":"0642867A9CD2C1000183434343739353537","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-女娲-1","category":"相遇","seq":1,"text":"司空震:听闻这世间有些石头，是昔日从高天掉落，坚不可摧","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0642867A9CD2C1000183434343739353537.mp3"},{"id":"0615567A9CD2B1000183138323437323236","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-妲已-1","category":"相遇","seq":1,"text":"司空震:宝印早已修复如初，(笑)门外偷听的小鬼，还不进来看看?","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0615567A9CD2B1000183138323437323236.mp3"},{"id":"0602367A9CD2A1000183931303130353639","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音3_1","category":"技能","seq":1,"text":"执吾印 镇家国!","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0602367A9CD2A1000183931303130353639.mp3"},{"id":"0636967A9CD281000183137333934363936","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音2_1","category":"技能","seq":1,"text":"安民心","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0636967A9CD281000183137333934363936.mp3"},{"id":"0622467A9CD271000183133313632393639","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音1_1","category":"技能","seq":1,"text":"笃行!","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0622467A9CD271000183133313632393639.mp3"},{"id":"0607567A9CD2B1000183133363234393235","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-蔡文姬-2","category":"相遇","seq":2,"text":"司空震:看这灯上福袋满满当当，想来这话已是今日说的第五遍","hasText":true,"duration":8.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0607567A9CD2B1000183133363234393235.mp3"},{"id":"0681467A9CD2C1000183132363337393930","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-女娲-2","category":"相遇","seq":2,"text":"司空震:往古天柱崩断……如今众志相，亦可立地警天，应无忧矣。","hasText":true,"duration":10.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0681467A9CD2C1000183132363337393930.mp3"},{"id":"0622067A9CD2C1000183137393339323737","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-妲已-2","category":"相遇","seq":2,"text":"司空震:见人间传唱者颇多，虽不得甚解……但颇受震撼","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0622067A9CD2C1000183137393339323737.mp3"},{"id":"0640567A9CD2B1000183232373533313635","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"相遇语音-澜-2","category":"相遇","seq":2,"text":"司空震:今夜贺岁，小鬼特意让我叮嘱你“早去早归，莫误了应愿吉时”","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0640567A9CD2B1000183232373533313635.mp3"},{"id":"0606767A9CD291000183132333539353334","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音2_2","category":"技能","seq":2,"text":"成盛景","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0606767A9CD291000183132333539353334.mp3"},{"id":"0601767A9CD2A1000183132333831343434","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音3_2","category":"技能","seq":2,"text":"昭此心 立命天地!","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0601767A9CD2A1000183132333831343434.mp3"},{"id":"0648667A9CD281000183432343836323133","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音1_2","category":"技能","seq":2,"text":"修身!","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0648667A9CD281000183432343836323133.mp3"},{"id":"0618867A9CD291000183234393130333533","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音2_3(变身后)","category":"技能","seq":3,"text":"势镇汪洋!","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0618867A9CD291000183234393130333533.mp3"},{"id":"0608467A9CD2A1000183131393037343231","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音3_3","category":"技能","seq":3,"text":"照彻宇内，印透山河!","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0608467A9CD2A1000183131393037343231.mp3"},{"id":"0648967A9CD281000183135313535313937","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音1_3(变身后)","category":"技能","seq":3,"text":"为天下先!","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0648967A9CD281000183135313535313937.mp3"},{"id":"0605867A9CD291000183134393732363137","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音2_4(变身后)","category":"技能","seq":4,"text":"威宁瑶海!","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0605867A9CD291000183134393732363137.mp3"},{"id":"0692767A9CD281000183835303235393738","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"技能语音1_4(变身后)","category":"技能","seq":4,"text":"应千钧诺!","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0692767A9CD281000183835303235393738.mp3"},{"id":"0631667A9CD261000183530333734373237","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"挑衅","category":"挑衅","seq":null,"text":"进难存，退必亡","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0631667A9CD261000183530333734373237.mp3"},{"id":"0649967A9CD261000183632393536303134","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"击杀","category":"击杀","seq":null,"text":"为民解忧","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0649967A9CD261000183632393536303134.mp3"},{"id":"0651167A9CD271000183536333535313636","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"回城2","category":"回城","seq":null,"text":"众生结愿，天佑人间","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0651167A9CD271000183536333535313636.mp3"},{"id":"0614467A9CD271000183830373637343238","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"个性动作","category":"动作","seq":null,"text":"荏苒光阴，唯一印日日不离","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0614467A9CD271000183830373637343238.mp3"},{"id":"0668267A9CD271000183231333030383935","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"回城1","category":"回城","seq":null,"text":"诸事皆安，愿归星汉","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0668267A9CD271000183231333030383935.mp3"},{"id":"0646667A9CD241000183639313030383033","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音3","category":"移动","seq":null,"text":"刻金石，铭吾誓——许苍生之安乐，诺千秋以岁和","hasText":true,"duration":9.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0646667A9CD241000183639313030383033.mp3"},{"id":"0613967A9CD251000183735313334353735","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音7","category":"移动","seq":null,"text":"城垣横绝塞，长堤锁怒涛，人心垒寸土，天威奈何如","hasText":true,"duration":10.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0613967A9CD251000183735313334353735.mp3"},{"id":"0673467A9CD241000183831313934343837","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音2","category":"移动","seq":null,"text":"吾少登仕路，也曾许志封侯………而今只愿功名尘土，筑为金郭铁城","hasText":true,"duration":12.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0673467A9CD241000183831313934343837.mp3"},{"id":"0603467A9CD251000183133393234343832","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音6","category":"移动","seq":null,"text":"但以此身长报国，何须千古名不朽?","hasText":true,"duration":7.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0603467A9CD251000183133393234343832.mp3"},{"id":"0687767A9CD231000183137393135393538","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音1","category":"移动","seq":null,"text":"狂澜将倾，黎民何宁?——印镇众心，四海承平","hasText":true,"duration":9.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0687767A9CD231000183137393135393538.mp3"},{"id":"0624667A9CD261000183332333539353736","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"死亡","category":"死亡","seq":null,"text":"永持如石心…","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0624667A9CD261000183332333539353736.mp3"},{"id":"0692767A9CD251000183634343134373933","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音8","category":"移动","seq":null,"text":"江山作画，此盛世图景，正宜盖印纪之","hasText":true,"duration":8.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0692767A9CD251000183634343134373933.mp3"},{"id":"0621967A9CD241000183833383536353938","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音4","category":"移动","seq":null,"text":"“载夙载夜，惟民惟邦”，昔时结言于庙堂，江湖虽远未敢忘","hasText":true,"duration":11.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0621967A9CD241000183833383536353938.mp3"},{"id":"0651267A9CD251000183137333332363331","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"移动语音5","category":"移动","seq":null,"text":"所谓治世在边关无患，更在物阜民安","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0651267A9CD251000183137333332363331.mp3"},{"id":"0604767A9CD231000183531303236363430","heroId":"133","skinId":"1443","skinName":"愿照·山河定","title":"大厅语音2","category":"大厅","seq":null,"text":"执镇世之印，护苍生太平--万古存誓!","hasText":true,"duration":22.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/133/0604767A9CD
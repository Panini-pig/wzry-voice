ion":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/064566A3CF1C81000183537373737383036.mp3"},{"id":"063366A3CF1C61000183131363030313739","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"姬小满&赵云_相遇1","category":"相遇","seq":null,"text":"赵云：蟠桃会的请帖到了——这次就交由你们历练。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/063366A3CF1C61000183131363030313739.mp3"},{"id":"061896A3CF1C71000183731393938333334","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"姬小满&赵云_相遇2","category":"相遇","seq":null,"text":"赵云：定风丹上怎么总沾有猫毛……","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/061896A3CF1C71000183731393938333334.mp3"},{"id":"067196A3CF1BB1000183832333935303134","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"回城","category":"回城","seq":null,"text":"放轻松，巳（sì）时考勤，巳时到位即可。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/067196A3CF1BB1000183832333935303134.mp3"},{"id":"069616A3CF1BA1000183132303539353737","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"挑衅","category":"挑衅","seq":null,"text":"难怪此处阴风阵阵，原来 有妖孽作怪。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/069616A3CF1BA1000183132303539353737.mp3"},{"id":"063126A3CF1B91000183135333135333239","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"击杀","category":"击杀","seq":null,"text":"驱魔敕令，封！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/063126A3CF1B91000183135333135333239.mp3"},{"id":"060266A3CF1BC1000183137353430373636","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"个性动作","category":"动作","seq":null,"text":"“食宿全包，法宝任挑”……这样宣传可以吗？","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/060266A3CF1BC1000183137353430373636.mp3"},{"id":"061526A3CF1B91000183136323334373530","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"死亡","category":"死亡","seq":null,"text":"余下的，便交由你们了。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/061526A3CF1B91000183136323334373530.mp3"},{"id":"068616A3CF1B51000183135343432373339","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话4","category":"移动","seq":null,"text":"天条严苛却非无情，革新向善的妖，皆允释放。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/068616A3CF1B51000183135343432373339.mp3"},{"id":"062126A3CF1B91000183535303638393938","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话8","category":"移动","seq":null,"text":"茶要慢品，妖要静候。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/062126A3CF1B91000183535303638393938.mp3"},{"id":"063396A3CF1B41000183632373038373335","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话2","category":"移动","seq":null,"text":"降妖不过分内事，功成不必谢我。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/063396A3CF1B41000183632373038373335.mp3"},{"id":"063056A3CF1B61000183536353931333734","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话5","category":"移动","seq":null,"text":"放心，以两位新秀的身手可轮不到我相助。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/063056A3CF1B61000183536353931333734.mp3"},{"id":"061846A3CF1B71000183135333035363431","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话6","category":"移动","seq":null,"text":"尔等放手去闯，天塌下来，有我顶着。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/061846A3CF1B71000183135333035363431.mp3"},{"id":"067026A3CF1B41000183131343332363830","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话3","category":"移动","seq":null,"text":"近来封印异动频发，是时候下界探访“三千洞府”。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/067026A3CF1B41000183131343332363830.mp3"},{"id":"066716A3CF1B81000183638383734393333","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话7","category":"移动","seq":null,"text":"“零错漏”、“零伤亡”——这样的报告，才不负西行先贤。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/066716A3CF1B81000183638383734393333.mp3"},{"id":"060356A3CF1AF1000183135373738313338","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"大厅喊话1","category":"大厅","seq":null,"text":"我等奉封印局之命，缉拿妖邪——尊驾，可曾见过一黄风怪？","hasText":true,"duration":13,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/060356A3CF1AF1000183135373738313338.mp3"},{"id":"069516A3CF1B21000183137323830323836","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"移动喊话1","category":"移动","seq":null,"text":"不知出勤在外，局内诸事是否如常……","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/069516A3CF1B21000183137323830323836.mp3"},{"id":"067196A3CF1B11000183432363433383830","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"大厅喊话2","category":"大厅","seq":null,"text":"食天之禄，担天之忧，若遇麻烦，随时恭候。","hasText":true,"duration":13,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/067196A3CF1B11000183432363433383830.mp3"},{"id":"066066A3CF1B21000183137333439303436","heroId":"182","skinId":"1760","skinName":"飞龙神将","title":"大厅喊话3","category":"大厅","seq":null,"text":"西行功成，真经镇世——吾辈，定再续百年太平。","hasText":true,"duration":12.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/066066A3CF1B21000183137333439303436.mp3"},{"id":"06541692952B41000183134303736393232","heroId":"182","skinId":"428","skinName":"苍天翔龙","title":"赵云-拾年声藏贺文","category":"台词","seq":null,"text":"十年了……\n阁下可还记得。\n当年你我并肩沙场，七进七出的热血战斗？\n即便曾被背叛与黑暗环伺。\n子龙心中的道义之火也从未熄灭。\n今日再战，岂曰独行？\n且看这龙枪重燃！\n为阁下指明前路。","hasText":true,"duration":23.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06541692952B41000183134303736393232.mp3"},{"id":"0661165C2F06D1000183137343532303431","heroId":"182","skinId":"428","skinName":"苍天翔龙","title":"赵云_我福了","category":"台词","seq":null,"text":"我福了","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/0661165C2F06D1000183137343532303431.mp3"},{"id":"0640065C2F0A1100018393238343132333
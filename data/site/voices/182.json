343530313035","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音10","category":"移动","seq":null,"text":"我们站在这里，只是希望黑暗之后，不要再是黑暗！","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06045648BEA9D1000183136343530313035.mp3"},{"id":"06148648BEA9C1000183738303234323636","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音7","category":"移动","seq":null,"text":"寒潭水，熔岩火，多少日夜淬炼，便只为今日。","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06148648BEA9C1000183738303234323636.mp3"},{"id":"06017648BEA9C1000183933323633353935","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音5","category":"移动","seq":null,"text":"我知九幽下有风，诸山巅有雪，却不知尘世有此哀鸿。","hasText":true,"duration":7.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06017648BEA9C1000183933323633353935.mp3"},{"id":"06735648BEA9C1000183135363337313031","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音6","category":"移动","seq":null,"text":"相柳，你若有九命，便诛你九次，若有千命，便斩你千回。","hasText":true,"duration":8.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06735648BEA9C1000183135363337313031.mp3"},{"id":"06854648BEA9C1000183336393133313633","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音9","category":"移动","seq":null,"text":"逝者无需悲怆，因为我们在，光明就在。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06854648BEA9C1000183336393133313633.mp3"},{"id":"06206648BEA9C1000183138313632383830","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音8","category":"移动","seq":null,"text":"凡人在人间浴血，仙人却在山中避世，这便是你们的修行？","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06206648BEA9C1000183138313632383830.mp3"},{"id":"06986648BEA9B1000183936343635323635","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音4","category":"移动","seq":null,"text":"敬那些虽弱如微草，却依然敢向恶妖挑战的先烈。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06986648BEA9B1000183936343635323635.mp3"},{"id":"06838648BEA9B1000183132343234333739","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_大厅语音3","category":"大厅","seq":null,"text":"苍生有难，命星为引，断枪重铸，永佑神州。","hasText":true,"duration":15.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06838648BEA9B1000183132343234333739.mp3"},{"id":"06999648BEA9B1000183633393737323236","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音3","category":"移动","seq":null,"text":"平生不求大道，但求四海升平。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06999648BEA9B1000183633393737323236.mp3"},{"id":"06234648BEA9B1000183134313735393832","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音1","category":"移动","seq":null,"text":"吾辈神州弟子，岂可向妖邪低首。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06234648BEA9B1000183134313735393832.mp3"},{"id":"06245648BEA9B1000183339353035333734","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_移动语音2","category":"移动","seq":null,"text":"这里是我们的人间，没有谁可以来此放肆！","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06245648BEA9B1000183339353035333734.mp3"},{"id":"06098648BEA9A1000183430373230363833","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_大厅语音2","category":"大厅","seq":null,"text":"死并非不足惧，只是心中有道，便不会退却！","hasText":true,"duration":15.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06098648BEA9A1000183430373230363833.mp3"},{"id":"06122648BEA9A1000183731373138363736","heroId":"182","skinId":"447","skinName":"淬星耀世","title":"赵云_淬星耀世_大厅语音1","category":"大厅","seq":null,"text":"若此人间已没有星辰，那我们便做那唯一的光。","hasText":true,"duration":15.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06122648BEA9A1000183731373138363736.mp3"},{"id":"06526648BEAA61000183533393732363632","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_个性动作","category":"动作","seq":null,"text":"千林过雨，叠嶂如新！","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06526648BEAA61000183533393732363632.mp3"},{"id":"06430648BEAA61000183230363537383232","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_助攻","category":"台词","seq":null,"text":"扶危济困，侠者之道！不必言谢。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06430648BEAA61000183230363537383232.mp3"},{"id":"06527648BEAA61000183135353637333338","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_挑衅","category":"挑衅","seq":null,"text":"先让你三招，如何","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06527648BEAA61000183135353637333338.mp3"},{"id":"06846648BEAA51000183630333739343637","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_技能语音1","category":"技能","seq":null,"text":"扫尽秋风！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06846648BEAA51000183630333739343637.mp3"},{"id":"06421648BEAA51000183932313930333430","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_技能语音1","category":"技能","seq":null,"text":"志在九霄！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06421648BEAA51000183932313930333430.mp3"},{"id":"06426648BEAA51000183835353432373136","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_击杀语音","category":"击杀","seq":null,"text":"略胜一筹，承让。","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06426648BEAA51000183835353432373136.mp3"},{"id":"06170648BEAA51000183132393534353335","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_技能语音1","category":"技能","seq":null,"text":"动掣八方，以克万敌！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06170648BEAA51000183132393534353335.mp3"},{"id":"06053648BEAA41000183135373539313632","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音9","category":"移动","seq":null,"text":"英雄相逢，莫问来处，出枪吧！","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06053648BEAA41000183135373539313632.mp3"},{"id":"06042648BEAA41000183137373433313639","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音7","category":"移动","seq":null,"text":"囿于路数，患于荣辱，枪法恐难进步。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06042648BEAA41000183137373433313639.mp3"},{"id":"06382648BEAA41000183136323932383030","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_死亡语音","category":"死亡","seq":null,"text":"毫厘之间，高下已见。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06382648BEAA41000183136323932383030.mp3"},{"id":"06967648BEAA41000183133323436373331","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音8","category":"移动","seq":null,"text":"枪名为百木，乃先师所托，诚不敢怠慢。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06967648BEAA41000183133323436373331.mp3"},{"id":"06121648BEAA31000183137373331393037","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音4","category":"移动","seq":null,"text":"枪出必有因，或为道义，或为师名。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06121648BEAA31000183137373331393037.mp3"},{"id":"06060648BEAA31000183736343839343634","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音5","category":"移动","seq":null,"text":"当如千年之木，历尽枯荣，参天依旧！","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06060648BEAA31000183736343839343634.mp3"},{"id":"06502648BEAA31000183133313337333032","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音6","category":"移动","seq":null,"text":"振兴师门有千法，吾必择一而终。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06502648BEAA31000183133313337333032.mp3"},{"id":"06316648BEAA31000183131363931373234","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音3","category":"移动","seq":null,"text":"师门训诫：不可恃强凌弱，不可逞凶斗狠。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06316648BEAA31000183131363931373234.mp3"},{"id":"06187648BEAA31000183134353536343939","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音2","category":"移动","seq":null,"text":"朝夕苦练，寒暑不辍，皆为何求？","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06187648BEAA31000183134353536343939.mp3"},{"id":"06042648BEAA21000183130323931363833","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_移动语音1","category":"移动","seq":null,"text":"江湖浩浩，可濯吾枪。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06042648BEAA21000183130323931363833.mp3"},{"id":"06985648BEAA21000183134363632353331","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_大厅语音2","category":"大厅","seq":null,"text":"心不为胜意所据，枪不为盛名所累。","hasText":true,"duration":17.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06985648BEAA21000183134363632353331.mp3"},{"id":"06053648BEAA21000183333363130323430","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_大厅语音3","category":"大厅","seq":null,"text":"战遍三江五湖，魂归山居故处……","hasText":true,"duration":18.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06053648BEAA21000183333363130323430.mp3"},{"id":"06008648BEAA21000183332303131333736","heroId":"182","skinId":"449","skinName":"百木心枪","title":"赵云_百木心枪_大厅语音1","category":"大厅","seq":null,"text":"以枪法明志，以韧心立世。","hasText":true,"duration":17.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/182/06008648BEAA21000183332303131333736.mp3"}]
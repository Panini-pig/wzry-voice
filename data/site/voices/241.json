36363032","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"大厅语音-1","category":"大厅","seq":1,"text":"赎尽前罪，净化世间，督灵司自今日起归来。","hasText":true,"duration":24.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/062346A9FBD391000183332363436363032.mp3"},{"id":"069926A9FBD3A1000183131303532323237","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"移动语音-1","category":"移动","seq":1,"text":"若信得过我，可否和我一同匡扶这天下。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/069926A9FBD3A1000183131303532323237.mp3"},{"id":"068996A9FBD3B1000183535363534343936","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"技能语音（A）-2","category":"技能","seq":2,"text":"藏灵于身，待时而动。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/068996A9FBD3B1000183535363534343936.mp3"},{"id":"065286A9FBD3B1000183430383635383134","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"技能语音（B）-2","category":"技能","seq":2,"text":"重整秩序！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/065286A9FBD3B1000183430383635383134.mp3"},{"id":"062416A9FBD3A1000183930363232383336","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"移动语音-2","category":"移动","seq":2,"text":"一人之仁，可护一人；天下人之仁，方可护天下。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/062416A9FBD3A1000183930363232383336.mp3"},{"id":"066856A9FBD3A1000183137383332333330","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"大厅语音-2","category":"大厅","seq":2,"text":"此地凶险，请站在我身后。","hasText":true,"duration":24.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/066856A9FBD3A1000183137383332333330.mp3"},{"id":"068436A9FBD3C1000183231383232333436","heroId":"241","skinId":"1784","skinName":"督灵司正","title":"技能语音（C）-2","category":"技能","seq":2,"text":"聚灵为盾，护尔周全。","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/241/068436A9FBD3C1000183231383232333436.mp3"},{"id":"065796A9FBD3C1000183632323938313833"
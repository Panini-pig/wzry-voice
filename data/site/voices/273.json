zry.panini-pigs.cn/audio/273/06775648BEB7B1000183730343838383832.mp3"},{"id":"06884648BEB791000183135363438313536","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_移动语音7","category":"移动","seq":null,"text":"听说在世界尽头，相爱的人会获得永远","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06884648BEB791000183135363438313536.mp3"},{"id":"06282648BEB791000183331323335343235","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_死亡语音2","category":"死亡","seq":null,"text":"去往下个起点……","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06282648BEB791000183331323335343235.mp3"},{"id":"06304648BEB791000183733303139343838","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_死亡语音1","category":"死亡","seq":null,"text":"逆风而行……","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06304648BEB791000183733303139343838.mp3"},{"id":"06812648BEB781000183134303439323632","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_移动语音6","category":"移动","seq":null,"text":"命运偶尔也会开些美满的玩笑","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06812648BEB781000183134303439323632.mp3"},{"id":"06663648BEB781000183634393838383534","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_移动语音3","category":"移动","seq":null,"text":"奇迹，源自守护她的心","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06663648BEB781000183634393838383534.mp3"},{"id":"06585648BEB781000183135343237313933","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_移动语音4","category":"移动","seq":null,"text":"从每个不同的起点，奔向同一个你","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/273/06585648BEB781000183135343237313933.mp3"},{"id":"06882648BEB781000183930363939323237","heroId":"273","skinId":"320","skinName":"挚爱之约","title":"孙策_挚爱之约_移动语音2","category":"移动","seq":null,"text":"如果不出去看看，你会以为城堡就是全世界","hasText":true,"durati
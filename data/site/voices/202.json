648BED401000183634303031323932","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-廉颇","category":"台词","seq":null,"text":"来一张航拍的武馆全家福吗？","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06256648BED401000183634303031323932.mp3"},{"id":"06774648BED401000183832333530333738","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-廉颇","category":"台词","seq":null,"text":"我也可以一起拍照吗？","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06774648BED401000183832333530333738.mp3"},{"id":"06254648BED401000183130393630343235","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-裴擒虎","category":"台词","seq":null,"text":"孙膑：一个武馆学徒，一个凡人英雄！\n裴擒虎：（笑）把我拍得帅一点～","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06254648BED401000183130393630343235.mp3"},{"id":"06078648BED401000183133323338393130","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-裴擒虎","category":"台词","seq":null,"text":"裴擒虎：嘿小家伙～今天打算拍些什么？\n孙膑：你的拳法真是太酷了，可以放进我的vlog里吗？","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06078648BED401000183133323338393130.mp3"},{"id":"06367648BED401000183139353830343634","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-鲁班七号","category":"台词","seq":null,"text":"鲁班七号：我也想上天看看！\n（孙膑答）嗯...带你可以，带上橘猫就超重啦……","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06367648BED401000183139353830343634.mp3"},{"id":"06327648BED3F1000183836383339393935","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_首杀","category":"击杀","seq":null,"text":"这段素材一定要加入我的vlog里！","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06327648BED3F1000183836383339393935.mp3"},{"id":"06256648BED3F1000183132313338323533","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-鲁班七号","category":"台词","seq":null,"text":"（孙膑问）能让大黄当我虎年vlog的吉祥物吗？\n鲁班七号：当然！只要你交……嗯...两个小鱼干做压岁粮~","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06256648BED3F1000183132313338323533.mp3"},{"id":"06960648BED3F1000183131393430323031","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_击杀语音","category":"击杀","seq":null,"text":"记录完毕！又拍到了不错的素材。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06960648BED3F1000183131393430323031.mp3"},{"id":"06975648BED3F1000183134353938363039","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-杨玉环1","category":"台词","seq":null,"text":"孙膑：在我最失落的时候，你的琴音曾是温暖我的光。 杨玉环：琴声治愈的不止听者的心，还有演奏者的生命。","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06975648BED3F1000183134353938363039.mp3"},{"id":"06522648BED3F1000183130393834343033","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_遇见队友-杨玉环2","category":"台词","seq":null,"text":"孙膑：我想把你的歌声通过vlog带给全世界。\n杨玉环：愿琴声借你的翅膀，飞向更远的远方。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06522648BED3F1000183130393834343033.mp3"},{"id":"06083648BED3E1000183137383333383535","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_挑衅","category":"挑衅","seq":null,"text":"你的每一次失败，都会成为我的素材。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06083648BED3E1000183137383333383535.mp3"},{"id":"06810648BED3E1000183131393635373635","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_特殊动作","category":"动作","seq":null,"text":"嘿，你看见虎神了吗？","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06810648BED3E1000183131393635373635.mp3"},{"id":"06923648BED3B1000183137383731373733","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_死亡语音","category":"死亡","seq":null,"text":"岁岁平安……","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06923648BED3B1000183137383731373733.mp3"},{"id":"06254648BED3B1000183738393437373531","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_死亡语音","category":"死亡","seq":null,"text":"岁岁平安……","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06254648BED3B1000183738393437373531.mp3"},{"id":"06130648BED3A1000183634383731363738","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_移动语音3","category":"移动","seq":null,"text":"第二个新年愿望嘛，祝大家岁岁平安！","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06130648BED3A1000183634383731363738.mp3"},{"id":"06068648BED3A1000183636393433383536","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_移动语音5","category":"移动","seq":null,"text":"虎神之力，皆在人心！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06068648BED3A1000183636393433383536.mp3"},{"id":"06738648BED3A1000183135323038393835","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_移动语音2","category":"移动","seq":null,"text":"小虎糕是虎神街必备的年食，你的家乡过年吃些什么呢？","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06738648BED3A1000183135323038393835.mp3"},{"id":"06560648BED3A1000183134333131383631","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_移动语音4","category":"移动","seq":null,"text":"当我找到我们，奇迹谱写传说。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06560648BED3A1000183134333131383631.mp3"},{"id":"06753648BED3A1000183135373938323237","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_移动语音1","category":"移动","seq":null,"text":"3——2——1！大家好，我是虎神的记录者。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06753648BED3A1000183135373938323237.mp3"},{"id":"06282648BED391000183131343931383936","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_开场语音","category":"台词","seq":null,"text":"神虎一跃，威震天地！","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06282648BED391000183131343931383936.mp3"},{"id":"06385648BED391000183433353636373033","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_大厅语音3","category":"大厅","seq":null,"text":"虎年快乐！/只要相信光，就可以学会飞翔！/今年准备怎么过年呢？/欢迎评论区告诉我哦。","hasText":true,"duration":19.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06385648BED391000183433353636373033.mp3"},{"id":"06106648BED391000183339383934393035","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_大厅语音1","category":"大厅","seq":null,"text":"行走，记录，每个人都是故事的主角/无数个主角成就了我们的世界/同此心，共此力！","hasText":true,"duration":18.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06106648BED391000183339383934393035.mp3"},{"id":"06865648BED391000183137323834373738","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼_大厅语音2","category":"大厅","seq":null,"text":"今天是新春特别vlog~/带大家记录最真实的虎神街/我的第一个新年愿望嘛——/大家看完之后点赞收藏哦。","hasText":true,"duration":20.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/06865648BED391000183137323834373738.mp3"},{"id":"067436478611D1000183533303032353339","heroId":"202","skinId":"599","skinName":"寅虎·展翼","title":"孙膑_寅虎·展翼","category":"台词","seq":null,"text":"孙膑_寅虎·展翼","hasText":false,"duration":196.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/202/067436478611D1000183533303032353339.mp3"}]
.mp3"},{"id":"06683648BE8471000183732333938393832","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_挑衅","category":"挑衅","seq":null,"text":"我大师兄要是知道了，饶不了你们！","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06683648BE8471000183732333938393832.mp3"},{"id":"06796648BE8471000183436383136353538","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_击杀语音","category":"击杀","seq":null,"text":"瞧你的模样，还不如我老猪呢！","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06796648BE8471000183436383136353538.mp3"},{"id":"06686648BE8471000183137383734353736","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_击杀语音","category":"击杀","seq":null,"text":"瞧你的模样，还不如我老猪呢！","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06686648BE8471000183137383734353736.mp3"},{"id":"06541648BE8471000183137383033333735","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_死亡语音","category":"死亡","seq":null,"text":"猴哥，救我......","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06541648BE8471000183137383033333735.mp3"},{"id":"06491648BE8461000183830353730343037","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_死亡语音","category":"死亡","seq":null,"text":"猴哥，救我......","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06491648BE8461000183830353730343037.mp3"},{"id":"06651648BE8451000183336323134333437","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_IDLE语音","category":"台词","seq":null,"text":"heiheiheihei","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06651648BE8451000183336323134333437.mp3"},{"id":"06926648BE8451000183131373332333732","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_IDLE语音","category":"台词","seq":null,"text":"e..eheihei...","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06926648BE8451000183131373332333732.mp3"},{"id":"06783648BE8411000183239303936373633","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音7","category":"移动","seq":null,"text":"丈母娘，好生看待小姐。老猪此去，取经不成我还回来的。","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06783648BE8411000183239303936373633.mp3"},{"id":"06471648BE8411000183736393231323731","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音8","category":"移动","seq":null,"text":"吃完这顿，我就减肥","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06471648BE8411000183736393231323731.mp3"},{"id":"06452648BE8401000183133373136363639","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音2","category":"移动","seq":null,"text":"山连山，路弯弯。什么时候走出山呐这？我老猪都快饿昏了。","hasText":true,"duration":8.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06452648BE8401000183133373136363639.mp3"},{"id":"06157648BE8401000183938313636313437","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音6","category":"移动","seq":null,"text":"啊？我这模样？（哼哼）除了师父，咱们几人啊谁也别说谁！","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06157648BE8401000183938313636313437.mp3"},{"id":"06804648BE8401000183130373839353738","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音4","category":"移动","seq":null,"text":"我老猪本是上界的天蓬元帅，不想下界之后错投了猪胎。","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06804648BE8401000183130373839353738.mp3"},{"id":"06311648BE8401000183634303332343131","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音3","category":"移动","seq":null,"text":"师父准是灯草做的，风一刮就跑了。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06311648BE8401000183634303332343131.mp3"},{"id":"06615648BE8401000183835363034373832","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音5","category":"移动","seq":null,"text":"这儿无人无烟，又无妖无怪，怕什么呀！","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06615648BE8401000183835363034373832.mp3"},{"id":"06294648BE83F1000183834313438303434","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_大厅出现2","category":"大厅","seq":null,"text":"娘子，你怎么这么重啊你……我实在是，实在是走不动了。","hasText":true,"duration":16,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06294648BE83F1000183834313438303434.mp3"},{"id":"06112648BE83F1000183137313039313937","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_大厅出现3","category":"大厅","seq":null,"text":"（孙悟空：天蓬元帅，你看看我是谁？）你这个弼马温——（摔醒后）又来欺负我！","hasText":true,"duration":16,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06112648BE83F1000183137313039313937.mp3"},{"id":"06964648BE83F1000183532343038353734","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_移动语音1","category":"移动","seq":null,"text":"咱们把行李分了，你回你的花果山，我回我的高老庄。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06964648BE83F1000183532343038353734.mp3"},{"id":"06374648BE83F1000183630363136363534","heroId":"69","skinId":"95","skinName":"猪悟能","title":"猪八戒_猪悟能_大厅出现1","category":"大厅","seq":null,"text":"猪八戒：娘子，你好大的手劲啊你。","hasText":true,"duration":16,"audio":"https://audio.wzry.panini-pigs.cn/audio/69/06374648BE83F1000183630363136363534.mp3"}]
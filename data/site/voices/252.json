dio/252/0645069F0493D1000183338353830373533.mp3"},{"id":"0678669F0493D1000183638383831373734","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音5","category":"移动","seq":null,"text":"当魔丸我一样活得开心。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0678669F0493D1000183638383831373734.mp3"},{"id":"0651869F0493E1000183131353239323238","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音6","category":"移动","seq":null,"text":"你说就我这形象，会不会给人第一印象，不太好啊。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0651869F0493E1000183131353239323238.mp3"},{"id":"0679569F0493E1000183133343331303237","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音8","category":"移动","seq":null,"text":"从来生死都看淡，专和老天对着干。我命由我不由天，小爷非要当神仙。","hasText":true,"duration":11.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0679569F0493E1000183133343331303237.mp3"},{"id":"0655969F0493E1000183536373532383139","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音7","category":"移动","seq":null,"text":"一起踢毽子吗？","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0655969F0493E1000183536373532383139.mp3"},{"id":"0611069F0493C1000183737353632353537","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音1","category":"移动","seq":null,"text":"我乃哪吒三太子，能降妖来会作诗，今日到此除奸恶，尔等妖孽快受死！","hasText":true,"duration":11.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0611069F0493C1000183737353632353537.mp3"},{"id":"0679169F0493D1000183138313230323734","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音3","category":"移动","seq":null,"text":"我黑眼圈天生的。","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0679169F0493D1000183138313230323734.mp3"},{"id":"0631769F0493D1000183432393730313839","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"移动语音4","category":"移动","seq":null,"text":"打架，我最擅长了。","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0631769F0493D1000183432393730313839.mp3"},{"id":"0685169F0493C1000183134323836343839","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"大厅出现2","category":"大厅","seq":null,"text":"小吒：天地无量乾坤圈。\n大吒小吒声音重叠：急急如律令。\n大吒：给我——破！","hasText":true,"duration":14.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0685169F0493C1000183134323836343839.mp3"},{"id":"0681869F0493C1000183135383736333439","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"大厅出现3","category":"大厅","seq":null,"text":"小吒：若命运不公，就和它斗到底。\n大吒：若天地不容，我就扭转这乾坤！","hasText":true,"duration":13.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0681869F0493C1000183135383736333439.mp3"},{"id":"0634169F0493B1000183733383639393332","heroId":"252","skinId":"1741","skinName":"魔丸·哪吒","title":"大厅出现1","category":"大厅","seq":null,"text":"小吒：是魔是仙今后就得我自己来选。\n大吒：我命由我不由天！","hasText":true,"duration":13.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/0634169F0493B1000183733383639393332.mp3"},{"id":"06741695F20641000183733373030323038","heroId":"252","skinId":"445","skinName":"桀骜炎枪","title":"大禹友2","category":"台词","seq":null,"text":"哪吒：怎么会……欸？我的风火轮怎么自己动了？欸欸欸，先走一步了——！","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/06741695F20641000183733373030323038.mp3"},{"id":"06443695F20631000183132323737343431","heroId":"252","skinId":"445","skinName":"桀骜炎枪","title":"大禹友1","category":"台词","seq":null,"text":"哪吒：所以，这就是你信里说的“事出紧急”？","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/06443695F20631000183132323737343431.mp3"},{"id":"062636929529E1000183137363935303231","heroId":"252","skinId":"445","skinName":"桀骜炎枪","title":"哪吒-拾年声藏贺文","category":"台词","seq":null,"text":"哎，没想到桀骜如我，竟也有要当值的一天……\n啊？什么收编？\n明明是小爷我大发善心。\n那奇迹司没了我，看他们打得过谁？\n嗯~当值归当值，朋友交情照旧。\n要搞大事，别忘了叫一声。\n甭管多远，踏火而来，瞬间","hasText":true,"duration":21.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/252/062636929529E1000183137363935303231.mp3"},{"id":"0674568D8F71E1000183
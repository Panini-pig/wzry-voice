ry.panini-pigs.cn/audio/125/069996A39F8C71000183134333730353533.mp3"},{"id":"068996A39F8C81000183135303932313730","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"挑衅","category":"挑衅","seq":null,"text":"施主心藏戾气，故形貌显此恶相。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/068996A39F8C81000183135303932313730.mp3"},{"id":"063056A39F8C71000183434323037313530","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"击杀语音","category":"击杀","seq":null,"text":"世道艰辛，望好自为之吧。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/063056A39F8C71000183434323037313530.mp3"},{"id":"061896A39F8C71000183635393334373434","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"死亡语音","category":"死亡","seq":null,"text":"此役无人……可独善其身。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/061896A39F8C71000183635393334373434.mp3"},{"id":"065416A39F8C61000183836373538313730","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话5","category":"移动","seq":null,"text":"人间乃有情之地，不比灵山规矩众多。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/065416A39F8C61000183836373538313730.mp3"},{"id":"062706A39F8C61000183130303835353833","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话4","category":"移动","seq":null,"text":"此去降妖前路未卜，险危难测，幸有众生助我前行。","hasText":true,"duration":7.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/062706A39F8C61000183130303835353833.mp3"},{"id":"069966A39F8C51000183431323339363835","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话1","category":"移动","seq":null,"text":"吾名金蝉，是为人间行者，而非灵山的取经人。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/069966A39F8C51000183431323339363835.mp3"},{"id":"063046A39F8C61000183238353035343438","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话3","category":"移动","seq":null,"text":"不除小恶恐以成大患，不积小善无以成大德。","hasText":true,"duration":7.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/063046A39F8C61000183238353035343438.mp3"},{"id":"062466A39F8C51000183136333335333632","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话2","category":"移动","seq":null,"text":"昔年坛前悟法，难明“普度”二字，今踏此乱世，寻至善之径。","hasText":true,"duration":9.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/062466A39F8C51000183136333335333632.mp3"},{"id":"066886A39F8C51000183137363036343334","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"大厅喊话3","category":"大厅","seq":null,"text":"所谓众生善恶，不在其形，皆在其心。","hasText":true,"duration":14.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/066886A39F8C51000183137363036343334.mp3"},{"id":"067926A39F8C71000183335363534303534","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"移动喊话6","category":"移动","seq":null,"text":"敢问释尊，若一昧持守严苛，又如何广纳众生？","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/067926A39F8C71000183335363534303534.mp3"},{"id":"067156A39F8C41000183132323839313431","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"大厅喊话1","category":"大厅","seq":null,"text":"大善固然重要，小善亦不可缺。","hasText":true,"duration":14.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/067156A39F8C41000183132323839313431.mp3"},{"id":"065526A39F8C51000183330363232373831","heroId":"125","skinId":"1755","skinName":"济世禅心","title":"大厅喊话2","category":"大厅","seq":null,"text":"至理之道，非悬于九天，乃存于人间。","hasText":true,"duration":15.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/065526A39F8C51000183330363232373831.mp3"},{"id":"06842648BE4CB1000183132303133343534","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_挑衅_1","category":"挑衅","seq":1,"text":"业障不除，苍生难度","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06842648BE4CB1000183132303133343534.mp3"},{"id":"06876648BE4CB1000183133333839343633","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_挑衅_2","category":"挑衅","seq":2,"text":"善恶到头终有报","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06876648BE4CB1000183133333839343633.mp3"},{"id":"06570648BE4CC1000183134303036363335","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_技能语音2_3（2段击杀）","category":"击杀","seq":3,"text":"九九归一，终成正果","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06570648BE4CC1000183134303036363335.mp3"},{"id":"06252648BE4CC1000183930353235393438","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_技能语音3_3（2段击杀）","category":"击杀","seq":3,"text":"普渡众生","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06252648BE4CC1000183930353235393438.mp3"},{"id":"064526A38F41E1000183431363734343732","heroId":"125","skinId":"807","skinName":"渡世行者","title":"孙悟空1友","category":"台词","seq":null,"text":"金蝉：那便做这苦和尚。直到有一日，众生都能如你一般，自己走出苦海。","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/064526A38F41E1000183431363734343732.mp3"},{"id":"064696A38F41F1000183231303839323135","heroId":"125","skinId":"807","skinName":"渡世行者","title":"孙悟空2友","category":"台词","seq":null,"text":"金蝉：悟空，慢些。前路未明，为师与你同往。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/064696A38F41F1000183231303839323135.mp3"},{"id":"068046A3901AD1000183136363938383533","heroId":"125","skinId":"807","skinName":"渡世行者","title":"六耳2友","category":"台词","seq":null,"text":"金蝉：贫僧初离东土时，也不知路在何方。如今行过千山，方知路就在脚下。","hasText":true,"duration":9.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/068046A3901AD1000183136363938383533.mp3"},{"id":"064666A3901AD1000183133303032353430","heroId":"125","skinId":"807","skinName":"渡世行者","title":"六耳1友","category":"台词","seq":null,"text":"金蝉：爱吃桃、懂悲喜、会发问，你名六耳。与此众生，有何分别？","hasText":true,"duration":9.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/064666A3901AD1000183133303032353430.mp3"},{"id":"060826929528F1000183133393732383135","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉-拾年声藏贺文","category":"台词","seq":null,"text":"善哉，这些年来见施主心向光明，贫僧甚慰。\n此一路向西山高水长，劫波重重。\n但贫僧相信只要你我心灯不灭，此行必至。\n未来的日子愿施主能持善念，破迷障。\n待贫僧踏过三千世界取得真经，再与施主共赏晨曦。","hasText":true,"duration":33,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/060826929528F1000183133393732383135.mp3"},{"id":"06768648BE4CC1000183130323530343135","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_击杀语音3","category":"击杀","seq":null,"text":"小惩以大诫，净心自思量","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06768648BE4CC1000183130323530343135.mp3"},{"id":"06085648BE4CC1000183731373435353534","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_击杀语音2","category":"击杀","seq":null,"text":"身心如莲，净脱俗世，淤泥不染","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06085648BE4CC1000183731373435353534.mp3"},{"id":"06623648BE4CC1000183132343737323434","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_击杀语音1","category":"击杀","seq":null,"text":"心生，种种魔生；心灭，种种魔灭","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06623648BE4CC1000183132343737323434.mp3"},{"id":"06068648BE4C71000183931373536323032","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_被（猪八戒）击杀","category":"击杀","seq":null,"text":"唉，自心迷，则愚则凡；自心悟，则智则圣","hasText":true,"duration":8,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06068648BE4C71000183931373536323032.mp3"},{"id":"06006648BE4C71000183135373038303838","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_击杀（孙悟空）","category":"击杀","seq":null,"text":"悟空，听师父的话","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06006648BE4C71000183135373038303838.mp3"},{"id":"06980648BE4C71000183131323333353833","heroId":"125","skinId":"807","skinName":"渡世行者","title":"金蝉_渡世行者_被（孙悟空）击杀","category":"击杀","seq":null,"text":"泼猴，仍旧顽劣不化","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/125/06980648BE4C71000183131323333353833.mp3"},{"id"
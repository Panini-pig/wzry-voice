heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"相遇3-花木兰","category":"相遇","seq":null,"text":"它就在眼前，从未远去。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0608567AC55431000183132383037303038.mp3"},{"id":"0646967AC55421000183634303236373435","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"个性动作","category":"动作","seq":null,"text":"这段旋律，关于一颗星如何在深空外独鸣。","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0646967AC55421000183634303236373435.mp3"},{"id":"0600467AC55431000183531393434313636","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"相遇2-王昭君","category":"相遇","seq":null,"text":"合奏一首故乡的歌谣，或许能让你安心。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0600467AC55431000183531393434313636.mp3"},{"id":"0637467AC55431000183630343734323938","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"相遇1-王昭君","category":"相遇","seq":null,"text":"谢谢你的礼物，还不曾有人歌唱对我的印象。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0637467AC55431000183630343734323938.mp3"},{"id":"0602067AC55401000183933383539373536","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"击杀","category":"击杀","seq":null,"text":"来去留声。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0602067AC55401000183933383539373536.mp3"},{"id":"0641067AC553F1000183232363738313638","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话7","category":"移动","seq":null,"text":"新灵感来自一处被思念的故乡。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0641067AC553F1000183232363738313638.mp3"},{"id":"0696867AC55401000183434373535323236","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"挑衅","category":"挑衅","seq":null,"text":"并非人人都能留下绝唱。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0696867AC55401000183434373535323236.mp3"},{"id":"0647067AC553F1000183135353238363830","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话8","category":"移动","seq":null,"text":"当时间停止转动，诸天不再变幻，所有的故事仍会在旋律里传唱。","hasText":true,"duration":9.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0647067AC553F1000183135353238363830.mp3"},{"id":"0617967AC55401000183732303637343439","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"回城","category":"回城","seq":null,"text":"我们遥遥相望，以微光回应微光。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0617967AC55401000183732303637343439.mp3"},{"id":"0649267AC55401000183130373230313437","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"死亡","category":"死亡","seq":null,"text":"会再次将你看见……","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0649267AC55401000183130373230313437.mp3"},{"id":"0611467AC553E1000183730353638363435","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话3","category":"移动","seq":null,"text":"我的姓名，同驱散黑暗的千万颗星一样。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0611467AC553E1000183730353638363435.mp3"},{"id":"0638567AC553F1000183737303134313232","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话6","category":"移动","seq":null,"text":"那场永夜的梦里，何人的歌声将我唤醒？","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0638567AC553F1000183737303134313232.mp3"},{"id":"0696867AC553D1000183135383936323735","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"大厅出现3","category":"大厅","seq":null,"text":"去唱，去存在，去闪耀。","hasText":true,"duration":20.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0696867AC553D1000183135383936323735.mp3"},{"id":"0662867AC553D1000183936373235323431","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话1","category":"移动","seq":null,"text":"宇宙之中，生命的响动从未止息。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0662867AC553D1000183936373235323431.mp3"},{"id":"0619667AC553D1000183132383934323139","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话2","category":"移动","seq":null,"text":"此歌，为无人处的盛放而鸣；此曲，为蒙尘时的闪光而奏。","hasText":true,"duration":9.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0619667AC553D1000183132383934323139.mp3"},{"id":"0631167AC553E1000183933343632333338","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话5","category":"移动","seq":null,"text":"听~流星坠落时，总有铮铮回响。","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0631167AC553E1000183933343632333338.mp3"},{"id":"0666067AC553E1000183137313533343135","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"移动喊话4","category":"移动","seq":null,"text":"茫茫寰宇，你我皆是微尘——却锋芒闪耀。","hasText":true,"duration":6.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0666067AC553E1000183137313533343135.mp3"},{"id":"0632967AC553C1000183336353735383934","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"大厅出现1","category":"大厅","seq":null,"text":"光无法抵达的地方，会有歌声将它点亮。","hasText":true,"duration":21.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0632967AC553C1000183336353735383934.mp3"},{"id":"0686667AC553D1000183233343138363937","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"大厅出现2","category":"大厅","seq":null,"text":"于无声处，回应你的呼喊；于晦暗中，谱写你的光芒。","hasText":true,"duration":24,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0686667AC553D1000183233343138363937.mp3"},{"id":"065796790A2A31000183236353131323030","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"杨玉环_星之鸣奏_主题曲和声伴奏","category":"背景音乐","seq":null,"text":"主题曲和声伴奏","hasText":true,"duration":232.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/065796790A2A31000183236353131323030.mp3"},{"id":"067106790A27C1000183130373431333039","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"杨玉环_星之鸣奏_主题曲音频","category":"背景音乐","seq":null,"text":"主题曲音频","hasText":true,"duration":232.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/067106790A27C1000183130373431333039.mp3"},{"id":"068576790A2311000183731303439363531","heroId":"267","skinId":"1447","skinName":"星之鸣奏","title":"杨玉环_星之鸣奏_主题曲纯伴奏","category":"背景音乐","seq":null,"text":"主题曲纯伴奏","hasText":true,"duration":232.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/068576790A2311000183731303439363531.mp3"},{"id":"06569692952AD1000183432353237343332","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环-拾年声藏贺文","category":"台词","seq":null,"text":"手中弦无杂音，心却常在迷途。\n究竟，何为幸福呢？\n我至今仍未寻找到答案。\n幸好……\n在这漫长的追寻中，有你相伴带来温暖。\n虽然前路未明，但这份暖意已是莫大的慰藉。\n来，继续拨动琴弦吧，走向那，梦寐以求","hasText":true,"duration":34.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06569692952AD1000183432353237343332.mp3"},{"id":"0688964807A7D1000183135303531373233","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"霓裳风华","category":"台词","seq":null,"text":"霓裳风华","hasText":false,"duration":220.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/0688964807A7D1000183135303531373233.mp3"},{"id":"06629648BE6291000183137353135343137","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_回城","category":"回城","seq":null,"text":"起风了","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06629648BE6291000183137353135343137.mp3"},{"id":"06954648BE6271000183239313235313537","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_挑衅","category":"挑衅","seq":null,"text":"被铭记是需要付出代价的。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06954648BE6271000183239313235313537.mp3"},{"id":"06756648BE6271000183130343633313938","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_击杀语音","category":"击杀","seq":null,"text":"曲终人散","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06756648BE6271000183130343633313938.mp3"},{"id":"06866648BE6261000183739373833333130","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_技能语音3","category":"技能","seq":null,"text":"一顾倾城，再顾倾国（改编自李延年《北方有佳人》）","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06866648BE6261000183739373833333130.mp3"},{"id":"06305648BE6261000183133303336333634","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_技能语音3","category":"技能","seq":null,"text":"天生丽质难自弃（选自白居易《长恨歌》）","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06305648BE6261000183133303336333634.mp3"},{"id":"06438648BE6251000183334323935393730","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_移动语音2","category":"移动","seq":null,"text":"心不会动摇，动摇的是情","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06438648BE6251000183334323935393730.mp3"},{"id":"06075648BE6251000183130333436313737","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_移动语音4","category":"移动","seq":null,"text":"春江花月照人生无穷，弦音流转听山河入梦","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06075648BE6251000183130333436313737.mp3"},{"id":"06725648BE6251000183332373435373439","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_死亡语音","category":"死亡","seq":null,"text":"此恨绵绵……","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06725648BE6251000183332373435373439.mp3"},{"id":"06564648BE6251000183132393536313733","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_移动语音3","category":"移动","seq":null,"text":"纵使片刻的幸福，命运也会暗中标注价格。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06564648BE6251000183132393536313733.mp3"},{"id":"06892648BE6251000183637353534323434","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_移动语音5","category":"移动","seq":null,"text":"世事易变，容颜不老","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06892648BE6251000183637353534323434.mp3"},{"id":"06884648BE6241000183135353231333132","heroId":"267","skinId":"345","skinName":"霓裳风华","title":"杨玉环_霓裳风华_大厅出现","category":"大厅","seq":null,"text":
000183134383037393131","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_死亡语音","category":"死亡","seq":null,"text":"请……再次呼唤……","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06817648BE6351000183134383037393131.mp3"},{"id":"06373648BE6351000183135333631313336","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音5","category":"移动","seq":null,"text":"所有凛冬时种下的梦，皆已抽出了柔嫩的芽。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06373648BE6351000183135333631313336.mp3"},{"id":"06455648BE6351000183138333636373839","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音7","category":"移动","seq":null,"text":"在这苍生万象编织的诗曲中，我只是倾听者。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06455648BE6351000183138333636373839.mp3"},{"id":"06093648BE6341000183138323430303732","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_大厅语音3","category":"大厅","seq":null,"text":"羁于风雪的旅者啊，你所信仰的春天，已归来了。","hasText":true,"duration":16.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06093648BE6341000183138323430303732.mp3"},{"id":"06560648BE6341000183930353532383531","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音1","category":"移动","seq":null,"text":"若问，即有答案；呼唤，必得回音；相信，我便因你而存在。","hasText":true,"duration":9.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06560648BE6341000183930353532383531.mp3"},{"id":"06919648BE6341000183236323331373531","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音2","category":"移动","seq":null,"text":"神，在传说中被描画，在祈祷时被给予。","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06919648BE6341000183236323331373531.mp3"},{"id":"06960648BE6341000183537313730393431","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_大厅语音2","category":"大厅","seq":null,"text":"弦音化雪，百鸟偕春。","hasText":true,"duration":16.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06960648BE6341000183537313730393431.mp3"},{"id":"06818648BE6341000183133353031343930","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音3","category":"移动","seq":null,"text":"你我相识于远古混沌的长夜，此后四季开始轮转，万物生生不息。","hasText":true,"duration":9.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06818648BE6341000183133353031343930.mp3"},{"id":"06581648BE6341000183134383535363131","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_移动语音4","category":"移动","seq":null,"text":"来路即为归属，初见亦是重逢。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06581648BE6341000183134383535363131.mp3"},{"id":"06296648BE6331000183335353930353131","heroId":"267","skinId":"888","skinName":"银翎春语","title":"杨玉环_银翎春语_大厅语音1","category":"大厅","seq":null,"text":"曲奏山河景，树生千万物。","hasText":true,"duration":17.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/267/06296648BE6331000183335353930353131.mp3"}]
183130333330303633","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"击杀语音2","category":"击杀","seq":null,"text":"真是……“善哉”。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/061896A3901A51000183130333330303633.mp3"},{"id":"064916A3901A51000183133303637343132","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"idle待机1","category":"待机","seq":null,"text":"那些匆匆来去的人，他们在修行什么？","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/064916A3901A51000183133303637343132.mp3"},{"id":"063266A3901A61000183536323032363639","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"强普4","category":"技能","seq":null,"text":"三毒不净！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/063266A3901A61000183536323032363639.mp3"},{"id":"067256A3901A61000183138333733383337","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"idle待机2","category":"待机","seq":null,"text":"离了灵山，方知佛前庄严，都出自凡俗供奉。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/067256A3901A61000183138333733383337.mp3"},{"id":"069726A3901A51000183331343436333433","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"挑衅2","category":"挑衅","seq":null,"text":"现在逃不算晚。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/069726A3901A51000183331343436333433.mp3"},{"id":"067686A3901A51000183431393137373936","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"挑衅1","category":"挑衅","seq":null,"text":"若成了棒下鬼，别向我讨经念。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/067686A3901A51000183431393137373936.mp3"},{"id":"064866A3901A31000183136333934303730","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音8","category":"移动","seq":null,"text":"纵三涂恶焰，焚十方法界。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/064866A3901A31000183136333934303730.mp3"},{"id":"066206A3901A41000183137313834303735","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音9","category":"移动","seq":null,"text":"若此身本就是虚妄，又怕什么魂飞魄散？","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/066206A3901A41000183137313834303735.mp3"},{"id":"067156A3901A31000183135343335353637","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音7","category":"移动","seq":null,"text":"苦海迷津，杀出条通天大道。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/067156A3901A31000183135343335353637.mp3"},{"id":"069776A3901A31000183131393430383432","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音5","category":"移动","seq":null,"text":"纵使众生皆渡彼岸，此心难驯不共慈航！","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/069776A3901A31000183131393430383432.mp3"},{"id":"065886A3901A41000183730393833343432","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"死亡语音","category":"死亡","seq":null,"text":"好哇！痛快！","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/065886A3901A41000183730393833343432.mp3"},{"id":"063346A3901A31000183934333635383036","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音6","category":"移动","seq":null,"text":"灵山宝刹，好一副金枷玉锁！","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/063346A3901A31000183934333635383036.mp3"},{"id":"068286A3901A11000183134353339353437","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"大厅语音3","category":"大厅","seq":null,"text":"心火烧透五脏，才不枉活过一场！","hasText":true,"duration":9.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/068286A3901A11000183134353339353437.mp3"},{"id":"069776A3901A21000183136393732373331","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音4","category":"移动","seq":null,"text":"若非这彻骨之痛，岂不与那泥塑木雕无异？","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/069776A3901A21000183136393732373331.mp3"},{"id":"061476A3901A21000183133313931373637","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音1","category":"移动","seq":null,"text":"过去持戒慎重，不敢丝毫怠慢，如今再看，如梦幻泡影。","hasText":true,"duration":9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/061476A3901A21000183133313931373637.mp3"},{"id":"068326A3901A11000183131323537303130","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"大厅语音1","category":"大厅","seq":null,"text":"若天地不容，佛魔不允，那便叫这天地崩毁，佛魔湮灭！","hasText":true,"duration":9.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/068326A3901A11000183131323537303130.mp3"},{"id":"064176A3901A11000183134373039313430","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"大厅语音2","category":"大厅","seq":null,"text":"诸法无我，五蕴皆空？我偏要于万劫中寻得真我！","hasText":true,"duration":9.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/064176A3901A11000183134373039313430.mp3"},{"id":"065636A3901A21000183131303731313833","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音2","category":"移动","seq":null,"text":"莲叶轻舟，度不动我这块顽心沉铁。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/065636A3901A21000183131303731313833.mp3"},{"id":"067226A3901A21000183930343831323033","heroId":"1751","skinId":"1752","skinName":"孙悟空命格","title":"移动语音3","category":"移动","seq":null,"text":"心火焚尽来路，我永不回头。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1751/067226A3901A21000183930343831323033.mp3"}]
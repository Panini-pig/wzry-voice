[{"id":"069856929527B1000183830343631303637","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐-拾年声藏贺文","category":"台词","seq":null,"text":"我曾说过。\n敖隐身负一族希望，绝不能容龙族之名寂寂。\n就算撞得鳞甲尽裂，角断九霄，这腔热血也永不冷却！\n下个十年，继续与我并肩吧，真龙从不惧风雨。\n让我们以手中剑，以胸中焰，将这真龙之名。\n重昭天地！","hasText":true,"duration":23,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/069856929527B1000183830343631303637.mp3"},{"id":"0669665C1EEC61000183136343435343831","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐_我福了","category":"台词","seq":null,"text":"我福了","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0669665C1EEC61000183136343435343831.mp3"},{"id":"0627865C1F0F51000183730363234373232","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐_我的祝福之力受到本命年Buff加持！","category":"台词","seq":null,"text":"我的祝福之力受到本命年Buff加持！","hasText":true,"duration":25.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0627865C1F0F51000183730363234373232.mp3"},{"id":"0666665C1EEF21000183537313834333332","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐_新年快乐","category":"台词","seq":null,"text":"新年快乐","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0666665C1EEF21000183537313834333332.mp3"},{"id":"0685265BA0C971000183335383834303530","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐_凌霄真龙_主题音乐_ 一生一灭兮吾心","category":"背景音乐","seq":null,"text":"敖隐_凌霄真龙_主题音乐_ 一生一灭兮吾心","hasText":false,"duration":193,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0685265BA0C971000183335383834303530.mp3"},{"id":"0671865BA0C5E1000183135303936303134","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"敖隐_凌霄真龙_主题音乐_一翻一覆兮天地","category":"背景音乐","seq":null,"text":"敖隐_凌霄真龙_主题音乐_一翻一覆兮天地","hasText":false,"duration":188.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0671865BA0C5E1000183135303936303134.mp3"},{"id":"0621065BF51B51000183133393037333731","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"相遇小龙","category":"相遇","seq":null,"text":"别怕，我也曾经像这样……风雨骤来，不等我们变得更强大。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0621065BF51B51000183133393037333731.mp3"},{"id":"0689665BF51B41000183336343430373734","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_火剑一段","category":"技能","seq":null,"text":"苍星列炬！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0689665BF51B41000183336343430373734.mp3"},{"id":"0677065BF51B51000183737343033303539","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"相遇大龙","category":"相遇","seq":null,"text":"强悍无匹么，会有这一天。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0677065BF51B51000183737343033303539.mp3"},{"id":"0674665BF51B51000183139383030323438","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_火剑二段","category":"技能","seq":null,"text":"谁销，万甲为薪！","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0674665BF51B51000183139383030323438.mp3"},{"id":"0689865BA1F601000183336393331323838","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"复活","category":"复活","seq":null,"text":"怀必死之志，搏转圜之机！","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0689865BA1F601000183336393331323838.mp3"},{"id":"0605465BA1F611000183135303231343633","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"胜方MVP","category":"MVP","seq":null,"text":"嗯……习惯就好。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0605465BA1F611000183135303231343633.mp3"},{"id":"0669465BA1F601000183135323732373934","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"劣势","category":"台词","seq":null,"text":"敖隐死且不惧，何况断骨？","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0669465BA1F601000183135323732373934.mp3"},{"id":"0668265BA1F601000183135323435373938","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"优势","category":"台词","seq":null,"text":"胜他天命一筹。","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0668265BA1F601000183135323435373938.mp3"},{"id":"0602665BA1F611000183636333232313233","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"败方MVP","category":"MVP","seq":null,"text":"谁能无憾，不必相责。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0602665BA1F611000183636333232313233.mp3"},{"id":"0688165BA1F5F1000183334373239303432","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"泉水出生","category":"大厅","seq":null,"text":"悬名天下，我昭四方。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0688165BA1F5F1000183334373239303432.mp3"},{"id":"0622165BA1F5E1000183937343430393135","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"五杀","category":"击杀","seq":null,"text":"惊诸凡夫。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0622165BA1F5E1000183937343430393135.mp3"},{"id":"0606965BA1F5E1000183130363437373633","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"休闲待机","category":"待机","seq":null,"text":"大道并非一条，哪有那么多过来人能一一指路——我要自己走。","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0606965BA1F5E1000183130363437373633.mp3"},{"id":"0679365BA1F601000183132323933313837","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"抢夺大龙2","category":"台词","seq":null,"text":"（笑）你已经做得很好了。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0679365BA1F601000183132323933313837.mp3"},{"id":"0659465BA1F5F1000183630383532353537","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"抢夺大龙1","category":"台词","seq":null,"text":"去吧，你自由了。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0659465BA1F5F1000183630383532353537.mp3"},{"id":"0699765BA1F5D1000183133323431333737","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"购买装备-逐日之弓","category":"装备","seq":null,"text":"顽心一起，试与日月争先！","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0699765BA1F5D1000183133323431333737.mp3"},{"id":"0632265BA1F5D1000183937303639383833","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"路过河道","category":"台词","seq":null,"text":"此处潭寒且清，正宜洗濯鳞角！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0632265BA1F5D1000183937303639383833.mp3"},{"id":"0664765BA1F5E1000183131353933373537","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"拿到一血","category":"台词","seq":null,"text":"我虽年弱，但龙有逆鳞，犯之者死。","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0664765BA1F5E1000183131353933373537.mp3"},{"id":"0606965BA1F5E1000183133373334303333","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"三杀","category":"击杀","seq":null,"text":"虎狼伏藏，恶煞毋降。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0606965BA1F5E1000183133373334303333.mp3"},{"id":"0687765BA1F5D1000183332313237393737","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"购买装备-宗师之力","category":"装备","seq":null,"text":"（戏谑）除了以命相搏，我可没什么人生至理可以教给谁。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0687765BA1F5D1000183332313237393737.mp3"},{"id":"0644865BA1F5D1000183133373636343031","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"购买装备-急速战靴","category":"装备","seq":null,"text":"若你在世间不曾见我，想必那时，我已飞度天外。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0644865BA1F5D1000183133373636343031.mp3"},{"id":"0643065BA1F5B1000183338333238333133","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_下落变身","category":"技能","seq":null,"text":"万古尘氛一剑扫！","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0643065BA1F5B1000183338333238333133.mp3"},{"id":"0682965BA1F5C1000183337393938343231","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"购买装备-影刃","category":"装备","seq":null,"text":"千年，疾光迅影，我们在世人的传说中载沉载浮。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0682965BA1F5C1000183337393938343231.mp3"},{"id":"0630765BA1F5B1000183132333630353536","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_起飞","category":"技能","seq":null,"text":"飞龙在天——威临四野！","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0630765BA1F5B1000183132333630353536.mp3"},{"id":"0611365BA1F5C1000183136343632333335","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_下落变身","category":"技能","seq":null,"text":"真龙 在此。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0611365BA1F5C1000183136343632333335.mp3"},{"id":"0649565BA1F5C1000183533363333393831","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"购买装备-无尽战刃","category":"装备","seq":null,"text":"所历如蝇逐血，所过遍插锥刀——但若阿爷梦中来问，便说……此去，甚好。","hasText":true,"duration":9.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0649565BA1F5C1000183533363333393831.mp3"},{"id":"0605865BA1F5C1000183332333433323537","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_变身结束","category":"技能","seq":null,"text":"不必挟山超海之功。","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0605865BA1F5C1000183332333433323537.mp3"},{"id":"0647365BA1F591000183232323838303739","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_风剑一段","category":"技能","seq":null,"text":"风刀解身！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0647365BA1F591000183232323838303739.mp3"},{"id":"0693865BA1F5B1000183138323538383334","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"学习-大招","category":"技能","seq":null,"text":"生当奋飞，腾必九霄。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0693865BA1F5B1000183138323538383334.mp3"},{"id":"0600265BA1F5A1000183135333232333339","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_风龙二段","category":"技能","seq":null,"text":"当策，九霄云气！","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0600265BA1F5A1000183135333232333339.mp3"},{"id":"0683065BA1F5A1000183135323638353531","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_风剑一段","category":"技能","seq":null,"text":"天风在袖！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0683065BA1F5A1000183135323638353531.mp3"},{"id":"0651465BA1F5B1000183238383435313037","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_起飞","category":"技能","seq":null,"text":"神龙显昭——直取太霄！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0651465BA1F5B1000183238383435313037.mp3"},{"id":"0668265BA1F5A1000183136393833303633","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_风剑二段","category":"技能","seq":null,"text":"箕星应召。","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0668265BA1F5A1000183136393833303633.mp3"},{"id":"0649665BA1F581000183835383038353434","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_水剑一段","category":"技能","seq":null,"text":"甘泽流惠！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0649665BA1F581000183835383038353434.mp3"},{"id":"0699365BA1F591000183439363130373437","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"学习-风剑技能","category":"技能","seq":null,"text":"剑成如飚，意裁风刀。","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0699365BA1F591000183439363130373437.mp3"},{"id":"0661465BA1F591000183132323834353734","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_水剑二段","category":"技能","seq":null,"text":"来决，四海之波！","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0661465BA1F591000183132323834353734.mp3"},{"id":"0645065BA1F581000183138333035323830","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_水剑二段","category":"技能","seq":null,"text":"河渎听命。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0645065BA1F581000183138333035323830.mp3"},{"id":"0692965BA1F591000183133363236363839","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"强普语音_水剑一段","category":"技能","seq":null,"text":"澄湖濯魄！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0692965BA1F591000183133363236363839.mp3"},{"id":"0629265BA1F561000183939343435333934","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"挑衅","category":"挑衅","seq":null,"text":"不必将我视作需要相让的稚子，像你这样的敌人，我不止有一个。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0629265BA1F561000183939343435333934.mp3"},{"id":"0631865BA1F571000183230383033383539","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_火剑二段","category":"技能","seq":null,"text":"诸恶自伏。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0631865BA1F571000183230383033383539.mp3"},{"id":"0685465BA1F561000183131363133383535","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"学习-火剑技能","category":"技能","seq":null,"text":"剑成如炼，驱驭神火。","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0685465BA1F561000183131363133383535.mp3"},{"id":"0612865BA1F561000183138313138343034","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"死亡语音3","category":"死亡","seq":null,"text":"拂却他年成雪色，如见白雪如见我……","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0612865BA1F561000183138313138343034.mp3"},{"id":"0602465BA1F581000183132303631333736","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"学习-水剑技能","category":"技能","seq":null,"text":"剑成如雨，博施甘泽。","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0602465BA1F581000183132303631333736.mp3"},{"id":"0696465BA1F571000183133303430323435","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"技能语音_火剑一段","category":"技能","seq":null,"text":"神火俱焚！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0696465BA1F571000183133303430323435.mp3"},{"id":"0603965BA1F551000183934333638333831","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"真龙形态击杀","category":"击杀","seq":null,"text":"谁共我，万丈颠波！","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0603965BA1F551000183934333638333831.mp3"},{"id":"0640065BA1F541000183832393533313235","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"击杀语音1","category":"击杀","seq":null,"text":"此战，只有彼我存亡，绝无两败俱伤。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0640065BA1F541000183832393533313235.mp3"},{"id":"0649665BA1F551000183934333334313934","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"击杀语音2","category":"击杀","seq":null,"text":"天地太寂寥，回家吧。","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0649665BA1F551000183934333334313934.mp3"},{"id":"0605365BA1F551000183132383435333731","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"死亡语音1","category":"死亡","seq":null,"text":"你的刀太钝。但我一息尚在，必为汝之大患。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0605365BA1F551000183132383435333731.mp3"},{"id":"0632565BA1F561000183230343535303835","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"死亡语音2","category":"死亡","seq":null,"text":"敖隐，九死不悔。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0632565BA1F561000183230343535303835.mp3"},{"id":"0644465BA1F531000183137353130363739","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音11","category":"移动","seq":null,"text":"处身浮世，谁又不是命在倏忽？但叶落归根，生生无穷，此我族之道。","hasText":true,"duration":8.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0644465BA1F531000183137353130363739.mp3"},{"id":"0636565BA1F541000183736343537363139","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音14","category":"移动","seq":null,"text":"何消天涯风共雪？前尘为梦；何陟人间雨翻云？来日方长。","hasText":true,"duration":8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0636565BA1F541000183736343537363139.mp3"},{"id":"0677965BA1F531000183132353239323639","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音10","category":"移动","seq":null,"text":"我答应过你，无论年月多少……去时如此，归亦如此。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0677965BA1F531000183132353239323639.mp3"},{"id":"0642965BA1F541000183130383239323732","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音13","category":"移动","seq":null,"text":"振银鳞，赴虞渊，再历星天万千年。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0642965BA1F541000183130383239323732.mp3"},{"id":"0674165BA1F541000183934343833333734","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音12","category":"移动","seq":null,"text":"他们在看着我。都在等一个，能够啖我血肉的机会。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0674165BA1F541000183934343833333734.mp3"},{"id":"0601065BA1F531000183731363938353334","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音9","category":"移动","seq":null,"text":"所谓兴灭继绝，就是从一族最险最痛的伤口上，将往事，一一重建。","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0601065BA1F531000183731363938353334.mp3"},{"id":"0683665BA1F511000183131383330353533","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音3","category":"移动","seq":null,"text":"谁将我族传说，解作神人之篇？","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0683665BA1F511000183131383330353533.mp3"},{"id":"0674165BA1F521000183135343937373236","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音5","category":"移动","seq":null,"text":"敖隐年少，不识时务，不知何为退避求全——一身顽骨，锋芒必争。","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0674165BA1F521000183135343937373236.mp3"},{"id":"0667965BA1F521000183734303430353530","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音7","category":"移动","seq":null,"text":"像我们这样的龙，许是天生刚骨，便是寸寸折断，也不俯就屈弯。","hasText":true,"duration":7.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0667965BA1F521000183734303430353530.mp3"},{"id":"0667965BA1F531000183530383937363435","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音8","category":"移动","seq":null,"text":"问我来处，青野之埂；问我去处，冥冥天穹；谁与我同游……白首一仙翁。","hasText":true,"duration":11.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0667965BA1F531000183530383937363435.mp3"},{"id":"0619665BA1F521000183133363939363236","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音4","category":"移动","seq":null,"text":"昔年传说，道是群龙飞呜，一木归焉……大泽为梦，心为四野。","hasText":true,"duration":8.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0619665BA1F521000183133363939363236.mp3"},{"id":"0689165BA1F521000183935363731343138","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音6","category":"移动","seq":null,"text":"我身何畏风雨来？风雨渡江，岂不快哉！","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0689165BA1F521000183935363731343138.mp3"},{"id":"0693865BA1F501000183132383439303830","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"大厅语音2","category":"大厅","seq":null,"text":"一翻一覆兮天地，一生一灭兮吾心。","hasText":true,"duration":13.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0693865BA1F501000183132383439303830.mp3"},{"id":"0620365BA1F501000183137323634303230","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"大厅语音1","category":"大厅","seq":null,"text":"潜龙腾渊凌霄上，尘世无名誓不休！","hasText":true,"duration":13.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0620365BA1F501000183137323634303230.mp3"},{"id":"0662865BA1F501000183136303636353438","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"大厅语音3","category":"大厅","seq":null,"text":"向世间，破尽尘骸一剑中。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0662865BA1F501000183136303636353438.mp3"},{"id":"0691765BA1F511000183133353932393033","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音2","category":"移动","seq":null,"text":"欲破举世沉疴——于我一剑下。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0691765BA1F511000183133353932393033.mp3"},{"id":"0639165BA1F511000183332333034303936","heroId":"1082","skinId":"1083","skinName":"凌霄真龙","title":"移动语音1","category":"移动","seq":null,"text":"迹为前尘隐，名因立身传；未敢试此剑，何面叩先贤？","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0639165BA1F511000183332333034303936.mp3"},{"id":"0658569F049511000183439323431303833","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音2-1（水1）","category":"技能","seq":1,"text":"东海玄水！","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0658569F049511000183439323431303833.mp3"},{"id":"0641869F049531000183138313436343830","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音3-1（风1）","category":"技能","seq":1,"text":"北海罡息！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0641869F049531000183138313436343830.mp3"},{"id":"0632369F049501000183134383635383238","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音1-1（火1）","category":"技能","seq":1,"text":"南海炽炎！","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0632369F049501000183134383635383238.mp3"},{"id":"0612269F049521000183138313336363234","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音2-2（水2）","category":"技能","seq":2,"text":"冰河飞泉！","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0612269F049521000183138313336363234.mp3"},{"id":"0668569F049531000183132313036353831","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音3-2（风2）","category":"技能","seq":2,"text":"凌冽玄锋！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0668569F049531000183132313036353831.mp3"},{"id":"0606269F049501000183335303431303838","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音1-2（火2）","category":"技能","seq":2,"text":"地坼（chè）天崩！","hasText":true,"duration":0.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0606269F049501000183335303431303838.mp3"},{"id":"0672869F049591000183135383139323836","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-铠·敖光2","category":"相遇","seq":null,"text":"敖丙：孩儿知道了。","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0672869F049591000183135383139323836.mp3"},{"id":"0645469F049581000183636353938343335","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-铠·敖光1","category":"相遇","seq":null,"text":"敖丙：孩儿未能完成龙族的使命。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0645469F049581000183636353938343335.mp3"},{"id":"0689669F049581000183130353734313831","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-芈月·敖闰2","category":"相遇","seq":null,"text":"敖丙：姑姑，依附他人只能是棋子，握在自己手里的才叫命运。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0689669F049581000183130353734313831.mp3"},{"id":"0611669F049571000183536333735323830","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-芈月·敖闰1","category":"相遇","seq":null,"text":"敖丙：父亲没有实现的事，我会替他实现。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0611669F049571000183536333735323830.mp3"},{"id":"0641769F049561000183133323535393631","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"个性动作","category":"动作","seq":null,"text":"盘龙冰锤！","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0641769F049561000183133323535393631.mp3"},{"id":"0617069F049571000183131373233343639","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"回城语音","category":"回城","seq":null,"text":"万龙归海！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0617069F049571000183131373233343639.mp3"},{"id":"0677569F049561000183736303835313934","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"复活语音","category":"复活","seq":null,"text":"嗯，我也能动了。","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0677569F049561000183736303835313934.mp3"},{"id":"0644369F049561000183130373836333835","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"泉水出生","category":"大厅","seq":null,"text":"天生水象，坎水淬炼。","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0644369F049561000183130373836333835.mp3"},{"id":"0673069F049571000183635343136353735","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"iDle","category":"台词","seq":null,"text":"以后我来陪你踢毽子。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0673069F049571000183635343136353735.mp3"},{"id":"0672169F049551000183137353138353830","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音4-起飞","category":"技能","seq":null,"text":"四海族裔——九霄昂首！","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0672169F049551000183137353138353830.mp3"},{"id":"0613969F049551000183135363631313835","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"结束变身","category":"台词","seq":null,"text":"泱泱仙人，亦不过如此！","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0613969F049551000183135363631313835.mp3"},{"id":"0614969F049541000183637303936363336","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音4-起飞","category":"技能","seq":null,"text":"真龙现世——云蒸星移！","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0614969F049541000183637303936363336.mp3"},{"id":"0648469F049541000183737363335323333","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"学习-飞","category":"台词","seq":null,"text":"千载樊笼，一朝尽破！","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0648469F049541000183737363335323333.mp3"},{"id":"0613269F049531000183939343239353731","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普1、2-风","category":"技能","seq":null,"text":"飒飒鳞光！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0613269F049531000183939343239353731.mp3"},{"id":"0677069F049551000183132373538373130","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音4-下落变身","category":"技能","seq":null,"text":"一洗万古沧溟空！","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0677069F049551000183132373538373130.mp3"},{"id":"0676369F049541000183935363839313133","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普3-风","category":"技能","seq":null,"text":"云从，万里长风！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0676369F049541000183935363839313133.mp3"},{"id":"0651769F049551000183132313139333435","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"技能语音4-下落变身","category":"技能","seq":null,"text":"须臾山河！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0651769F049551000183132313139333435.mp3"},{"id":"0687369F049521000183231303331353536","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普1、2-水","category":"技能","seq":null,"text":"海啸龙吟！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0687369F049521000183231303331353536.mp3"},{"id":"0673469F049521000183137313736393733","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"学习-风","category":"台词","seq":null,"text":"涤净尘嚣，唤我九天之风！","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0673469F049521000183137313736393733.mp3"},{"id":"0683869F049521000183936373730373130","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普3-水","category":"技能","seq":null,"text":"潮升，沧海无涯！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0683869F049521000183936373730373130.mp3"},{"id":"0678669F049511000183131343833383134","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普1、2-火","category":"技能","seq":null,"text":"九渊龙怒！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0678669F049511000183131343833383134.mp3"},{"id":"0682169F0494F1000183134383836303333","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"挑衅","category":"挑衅","seq":null,"text":"妖怪，放开那孩子。","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0682169F0494F1000183134383836303333.mp3"},{"id":"0666969F049511000183334303836383432","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"学习-水","category":"台词","seq":null,"text":"我族兴焉，不负父王所托！","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0666969F049511000183334303836383432.mp3"},{"id":"0691569F049501000183135373535323839","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"学习-火","category":"台词","seq":null,"text":"龙族之火，燃尽世间不公！","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0691569F049501000183135373535323839.mp3"},{"id":"0651569F049511000183232353035323531","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"强普3-火","category":"技能","seq":null,"text":"共焚，天地枷锁！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0651569F049511000183232353035323531.mp3"},{"id":"0645669F0494E1000183131353337313331","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话6","category":"移动","seq":null,"text":"身困无边炼狱，心向自在高天。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0645669F0494E1000183131353337313331.mp3"},{"id":"0603169F0494E1000183131313139313134","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"死亡喊话","category":"死亡","seq":null,"text":"孩儿未能完成龙族的使命……","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0603169F0494E1000183131313139313134.mp3"},{"id":"0624369F0494F1000183433323138303835","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"死亡喊话","category":"死亡","seq":null,"text":"我不能败……","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0624369F0494F1000183433323138303835.mp3"},{"id":"0617269F0494F1000183134303134313632","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"击杀喊话","category":"击杀","seq":null,"text":"你不是我对手。","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0617269F0494F1000183134303134313632.mp3"},{"id":"0649869F0494E1000183133373639383639","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话7","category":"移动","seq":null,"text":"我向来恩怨分明，有恩必偿，有怨必报。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0649869F0494E1000183133373639383639.mp3"},{"id":"0697069F0494D1000183730303839333736","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话5","category":"移动","seq":null,"text":"我们是朋友了，以后你想踢毽子随时可以来海边找我。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0697069F0494D1000183730303839333736.mp3"},{"id":"0665169F0494F1000183133323038383434","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"击杀喊话","category":"击杀","seq":null,"text":"得罪。","hasText":true,"duration":0.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0665169F0494F1000183133323038383434.mp3"},{"id":"0638669F0494E1000183137333033333035","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话8","category":"移动","seq":null,"text":"是非曲直，岂论仙妖？天地共鉴，唯在本心。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0638669F0494E1000183137333033333035.mp3"},{"id":"0665769F0494C1000183136363737353035","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"大厅出现3","category":"大厅","seq":null,"text":"自诩照世明灯，干的却是恃强凌弱，祸乱人间的勾当，你们才是邪魔外道！","hasText":true,"duration":16,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0665769F0494C1000183136363737353035.mp3"},{"id":"0622169F0494D1000183137343637363539","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话2","category":"移动","seq":null,"text":"万龙甲，承我族世代夙愿，很重……但敖丙担得起。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0622169F0494D1000183137343637363539.mp3"},{"id":"0613769F0494C1000183938383336393836","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"大厅出现1","category":"大厅","seq":null,"text":"若前方无路，我就踏出一条路！","hasText":true,"duration":16.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0613769F0494C1000183938383336393836.mp3"},{"id":"0693569F0494D1000183131353237313230","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话3","category":"移动","seq":null,"text":"不求得道成仙，但求我心澄明。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0693569F0494D1000183131353237313230.mp3"},{"id":"0624569F0494C1000183135353335373439","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"大厅出现2","category":"大厅","seq":null,"text":"你无处可逃！","hasText":true,"duration":16.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0624569F0494C1000183135353335373439.mp3"},{"id":"0635369F0494D1000183133373930303036","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话4","category":"移动","seq":null,"text":"龙宫虽然残破，却是我长大的地方，它是家。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0635369F0494D1000183133373930303036.mp3"},{"id":"0647469F0494C1000183235303931333136","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"移动喊话1","category":"移动","seq":null,"text":"我想飞得再高些……替那些从未见过天空的族人。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0647469F0494C1000183235303931333136.mp3"},{"id":"0643769F049471000183536393132363135","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-哪吒·哪吒1","category":"相遇","seq":null,"text":"敖丙：你等等，等我肉身恢复，我们一起去龙宫好不好？","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0643769F049471000183536393132363135.mp3"},{"id":"0678269F049481000183130343736373637","heroId":"1082","skinId":"1740","skinName":"灵珠·敖丙","title":"相遇-哪吒·哪吒2","category":"相遇","seq":null,"text":"敖丙：只要听到这个海螺声，我定千里来相会。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1082/0678269F049481000183130343736373637.mp3"}]
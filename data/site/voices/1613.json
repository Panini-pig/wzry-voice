313732363437","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"挑衅","category":"挑衅","seq":null,"text":"对付你一箭足矣。","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/066196867976F1000183134313732363437.mp3"},{"id":"063196867976E1000183134383436393430","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"死亡喊话1","category":"死亡","seq":null,"text":"轻敌了... ...","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063196867976E1000183134383436393430.mp3"},{"id":"062656867976D1000183130333439363437","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话4","category":"移动","seq":null,"text":"示弱于前，伏兵在侧，诱敌深入则此战可成。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/062656867976D1000183130333439363437.mp3"},{"id":"060836867976D1000183136303038393937","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话6","category":"移动","seq":null,"text":"网罟gǔ已张，诸位可静候佳音。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/060836867976D1000183136303038393937.mp3"},{"id":"068786867976E1000183436363035383138","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话8","category":"移动","seq":null,"text":"领航江郡的舰船，不曾沉没亦不会沉没。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068786867976E1000183436363035383138.mp3"},{"id":"062866867976D1000183833333739303536","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话5","category":"移动","seq":null,"text":"放长线，才能钓大鱼~","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/062866867976D1000183833333739303536.mp3"},{"id":"066656867976E1000183138333737323331","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"击杀喊话1","category":"击杀","seq":null,"text":"入我彀中，胜负已定。","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/066656867976E1000183138333737323331.mp3"},{"id":"065886867976E1000183830373130343432","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话7","category":"移动","seq":null,"text":"谋可算千万，绝不及家人。","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/065886867976E1000183830373130343432.mp3"},{"id":"067286867976C1000183632303636323438","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话2","category":"移动","seq":null,"text":"诱敌之言九真一假，诸位或可一猜～","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067286867976C1000183632303636323438.mp3"},{"id":"068176867976C1000183131333037353130","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话3","category":"移动","seq":null,"text":"越是堂而皇之，才越是无计可解。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068176867976C1000183131333037353130.mp3"},{"id":"063436867976B1000183436323933333931","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"大厅出现2","category":"大厅","seq":null,"text":"示弱非怯，藏锋非钝，避一时风急，不舍破浪之心！","hasText":true,"duration":13.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063436867976B1000183436323933333931.mp3"},{"id":"066436867976C1000183735333435313432","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"大厅出现3","category":"大厅","seq":null,"text":"纵有风雷骤起于外，亦难破我万羽惊鸿！","hasText":true,"duration":10.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/066436867976C1000183735333435313432.mp3"},{"id":"068196867976B1000183232373837383931","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"大厅出现1","category":"大厅","seq":null,"text":"三思而得万全，一计可抵千勇。","hasText":true,"duration":11.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068196867976B1000183232373837383931.mp3"},{"id":"069066867976C1000183131303533333235","heroId":"1613","skinId":"1620","skinName":"定旌之谋","title":"移动喊话1","category":"移动","seq":null,"text":"为帅者，当先计其败，后计其成。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/069066867976C1000183131303533333235.mp3"},{"id":"060956A3CF9071000183130383737383435","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能2-1","category":"技能","seq":1,"text":"御风，显形。","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/060956A3CF9071000183130383737383435.mp3"},{"id":"067056A3CF9081000183136373030383135","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能3-1（大招）","category":"技能","seq":1,"text":"三扇朗朗复乾坤！","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067056A3CF9081000183136373030383135.mp3"},{"id":"063476A3CF9071000183630343736323637","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能2-1（破阵形态）","category":"技能","seq":1,"text":"二扇妖氛散！","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063476A3CF9071000183630343736323637.mp3"},{"id":"068246A3CF9061000183931313637383738","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能1-1（破阵形态）","category":"技能","seq":1,"text":"一扇定风波！","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068246A3CF9061000183931313637383738.mp3"},{"id":"064806A3CF9061000183736323430313832","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能1-1","category":"技能","seq":1,"text":"风起，困敌！","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064806A3CF9061000183736323430313832.mp3"},{"id":"060456A3CF9081000183138353130303233","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能3-2（大招）","category":"技能","seq":2,"text":"妖孽，伏诛！","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/060456A3CF9081000183138353130303233.mp3"},{"id":"067966A3CF9081000183132313839343931","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能2-2（破阵形态）","category":"技能","seq":2,"text":"风行令止，妖邪莫前！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067966A3CF9081000183132313839343931.mp3"},{"id":"063786A3CF9071000183437353532313834","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能2-2","category":"技能","seq":2,"text":"以柔克刚，寻隙而进！","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063786A3CF9071000183437353532313834.mp3"},{"id":"067686A3CF9061000183137333732313037","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能1-2（破阵形态）","category":"技能","seq":2,"text":"应对之策，早已备好。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067686A3CF9061000183137333732313037.mp3"},{"id":"062986A3CF9061000183131373134383439","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能1-2","category":"技能","seq":2,"text":"猎物，已入瓮中。","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/062986A3CF9061000183131373134383439.mp3"},{"id":"063346A3CF9081000183138323031323238","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"技能3-3（大招）","category":"技能","seq":3,"text":"破敌之机，在此一瞬！","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063346A3CF9081000183138323031323238.mp3"},{"id":"062596A3CF90A1000183739383834373737","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"孙权&赵云_相遇2","category":"相遇","seq":null,"text":"孙权：是我们换的，你都熬三宿了，司长！","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/062596A3CF90A1000183739383834373737.mp3"},{"id":"064836A3CF90B1000183137303434373738","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"姬小满&孙权&赵云_相遇","category":"相遇","seq":null,"text":"孙权：可以带家属吗？","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064836A3CF90B1000183137303434373738.mp3"},{"id":"063186A3CF9091000183138333832383633","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"大招二段-后撤步","category":"技能","seq":null,"text":"镇！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063186A3CF9091000183138333832383633.mp3"},{"id":"065996A3CF90A1000183939353737313239","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"姬小满&孙权_相遇2","category":"相遇","seq":null,"text":"孙权: 司长干了一百年才等到我们，知足吧。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/065996A3CF90A1000183939353737313239.mp3"},{"id":"062696A3CF9091000183138313630363138","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"回城","category":"回城","seq":null,"text":"入秋了，家里的桂花，也该开了吧。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/062696A3CF9091000183138313630363138.mp3"},{"id":"067686A3CF9091000183130353833393833","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"个性动作语音","category":"动作","seq":null,"text":"芭蕉扇不是玩具……行吧，就带你们玩两下。","hasText":true,"duration":8.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067686A3CF9091000183130353833393833.mp3"},{"id":"060046A3CF90A1000183137353438363239","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"孙权&赵云_相遇1","category":"相遇","seq":null,"text":"孙权：买了些桃花酥、青团、糖糕……司长要尝尝吗？","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/060046A3CF90A1000183137353438363239.mp3"},{"id":"061216A3CF9091000183130393136313539","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"姬小满&孙权_相遇1","category":"相遇","seq":null,"text":"孙权：好心提醒，你的考勤已濒临红线。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/061216A3CF9091000183130393136313539.mp3"},{"id":"068486A3CF9051000183132353533303339","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"挑衅1","category":"挑衅","seq":null,"text":"现在投降尚有余地——再犹豫，可就神仙难救了","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068486A3CF9051000183132353533303339.mp3"},{"id":"061256A3CF9051000183332343739353633","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"死亡喊话1","category":"死亡","seq":null,"text":"暂避锋芒……以图后计。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/061256A3CF9051000183332343739353633.mp3"},{"id":"064196A3CF9051000183336353938343837","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"击杀喊话1","category":"击杀","seq":null,"text":"驱魔敕令，封！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064196A3CF9051000183336353938343837.mp3"},{"id":"063546A3CF9051000183131393733343334","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话8","category":"移动","seq":null,"text":"三千洞府封印松动，正值用人时，我岂可懈怠。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063546A3CF9051000183131393733343334.mp3"},{"id":"064976A3CF9041000183131353733393331","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话7","category":"移动","seq":null,"text":"芭蕉扇虽有破损，锋芒犹存。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064976A3CF9041000183131353733393331.mp3"},{"id":"064616A3CF9031000183134373931333832","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话3","category":"移动","seq":null,"text":"家传捉妖法诀，正可与君一试。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064616A3CF9031000183134373931333832.mp3"},{"id":"063186A3CF9041000183336393737323436","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话6","category":"移动","seq":null,"text":"封印局的事竟入了戏文，“一扇擒百妖”，过誉了。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063186A3CF9041000183336393737323436.mp3"},{"id":"068376A3CF9041000183230393436303731","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话5","category":"移动","seq":null,"text":"既入我局，岂有脱逃之理？","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/068376A3CF9041000183230393436303731.mp3"},{"id":"069596A3CF9031000183535303435353331","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话2","category":"移动","seq":null,"text":"与妖斗，其乐无穷。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/069596A3CF9031000183535303435353331.mp3"},{"id":"063736A3CF9041000183137313733393038","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话4","category":"移动","seq":null,"text":"待奖赏下发，便为小妹觅柄好弓，为兄长造副新锚。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/063736A3CF9041000183137313733393038.mp3"},{"id":"064126A3CF9031000183935313138313130","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"移动喊话1","category":"移动","seq":null,"text":"不急，三步之后，自可收网。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/064126A3CF9031000183935313138313130.mp3"},{"id":"065826A3CF9021000183436353938343732","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"大厅喊话2","category":"大厅","seq":null,"text":"妖之强弱可分六等，黄风怪属乙等，备下三则捉妖计……足矣！","hasText":true,"duration":13.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/065826A3CF9021000183436353938343732.mp3"},{"id":"067346A3CF9021000183134303033373834","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"大厅喊话1","category":"大厅","seq":null,"text":"我等奉封印局之命，缉拿妖邪——诸君，有礼了。","hasText":true,"duration":14.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067346A3CF9021000183134303033373834.mp3"},{"id":"067116A3CF9021000183932303132303534","heroId":"1613","skinId":"1759","skinName":"仙扇使者","title":"大厅喊话3","category":"大厅","seq":null,"text":"昔闻西游奇谈，好生向往——愿效先贤，护我人间。","hasText":true,"duration":13.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1613/067116A3CF9021000183932303132303534.mp3"}]
714648BE8FD1000183532313836333437","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_移动语音3","category":"移动","seq":null,"text":"让人能抓住自己的命运...在白昼之前，点起第一簇火。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06714648BE8FD1000183532313836333437.mp3"},{"id":"06972648BE8FD1000183336383332313630","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_移动语音6","category":"移动","seq":null,"text":"陨落的英魂，将声音留在回音之间。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06972648BE8FD1000183336383332313630.mp3"},{"id":"06332648BE8FD1000183531333237363434","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_移动语音7","category":"移动","seq":null,"text":"能为不幸者垂泪的力量，胜过一切刀剑。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06332648BE8FD1000183531333237363434.mp3"},{"id":"06992648BE8FD1000183130343330323038","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_移动语音4","category":"移动","seq":null,"text":"离开神殿的前夜，我们在往事中诀别。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06992648BE8FD1000183130343330323038.mp3"},{"id":"06091648BE8FC1000183731393236393637","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_大厅语音3","category":"大厅","seq":null,"text":"（上任神使：命运判处你已获神罪……给你戴上，为别人打破的枷锁……）永恒的枷锁？（哼）那就斩断它。","hasText":true,"duration":18.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06091648BE8FC1000183731393236393637.mp3"},{"id":"06913648BE8FC1000183332333932383836","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_大厅语音1","category":"大厅","seq":null,"text":"（上任神使：我知道你因何离去——那时，火熄灭在风里，苍穹鸣泣……）\n神不欲使人知晓的，将由我来告知。","hasText":true,"duration":18.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06913648BE8FC1000183332333932383836.mp3"},{"id":"06019648BE8FC1000183634343334333038","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_大厅语音2","category":"大厅","seq":null,"text":"（上任神使：神殿之下，无尽泪雨……无权抓住命运的手，满握风雨……）能被自己掌握的，才叫命运。","hasText":true,"duration":18.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06019648BE8FC1000183634343334333038.mp3"},{"id":"06088648BE8FC1000183135333838363735","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音_移动语音1","category":"移动","seq":null,"text":"人间真正的悲剧，是神畏惧光明。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06088648BE8FC1000183135333838363735.mp3"},{"id":"06006647D8DEE1000183737353736363737","heroId":"226","skinId":"729","skinName":"启示之音","title":"露娜_启示之音","category":"台词","seq":null,"text":"露娜_启示之音","hasText":false,"duration":126,"audio":"https://audio.wzry.panini-pigs.cn/audio/226/06006647D8DEE1000183737353736363737.mp3"}]
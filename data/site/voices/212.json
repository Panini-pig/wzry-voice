tps://audio.wzry.panini-pigs.cn/audio/212/06664648BEB001000183135323533303532.mp3"},{"id":"06419648BEB001000183131383431303331","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_遇见友方（伽罗天狼肃光者）","category":"台词","seq":null,"text":"伽罗：计划代号“天狼星”，进度一切顺利\n曹操：有一天，天狼星也会成为历史的一部分。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06419648BEB001000183131383431303331.mp3"},{"id":"06057648BEB001000183831303833373433","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_个性动作","category":"动作","seq":null,"text":"音乐计划，这个不方便透露~","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06057648BEB001000183831303833373433.mp3"},{"id":"06639648BEB001000183132353838363330","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_击杀语音","category":"击杀","seq":null,"text":"永眠黑夜！","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06639648BEB001000183132353838363330.mp3"},{"id":"06030648BEAFE1000183738353637323636","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_死亡语音","category":"死亡","seq":null,"text":"无解的，亚军魔咒……","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06030648BEAFE1000183738353637323636.mp3"},{"id":"06379648BEAFD1000183132343338333938","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音4","category":"移动","seq":null,"text":"代号5709，行动理由…周三也是幸运日不行吗？","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06379648BEAFD1000183132343338333938.mp3"},{"id":"06220648BEAFD1000183136383530353630","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音3","category":"移动","seq":null,"text":"五把剑出场是惯例，打败你只需要其中之一。","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06220648BEAFD1000183136383530353630.mp3"},{"id":"06783648BEAFD1000183137373037353632","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音5","category":"移动","seq":null,"text":"（大笑）哈哈！以一敌三，真英雄本色！","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06783648BEAFD1000183137373037353632.mp3"},{"id":"06043648BEAFD1000183237353839333032","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音6","category":"移动","seq":null,"text":"这座城市仍然相信奇迹。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06043648BEAFD1000183237353839333032.mp3"},{"id":"06754648BEAFC1000183831393037353534","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_大厅语音2","category":"大厅","seq":null,"text":"热血不止于怀旧——（各位，准备好了吗？）","hasText":true,"duration":9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06754648BEAFC1000183831393037353534.mp3"},{"id":"06505648BEAFC1000183134313031363934","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音1","category":"移动","seq":null,"text":"这里有我，并且不只有我。","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06505648BEAFC1000183134313031363934.mp3"},{"id":"06793648BEAFC1000183136343034363238","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_移动语音2","category":"移动","seq":null,"text":"时隔477天，我的唱片仍是畅销经典。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06793648BEAFC1000183136343034363238.mp3"},{"id":"06494648BEAFC1000183137383231373831","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_大厅语音3","category":"大厅","seq":null,"text":"音乐是对历史的纪念——（各位，准备好了吗？）","hasText":true,"duration":9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06494648BEAFC1000183137383231373831.mp3"},{"id":"06382648BEAFC1000183133353836333030","heroId":"212","skinId":"695","skinName":"天狼征服者","title":"曹操_天狼征服者_大厅语音1","category":"大厅","seq":null,"text":"危机潜伏于黑夜——（各位，准备好了吗？）","hasText":true,"duration":9.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06382648BEAFC1000183133353836333030.mp3"},{"id":"067556929527F1000183638353333313435","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操-拾年声藏贺文","category":"台词","seq":null,"text":"过去这么久，考虑好了么？\n加入我的麾下吧。\n哼哈哈哈哈，没想好也没关系，对你，我有的是耐心。\n我等着一统三分之地的那天。\n和你一起品尝那些失败者绝望的表情。","hasText":true,"duration":25,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/067556929527F1000183638353333313435.mp3"},{"id":"065566867977D1000183434373333323030","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"相遇孙权（敌）","category":"相遇","seq":null,"text":"曹操：拿下江郡之日，必将“吴地鱼鲜”一网而尽！","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/065566867977D1000183434373333323030.mp3"},{"id":"06626648BEAF81000183131373233373834","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_挑衅语音","category":"挑衅","seq":null,"text":"没用的你们就像没用的道义。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06626648BEAF81000183131373233373834.mp3"},{"id":"06222648BEAF81000183531353033323739","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_击杀语音","category":"击杀","seq":null,"text":"挑衅的下场！","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06222648BEAF81000183531353033323739.mp3"},{"id":"06584648BEAF71000183639363331303634","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_死亡语音","category":"死亡","seq":null,"text":"啊，愚蠢的时代！","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06584648BEAF71000183639363331303634.mp3"},{"id":"06520648BEAF61000183134313138343036","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_移动语音5","category":"移动","seq":null,"text":"你对我的价值决定我对你的估值。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06520648BEAF61000183134313138343036.mp3"},{"id":"06079648BEAF61000183130383330353738","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_移动语音4","category":"移动","seq":null,"text":"最后品尝一下，生命的滋味。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06079648BEAF61000183130383330353738.mp3"},{"id":"06172648BEAF51000183137393934333333","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_大厅语音1","category":"大厅","seq":null,"text":"宁教我负天下人 ！","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06172648BEAF51000183137393934333333.mp3"},{"id":"06794648BEAF51000183234303632333832","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_移动语音2","category":"移动","seq":null,"text":"力量也会臣服我！","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06794648BEAF51000183234303632333832.mp3"},{"id":"06056648BEAF51000183135383233373939","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_移动语音3","category":"移动","seq":null,"text":"别低估了霸道的力量！","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06056648BEAF51000183135383233373939.mp3"},{"id":"06138648BEAF51000183737313238313339","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_大厅语音2","category":"大厅","seq":null,"text":"仁义，多么奢侈！","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06138648BEAF51000183737313238313339.mp3"},{"id":"06860648BEAF51000183932353438323039","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_移动语音1","category":"移动","seq":null,"text":"这就是炼狱！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06860648BEAF51000183932353438323039.mp3"},{"id":"06854648BEAF51000183633353633353631","heroId":"212","skinId":"824","skinName":"鲜血枭雄","title":"曹操_鲜血枭雄_大厅语音3","category":"大厅","seq":null,"text":"忠诚，美妙的谎言！","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/212/06854648BEAF51000183633353633353631.mp3"}]
[{"id":"0677366F3C9BF1000183133353830373936","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"海月 1（敌）","category":"台词","seq":1,"text":"（影）（深呼吸）嗯～闻到了一些不速之客光临的气息。","hasText":true,"duration":8.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0677366F3C9BF1000183133353830373936.mp3"},{"id":"0667766F3C9BF1000183132363638353033","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"刘邦 1（敌）","category":"台词","seq":1,"text":"（影）外来者？这天穹果然是个花架子。但是，我可不是。","hasText":true,"duration":8.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0667766F3C9BF1000183132363638353033.mp3"},{"id":"0618366F3C9AF1000183432333532323833","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"技能语音3_1\n（最后的狂舞）","category":"技能","seq":1,"text":"黯日永生！","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0618366F3C9AF1000183432333532323833.mp3"},{"id":"0668666F3C9AC1000183732303832373035","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"技能语音1-1_1\n（狂热舞步）","category":"技能","seq":1,"text":"来吧！与我共舞！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0668666F3C9AC1000183732303832373035.mp3"},{"id":"0659566F3C9C01000183232393339393332","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"海月 2（友）","category":"台词","seq":2,"text":"（影）啊，真是期待。没有奇迹，没有神巫的云梦泽，会是什么样子。","hasText":true,"duration":10.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0659566F3C9C01000183232393339393332.mp3"},{"id":"0601966F3C9BF1000183439363633333534","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"刘邦 2（敌）","category":"台词","seq":2,"text":"（影）爱偷吃又嚣张的小老鼠～这次，可不能轻易放走你。","hasText":true,"duration":9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0601966F3C9BF1000183439363633333534.mp3"},{"id":"0672666F3C9AF1000183138323336353239","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"技能语音3_2","category":"技能","seq":2,"text":"我——是不死的！","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0672666F3C9AF1000183138323336353239.mp3"},{"id":"0630866F3C9BD1000183137353131363939","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"大司命 3敌","category":"台词","seq":3,"text":"（影）小傻瓜，你的云梦泽不需要光明，它需要的是——养料。","hasText":true,"duration":8.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0630866F3C9BD1000183137353131363939.mp3"},{"id":"06681692952B01000183131343238383135","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"影-拾年声藏贺文","category":"台词","seq":null,"text":"听啊，他们还在欢庆与你的相遇，哈哈~\n真是幼稚得可爱。\n哎~\n可惜他们不知道，阳光越盛，影子就越饥渴呢。\n哎呀~\n被你看到了~\n没错~\n我藏了些羽毛在森林里，不知会划破谁的新衣。\n又会让谁哭鼻子呢？","hasText":true,"duration":38.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/06681692952B01000183131343238383135.mp3"},{"id":"0663866F3C9BE1000183832313738393937","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"敖隐1友","category":"台词","seq":null,"text":"（影）看看我发现了什么，独行于天地间的最后一条龙！","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0663866F3C9BE1000183832313738393937.mp3"},{"id":"0653266F3C9BE1000183131383433313135","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"鬼谷子1敌","category":"台词","seq":null,"text":"（影）不不不，我从不觊觎奇迹，恰恰相反，我渴望看它毁灭那一瞬间的霞光万丈！","hasText":true,"duration":10.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0653266F3C9BE1000183131383433313135.mp3"},{"id":"0602466F3C9BE1000183131313238373738","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"敖隐2友","category":"台词","seq":null,"text":"（影）如果你想对他动手，我非常乐意向你分享关于他的一切～","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0602466F3C9BE1000183131313238373738.mp3"},{"id":"0643666F3C9BE1000183134363031383239","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"鬼谷子2友","category":"台词","seq":null,"text":"（影）可是，我的身后，也是不会亮起的黑夜啊……老师。","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0643666F3C9BE1000183134363031383239.mp3"},{"id":"0625466F3C9BD1000183132363230303332","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"大司命1敌","category":"台词","seq":null,"text":"（影）荀拿命教出来的，竟是个看不透生死的徒弟，真不像话。","hasText":true,"duration":7.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0625466F3C9BD1000183132363230303332.mp3"},{"id":"0692866F3C9BD1000183136373931303331","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"大司命2敌","category":"台词","seq":null,"text":"（影）我不过是来你这往生途寻一寻故人，总是喊打喊杀的，小气。","hasText":true,"duration":8.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0692866F3C9BD1000183136373931303331.mp3"},{"id":"0633566F3C9BC1000183939373736373932","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"少司缘1友","category":"台词","seq":null,"text":"（影）小家伙，你的味道真让我熟悉。不如你算算，我们之间是什么缘啊～","hasText":true,"duration":9.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0633566F3C9BC1000183939373736373932.mp3"},{"id":"0671166F3C9BC1000183135363338313035","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"少司缘2友","category":"台词","seq":null,"text":"（影）真是伤心啊。那你再算算，我这不死不生之人，如今该往何处啊~","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0671166F3C9BC1000183135363338313035.mp3"},{"id":"0607466F3C9BC1000183236343734353132","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"少司缘3友","category":"台词","seq":null,"text":"（影）少司命一脉，怎么只剩这司缘之力了……生机去哪儿了？","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0607466F3C9BC1000183236343734353132.mp3"},{"id":"0612266F3C9BC1000183130313630363232","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"友方瑶2","category":"台词","seq":null,"text":"你为什么老黏着他呀，嗯~？","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0612266F3C9BC1000183130313630363232.mp3"},{"id":"0695966F3C9BB1000183130373639323330","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"瑶1友","category":"台词","seq":null,"text":"（影）自己跑进陷阱里的小鹿，你倒是和那个一根筋的羚羊一样，傻的可爱。","hasText":true,"duration":8.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0695966F3C9BB1000183130373639323330.mp3"},{"id":"0625766F3C9BB1000183539373533313537","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"云中君2友","category":"台词","seq":null,"text":"（影）等咱们拆了天穹，你也可以想去哪儿就去哪儿～","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0625766F3C9BB1000183539373533313537.mp3"},{"id":"0624466F3C9BA1000183134363830343735","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"云中君4敌","category":"台词","seq":null,"text":"（影）如果有一天，东皇那个蠢货要割了瑶的鹿角来滋补，你会怎么选？","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0624466F3C9BA1000183134363830343735.mp3"},{"id":"0609866F3C9BA1000183135373630383031","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"云中君4敌","category":"台词","seq":null,"text":"（影）（兴奋）如果真有那一天……我就把你和小鹿女一起扔进汤里炖给他喝！","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0609866F3C9BA1000183135373630383031.mp3"},{"id":"0659166F3C9BB1000183130333234393530","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"云中君3友","category":"台词","seq":null,"text":"（影）你没有眼睛，我断了翅膀，东皇失去了双腿。全知者真是个坚强团结的大家庭啊！","hasText":true,"duration":11.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0659166F3C9BB1000183130333234393530.mp3"},{"id":"0684166F3C9B91000183333303533303139","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一7友","category":"台词","seq":null,"text":"（影）当年的九神巫，死的死，散的散。他们的继任人渐已明晰，有些人，我却始终查不到因果。","hasText":true,"duration":11.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0684166F3C9B91000183333303533303139.mp3"},{"id":"0664066F3C9B91000183138313539353035","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一5友","category":"台词","seq":null,"text":"（影）他们怎么不分青红皂白，就觉得咱们是一伙的呀~","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0664066F3C9B91000183138313539353035.mp3"},{"id":"0642066F3C9B81000183737303737303031","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一3友","category":"台词","seq":null,"text":"（影）（兴奋地搓手手）来吧！让我们为夺取奇迹，制定一个缜密的大计划！","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0642066F3C9B81000183737303737303031.mp3"},{"id":"0649066F3C9BA1000183330363636343830","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一6敌","category":"台词","seq":null,"text":"（影）奇迹可以归你，但你的命得归我~","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0649066F3C9BA1000183330363636343830.mp3"},{"id":"0610066F3C9BA1000183734323531333137","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"云中君1敌","category":"台词","seq":null,"text":"（影）小羽族们的换羽期会持续整个盛夏，让森林像是下了一场接一场的…嗯…长老们说的“雪”。","hasText":true,"duration":12.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0610066F3C9BA1000183734323531333137.mp3"},{"id":"0636166F3C9B91000183238303031313433","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一4友","category":"台词","seq":null,"text":"（影）（互相插刀）嗯，你从小玄子变成“鳝鱼”那天，也是这样的暴雨。","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0636166F3C9B91000183238303031313433.mp3"},{"id":"0627366F3C9B81000183130373637373237","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一1友","category":"台词","seq":null,"text":"（影）如果你继续那样叫我的话，我就把东神城，变成东神陵。","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0627366F3C9B81000183130373637373237.mp3"},{"id":"0610866F3C9B81000183335303938303235","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"东皇太一2友","category":"台词","seq":null,"text":"（影）如果荀那个好学生还活着，我们倒是可以问问他~","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0610866F3C9B81000183335303938303235.mp3"},{"id":"0672466F3C9B81000183131323737303832","heroId":"1386","skinId":"1387","skinName":"黯羽东君","title":"购买名刀","category":"台词","seq":null,"text":"这会是一场，完美的祭典。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1386/0672466F3C9B81000183131323737303832.mp3"},{"
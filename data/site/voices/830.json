/06986648BEEF81000183132393834333136.mp3"},{"id":"06359648BEEF81000183130343634383132","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能1-2","category":"技能","seq":2,"text":"露破绽了！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06359648BEEF81000183130343634383132.mp3"},{"id":"06950648BEEFB1000183133303037363839","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能2-3","category":"技能","seq":3,"text":"没想到吧？","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06950648BEEFB1000183133303037363839.mp3"},{"id":"06018648BEEFB1000183534393538333337","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能2-3","category":"技能","seq":3,"text":"风紧扯呼！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06018648BEEFB1000183534393538333337.mp3"},{"id":"06740648BEEFA1000183235323131303231","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能2-3","category":"技能","seq":3,"text":"进退有度！","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06740648BEEFA1000183235323131303231.mp3"},{"id":"06793648BEEF91000183739363636343437","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能1-3","category":"技能","seq":3,"text":"你以为呢？","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06793648BEEF91000183739363636343437.mp3"},{"id":"06510648BEEF91000183135303736353932","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能1-3","category":"技能","seq":3,"text":"水无常形！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06510648BEEF91000183135303736353932.mp3"},{"id":"06486648BEEF81000183131363431363230","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能1-3","category":"技能","seq":3,"text":"武无常势！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06486648BEEF81000183131363431363230.mp3"},{"id":"063006929528D1000183735363838383432","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满-拾年声藏贺文","category":"台词","seq":null,"text":"太阳每天这么早就升起来了吗？\n说起来，我们确实认识很多年了。\n时间真是跑得比师父追我练功时还快啊。\n嗯~我当然记得，那些麻烦的高光时刻。\n未来的愿望吗。\n希望下次的活动不是早起看日出……","hasText":true,"duration":32,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/063006929528D1000183735363838383432.mp3"},{"id":"06138648BEEFE1000183132373639353132","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_购买装备-暗影战斧","category":"装备","seq":null,"text":"……好重，非得拿这个吗？","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06138648BEEFE1000183132373639353132.mp3"},{"id":"06106648BEEFE1000183132373839323039","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_购买装备","category":"装备","seq":null,"text":"有椒盐味的小鱼干卖吗？","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06106648BEEFE1000183132373839323039.mp3"},{"id":"06910648BEEFD1000183134303432353439","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_老夫子击杀，小满助攻","category":"击杀","seq":null,"text":"老夫子：学着点，有些事要动手才能解决的，别总心不在焉。\n姬小满：啊是是是，不愧是您，天下无敌。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06910648BEEFD1000183134303432353439.mp3"},{"id":"06195648BEEFD1000183130393430323637","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_进入战斗2","category":"台词","seq":null,"text":"速战速决。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06195648BEEFD1000183130393430323637.mp3"},{"id":"06253648BEEFD1000183739383438333433","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_小满击杀，老夫子助攻2","category":"击杀","seq":null,"text":"老夫子：哦吼吼，太阳打西边出来了，你也开始努力了？\n姬小满：稍微认真了一点。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06253648BEEFD1000183739383438333433.mp3"},{"id":"06722648BEEFD1000183132313236353938","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_狂铁击杀，小满助攻","category":"击杀","seq":null,"text":"狂铁：怎么样？以后换我来保护你！\n姬小满：哦？那你可得更努力一点。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06722648BEEFD1000183132313236353938.mp3"},{"id":"06545648BEEFD1000183633333531303234","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_小满击杀，狂铁助攻1","category":"击杀","seq":null,"text":"狂铁：挺厉害的嘛，配合默契！\n姬小满：勉为其难帮你解决这个麻烦。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06545648BEEFD1000183633333531303234.mp3"},{"id":"06769648BEEFD1000183538393532303336","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_小满击杀，狂铁助攻2","category":"击杀","seq":null,"text":"狂铁：帅啊，我热血沸腾了！接下来用哪一招？\n姬小满：当然是，收工，风紧扯呼。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06769648BEEFD1000183538393532303336.mp3"},{"id":"06975648BEEFC1000183130323636323630","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_被动idle5","category":"技能","seq":null,"text":"姬小满：喝足吃饱，阳光正好。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06975648BEEFC1000183130323636323630.mp3"},{"id":"06957648BEEFC1000183835343130303636","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_进入战斗1","category":"台词","seq":null,"text":"额，真麻烦。","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06957648BEEFC1000183835343130303636.mp3"},{"id":"06302648BEEFC1000183330383238343830","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_被动idle2","category":"技能","seq":null,"text":"姬小满：人生不是独木桥，每个人有自己的步调。","hasText":true,"duration":6.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06302648BEEFC1000183330383238343830.mp3"},{"id":"06688648BEEFC1000183334323730323236","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_被动idle3","category":"技能","seq":null,"text":"姬小满：我们走，皮皮烦。\n小烦：哔哔哔哔哔哔哔哔！","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06688648BEEFC1000183334323730323236.mp3"},{"id":"06720648BEEFC1000183633323435303339","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_被动idle4","category":"技能","seq":null,"text":"姬小满：没有什么比小鱼干更令人心情愉悦了。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06720648BEEFC1000183633323435303339.mp3"},{"id":"06456648BEEFB1000183130343538313234","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能3","category":"技能","seq":null,"text":"稍微认真一点。","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06456648BEEFB1000183130343538313234.mp3"},{"id":"06768648BEEFB1000183131333131303336","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能3","category":"技能","seq":null,"text":"一味趋吉避凶，心又何处安放？","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06768648BEEFB1000183131333131303336.mp3"},{"id":"06972648BEEFB1000183538393334373635","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能3","category":"技能","seq":null,"text":"千变万化，归于一心。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06972648BEEFB1000183538393334373635.mp3"},{"id":"06892648BEEFB1000183539343230353536","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_被动idle1","category":"技能","seq":null,"text":"小烦：哔哔哔哔，哔哔哔……\n姬小满：安静，这可是人生最重要的零食时间！\n小烦：哔？哔！哔！哔哔哔哔哔哔！\n姬小满：……算了。","hasText":true,"duration":9.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06892648BEEFB1000183539343230353536.mp3"},{"id":"06790648BEEF91000183131323731383439","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能彩蛋","category":"技能","seq":null,"text":"意外吗？","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06790648BEEF91000183131323731383439.mp3"},{"id":"06400648BEEF91000183930353337363038","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能彩蛋","category":"技能","seq":null,"text":"还没结束。","hasT
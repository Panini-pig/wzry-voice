ni-pigs.cn/audio/830/0604066BC824C1000183331383938333533.mp3"},{"id":"0686366BC824A1000183636353633333637","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音6","category":"移动","seq":null,"text":"在无人领域开创先例的感觉~好像，还不错~","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0686366BC824A1000183636353633333637.mp3"},{"id":"0639666BC824B1000183134323131393032","heroId":"830","skinId":"1310","skinName":"战舞者","title":"击杀语音1","category":"击杀","seq":null,"text":"嗯~意料之中","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0639666BC824B1000183134323131393032.mp3"},{"id":"0623966BC824B1000183930353232353231","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音7","category":"移动","seq":null,"text":"任何招式都有破绽，而聪明人的招式，就是利用破绽","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0623966BC824B1000183930353232353231.mp3"},{"id":"0639566BC824A1000183737373533313231","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音4","category":"移动","seq":null,"text":"飞腿迅步，攻防有度，记住了吗？这真正的战舞！","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0639566BC824A1000183737373533313231.mp3"},{"id":"0655766BC824A1000183139393938373230","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音3","category":"移动","seq":null,"text":"放轻松，把拳脚丢给鼓点，自由才是第一奥义~","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0655766BC824A1000183139393938373230.mp3"},{"id":"0696466BC82491000183939383434303935","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音2","category":"移动","seq":null,"text":"惯例不是真理，常规也并非永恒。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/0696466BC82491000183939383434303935.mp3"},{"id":"0675166BC824A1000183134373835313139","heroId":"830","skinId":"1310","skinName":"战舞者","title":"移动语音5","category":"移动","seq":null,"text":"改变的诀窍，是常问自己——有何不可？","hasText":true,"duration":4,"audio":"https://audio.
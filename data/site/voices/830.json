0183532323537343238.mp3"},{"id":"06530648BEEF21000183836373237303638","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_移动语音2","category":"移动","seq":null,"text":"天塌了，总有想当英雄的家伙顶着。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06530648BEEF21000183836373237303638.mp3"}]
.panini-pigs.cn/audio/830/060746A3CF64D1000183836373030323130.mp3"},{"id":"061636A3CF64D1000183832353239323339","heroId":"830","skinId":"1758","skinName":"灵喵仙官","title":"移动喊话2","category":"移动","seq":null,"text":"仙规如毛，不如作猫。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/061636A3CF64D1000183832353239323339.mp3"},{"id":"069216A3CF64C1000183730323932373031","heroId":"830","skinId":"1758","skinName":"灵喵仙官","title":"大厅喊话1","category":"大厅","seq":null,"text":"我等奉封印局之命，缉拿妖邪——黄风怪这种硬茬，可不好“偷懒”啊。","hasText":true,"duration":17.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/069216A3CF64C1000183730323932373031.mp3"},{"id":"069106A3CF64D1000183133313034303233","heroId":"830","skinId":"1758","skinName":"灵喵仙官","title":"移动喊话1","category":"移动","seq":null,"text":"别慌，比起天宫被闹那会儿，这都是小场面。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/069106A3CF64D1000183133313034303233.mp3"},{"id":"066426A3CF64C1000183437363630323133","heroId":"830","skinId":"1758","skinName":"灵喵仙官","title":"大厅喊话2","category":"大厅","seq":null,"text":"捉妖路远，不急一时，张弛有度方致千里。","hasText":true,"duration":18.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/066426A3CF64C1000183437363630323133.mp3"},{"id":"069416A3CF64C1000183138313336393434","heroId":"830","skinId":"1758","skinName":"灵喵仙官","title":"大厅喊话3","category":"大厅","seq":null,"text":"怎么又来活了……猫猫们，今天谁当值来着。","hasText":true,"duration":17.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/069416A3CF64C1000183138313336393434.mp3"},{"id":"06352648BEEFA1000183130323137373036","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能2-1","category":"技能","seq":1,"text":"凌空！","hasText":true,"duration":0.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/830/06352648BEEFA1000183130323137373036.mp3"},{"id":"06613648BEEF91000183138333731333032","heroId":"830","skinId":"831","skinName":"武道奇才","title":"姬小满_武道奇才_技能2-1","category":"技能","seq":1,"text":"走！","hasText":true,"duration":0.3,"audio":"ht
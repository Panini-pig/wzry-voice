[{"id":"06315695F205F1000183831393731333631","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"大禹友1","category":"台词","seq":null,"text":"蚩奼：咳咳……又炸炉了，到底是哪里出了问题！","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/06315695F205F1000183831393731333631.mp3"},{"id":"06280695F20601000183132393030303931","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"大禹友2","category":"台词","seq":null,"text":"蚩奼：这些笑话比山上的石头都老！等我在外面搜罗点新鲜的回来！","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/06280695F20601000183132393030303931.mp3"},{"id":"06528692952811000183538363939303136","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼-拾年声藏贺文","category":"台词","seq":null,"text":"很高兴见面，我是你的新朋友，蚩奼。\n你的过去我未曾参与，但你的未来，我不会缺席！\n愿十年后，你已经实现了自己的心愿。\n而我，也铸造出了世间最强的五兵！\n到那时，我们再回到这里。\n以老朋友的身份相聚，共","hasText":true,"duration":22.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/06528692952811000183538363939303136.mp3"},{"id":"0686068D8F7281000183834363837363231","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&杨戬（方言版）","category":"台词","seq":null,"text":"蚩奼：不会吧……爱摇尾巴的小不点，就是威风凛凛的哮天犬！","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0686068D8F7281000183834363837363231.mp3"},{"id":"0618468D8F7271000183234363631333531","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&海月（敌对）（方言版）","category":"台词","seq":null,"text":"蚩奼：竟敢使阴招，放出归山一族世代镇压的紊流。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0618468D8F7271000183234363631333531.mp3"},{"id":"0655068D8F7261000183235303434383738","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&老夫子1（方言版）","category":"台词","seq":null,"text":"蚩奼：敬爱的司长，我想加入奇迹司。唔……申请是这么写的吧。","hasText":true,"duration":14.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0655068D8F7261000183235303434383738.mp3"},{"id":"0603268D8F7261000183932363332383834","heroId":"1649","skinId":"1650","skinName":"五兵之主","titl
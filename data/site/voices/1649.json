3333.mp3"},{"id":"0652568D8F7241000183135333435373033","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&空空儿3（方言版）","category":"台词","seq":null,"text":"蚩奼：空空儿，你说的那些厉害器，究竟在哪！","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0652568D8F7241000183135333435373033.mp3"},{"id":"0678668D8F7211000183136373139363734","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己4（方言版）","category":"台词","seq":null,"text":"蚩奼：真……真的可以吗……啊，好暖和……","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0678668D8F7211000183136373139363734.mp3"},{"id":"0671168D8F7221000183730393434373738","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&空空儿1","category":"台词","seq":null,"text":"蚩奼：戏法糖人我没兴趣，你们说的那些器，我倒想看看！","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0671168D8F7221000183730393434373738.mp3"},{"id":"0647668D8F7221000183137383235393333","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&空空儿1（方言版）","category":"台词","seq":null,"text":"蚩奼：戏法糖人我没兴趣，你们说的那些器，我倒想看看！","hasText":true,"duration":7.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0647668D8F7221000183137383235393333.mp3"},{"id":"0603868D8F7211000183339393736393637","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己4","category":"台词","seq":null,"text":"蚩奼：真……真的可以吗……啊，好暖和……","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0603868D8F7211000183339393736393637.mp3"},{"id":"0681368D8F7231000183132303239313331","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&空空儿2","category":"台词","seq":null,"text":"蚩奼：什么锻……什么锤音……你这戏词，也太长了吧。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0681368D8F7231000183132303239313331.mp3"},{"id":"0687068D8F71F1000183134343433373237","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己2","category":"台词","seq":null,"text":"蚩奼：他呀，是我们归山一族的头儿，本领很大，有事就找他。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0687068D8F71F1000183134343433373237.mp3"},{"id":"0697868D8F7201000183232383431323334","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己3（方言版）","category":"台词","seq":null,"text":"蚩奼：可收拾被打坏的屋子，比打架难多了。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0697868D8F7201000183232383431323334.mp3"},{"id":"0651568D8F71E1000183930373939373531","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己1（方言版）","category":"台词","seq":null,"text":"蚩奼：以后归山就是你家，谁敢欺负你，我就揍扁他。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0651568D8F71E1000183930373939373531.mp3"},{"id":"0615168D8F7201000183132393438353836","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己2（方言版）","category":"台词","seq":null,"text":"蚩奼：他呀，是我们归山一族的头儿，本领很大，有事就找他。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0615168D8F7201000183132393438353836.mp3"},{"id":"0646468D8F7201000183133303039373633","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&妲己3","category":"台词","seq":null,"text":"蚩奼：可收拾被打坏的屋子，比打架难多了。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0646468D8F7201000183133303039373633.mp3"},{"id":"0692168D8F71E1000183735343938393534","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&哪吒3（方言版）","category":"台词","seq":null,"text":"蚩奼：你以前——真的一个人掀翻过大海？","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0692168D8F71E1000183735343938393534.mp3"},{"id":"0624768D8F71D1000183134333839383831","heroId":"1649","skinId":"1650","skinName":"五兵之主","title":"蚩奼&哪吒2","category":"台词","seq":null,"text":"蚩奼：谁怕谁，输的人晚上肉归对方，一口不留！","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1649/0624768D8F71D1000183134333839383831.mp3"},{"id":"0658268D8F71D1000183134303535393435","heroId":"1649","skinId":"1650","skinName":"五兵之
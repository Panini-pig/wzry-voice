.cn/audio/221/060216800A87B1000183437383437393233.mp3"},{"id":"067276800A87A1000183136333133383732","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"三技能语音1","category":"技能","seq":null,"text":"上课走神，要到长老身边来听！","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/067276800A87A1000183136333133383732.mp3"},{"id":"069446800A87A1000183537393430343838","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"三技能语音2","category":"技能","seq":null,"text":"一定要老人家亲自动手吗？","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/069446800A87A1000183537393430343838.mp3"},{"id":"068276800A8791000183236383337393534","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"个性动作","category":"动作","seq":null,"text":"陪孩子玩耍的时间，也该添进计划之中。","hasText":true,"duration":10.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/068276800A8791000183236383337393534.mp3"},{"id":"061956800A8781000183132373736323330","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音8","category":"移动","seq":null,"text":"从前，我们的家有着广袤的原野和草地……很快就能看见了。","hasText":true,"duration":9.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/061956800A8781000183132373736323330.mp3"},{"id":"063396800A8791000183937383233373638","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"一技能语音2","category":"技能","seq":null,"text":"靠近点，听不清！","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/063396800A8791000183937383233373638.mp3"},{"id":"066076800A8771000183138303437383433","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音7","category":"移动","seq":null,"text":"与邻居保持和睦关系，是生存守则的必要前提。","hasText":true,"duration":6.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/066076800A8771000183138303437383433.mp3"},{"id":"067186800A8781000183136363133313438","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"挑衅","category":"挑衅","seq":null,"text":"以你的智慧，我很难解释。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/067186800A8781000183136363133313438.mp3"},{"id":"061656800A8781000183133373032333238","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"死亡","category":"死亡","seq":null,"text":"属于藏狐的狩猎时段结束了……","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/061656800A8781000183133373032333238.mp3"},{"id":"064546800A8781000183133363237373531","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"击杀","category":"击杀","seq":null,"text":"学艺不精！","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/064546800A8781000183133363237373531.mp3"},{"id":"062726800A8791000183238353138313530","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"一技能语音1","category":"技能","seq":null,"text":"直视长老的眼睛。","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/062726800A8791000183238353138313530.mp3"},{"id":"062496800A8771000183134383633373734","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音5","category":"移动","seq":null,"text":"与方脸和解，是老人家长寿的第一步。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/062496800A8771000183134383633373734.mp3"},{"id":"065536800A8761000183135373331383431","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音3","category":"移动","seq":null,"text":"跑得再快，也别忘记来时的方向。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/065536800A8761000183135373331383431.mp3"},{"id":"065636800A8771000183333363031343735","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音6","category":"移动","seq":null,"text":"退一万步来说，难道就没人给老人家让个路吗？","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/065636800A8771000183333363031343735.mp3"},{"id":"069146800A8761000183739363939373937","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"大厅出现3","category":"大厅","seq":null,"text":"来自群山众灵的指示……庇佑我们繁衍至今。","hasText":true,"duration":12.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/069146800A8761000183739363939373937.mp3"},{"id":"069056800A8761000183530313630323731","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音2","category":"移动","seq":null,"text":"来自长老的经验之谈：晨昏交界之际，是捕猎的最佳时机。","hasText":true,"duration":8.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/069056800A8761000183530313630323731.mp3"},{"id":"067216800A8761000183132383230363338","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音1","category":"移动","seq":null,"text":"我在山洞里开了四个大门，遇到危险随时都能撤离——可不只是为了通风！","hasText":true,"duration":8.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/067216800A8761000183132383230363338.mp3"},{"id":"062706800A8771000183130313237323532","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"移动语音4","category":"移动","seq":null,"text":"行动敏捷固然重要，适度的警惕也必不可少！","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/062706800A8771000183130313237323532.mp3"},{"id":"064796800A8751000183935333530373836","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"大厅出现1","category":"大厅","seq":null,"text":"传说中可令高原安宁祥和的神明啊——正是生于此地的我们。","hasText":true,"duration":12.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/064796800A8751000183935333530373836.mp3"},{"id":"065746800A8751000183135383135303137","heroId":"221","skinId":"1520","skinName":"藏狐·褐绒","title":"大厅出现2","category":"大厅","seq":null,"text":"雪山，在我眼中没有秘密。","hasText":true,"duration":12.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/065746800A8751000183135383135303137.mp3"},{"id":"06053695F20671000183130393538343937","heroId":"221","skinId":"761","skinName":"万古长明","title":"大禹友1","category":"台词","seq":null,"text":"老夫子：整整两大箱土特产！老夫走进教室，还以为误入了食堂～","hasText":true,"duration":8.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06053695F20671000183130393538343937.mp3"},{"id":"06125692952941000183130353035373133","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子-拾年声藏贺文","category":"台词","seq":null,"text":"有朋自远方来，不亦乐乎。\n哈哈哈哈哈哈哈！\n不必拘束，今日可以暂且忘了那些规矩。\n这些年，你经历了不少，人世种种也见过许多。\n可还有疑惑？\n唔~和坏家伙讲不通道理？\n唔哈哈哈哈哈哈！\n简单，老夫再教你","hasText":true,"duration":28.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06125692952941000183130353035373133.mp3"},{"id":"0606668D8F7261000183431333537383230","heroId":"221","skinId":"761","skinName":"万古长明","title":"蚩奼&老夫子1","category":"台词","seq":null,"text":"老夫子：小家伙们越来越出息了，又招到了新伙伴。","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/0606668D8F7261000183431333537383230.mp3"},{"id":"06202648BECA21000183636303231323331","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子_万古长明_老夫子击杀，小满助攻","category":"击杀","seq":null,"text":"老夫子：学着点，有些事要动手才能解决的，别总心不在焉。\n姬小满：啊是是是，不愧是您，天下无敌。","hasText":true,"duration":8.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06202648BECA21000183636303231323331.mp3"},{"id":"06814648BECA21000183939313530303933","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子_万古长明_小满击杀，老夫子助攻2","category":"击杀","seq":null,"text":"老夫子：哦吼吼，太阳打西边出来了，你也开始努力了？\n姬小满：稍微认真了一点。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06814648BECA21000183939313530303933.mp3"},{"id":"06043648BECA21000183438303936363734","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子_万古长明_小满击杀，老夫子助攻1","category":"击杀","seq":null,"text":"老夫子：啊哈哈，打得不错，就比老夫差一点点。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06043648BECA21000183438303936363734.mp3"},{"id":"06628648BECA21000183131323739353539","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子_万古长明_角色呼喝(短)","category":"台词","seq":null,"text":"hu","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/221/06628648BECA21000183131323739353539.mp3"},{"id":"06735648BECA11000183136353738373735","heroId":"221","skinId":"761","skinName":"万古长明","title":"老夫子_万古长明_角色呼喝(中)","category":"台词","seq":null,"text":"ya","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/aud
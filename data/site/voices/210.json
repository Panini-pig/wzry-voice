09466A306B01000183137393235313333.mp3"},{"id":"0684366A306AF1000183130313633303230","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音8","category":"移动","seq":null,"text":"人非无情之物，既承宗主旧恩，当思酬报，铭诸心腑。","hasText":true,"duration":7.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0684366A306AF1000183130313633303230.mp3"},{"id":"0664466A306AE1000183133323334313039","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音5","category":"移动","seq":null,"text":"回首半生悖谬，如泉行冰下，日夜幽咽，而人不知。","hasText":true,"duration":8.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0664466A306AE1000183133323334313039.mp3"},{"id":"0649566A306AF1000183739333836363230","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"出生语音","category":"台词","seq":null,"text":"身在江湖，最忌背义忘恩，负心违愿。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0649566A306AF1000183739333836363230.mp3"},{"id":"0617166A306AD1000183434333334393633","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音4","category":"移动","seq":null,"text":"刀剑加身，又何及心中怆痛？","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0617166A306AD1000183434333334393633.mp3"},{"id":"0683266A306AE1000183931363233393936","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音6","category":"移动","seq":null,"text":"以神异之名行惑世之实，极恶不赦，某必诛之！","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0683266A306AE1000183931363233393936.mp3"},{"id":"0601366A306AE1000183131313330353335","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音7","category":"移动","seq":null,"text":"而今酩酊看华发，群山应笑我如何。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0601366A306AE1000183131313330353335.mp3"},{"id":"0640566A306AC1000183530393631363136","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音1","category":"移动","seq":null,"text":"此去梅隐山庄，虽长路迢迢，未敢不至。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0640566A306AC1000183530393631363136.mp3"},{"id":"0633866A306AD1000183435303633353033","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音2","category":"移动","seq":null,"text":"平生意气磊落，不畏身死，只畏辜负北刀之名。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0633866A306AD1000183435303633353033.mp3"},{"id":"0623866A306AD1000183130353333383335","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"移动语音3","category":"移动","seq":null,"text":"红袖香销，孤冢嶕峣。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0623866A306AD1000183130353333383335.mp3"},{"id":"0611166A306AC1000183634363531323434","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"大厅出现3","category":"大厅","seq":null,"text":"厉风卷刃刀堆雪，雪冷荒山道。","hasText":true,"duration":22,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0611166A306AC1000183634363531323434.mp3"},{"id":"0626466A306AC1000183938373832313838","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"大厅出现2","category":"大厅","seq":null,"text":"红颜骨朽，故冢霜重，漫思旧事还自笑。","hasText":true,"duration":22,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0626466A306AC1000183938373832313838.mp3"},{"id":"0652366A306AB1000183534373431363231","heroId":"210","skinId":"1270","skinName":"霜北刀","title":"大厅出现1","category":"大厅","seq":null,"text":"刀存曲直，行辨是非。","hasText":true,"duration":12.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/0652366A306AB1000183534373431363231.mp3"},{"id":"06363692952A91000183136363136343732","heroId":"210","skinId":"663","skinName":"不羁之风","title":"夏侯惇-拾年声藏贺文","category":"台词","seq":null,"text":"比起朋友，我更愿意称你为对手。\n来痛快的战一场吧！\n相逢十年的喜悦，不正应该以热烈的交锋庆祝么？\n啊哈哈哈，小心点，我的刀法可是越来越强了！\n毕竟，这些年的确经历了很多有趣的战斗啊！","hasText":true,"duration":23.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/210/06363692952A91000183136363136343732.mp3"},{"id":"06691648BEB221000183838303033353939","heroId":"210","skinId":"663","skinName":"不羁之风","title":"夏侯惇_不羁之风_角色呼喝（短）","category":"台词","seq":null,"t
268","skinId":"1436","skinName":"祥瑞亨通","title":"技能语音2_2人形态","category":"技能","seq":2,"text":"天光护我心！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0629767908E801000183136393037343031.mp3"},{"id":"0616967908E821000183638313538303331","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"挑衅","category":"挑衅","seq":null,"text":"陆吾与狼，无限猖狂！","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0616967908E821000183638313538303331.mp3"},{"id":"0620767908E821000183133383433333431","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"个性动作（人形态）","category":"动作","seq":null,"text":"这回训练完可不能再奖励自己吃一顿了","hasText":true,"duration":8.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0620767908E821000183133383433333431.mp3"},{"id":"0667667908E811000183136323030383737","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"五杀语音","category":"击杀","seq":null,"text":"你们五个别扎堆站啊！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0667667908E811000183136323030383737.mp3"},{"id":"0655967908E811000183137383538343131","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"击杀语音","category":"击杀","seq":null,"text":"弄伤我没关系，可你伤了我朋友！","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0655967908E811000183137383538343131.mp3"},{"id":"0613067908E7F1000183136383639393635","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"死亡语音（人形态）","category":"死亡","seq":null,"text":"这是一场试炼……","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0613067908E7F1000183136383639393635.mp3"},{"id":"0638267908E7E1000183136373236373031","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"我见过乐善好施的妖怪，也见过卑劣成性的人类。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0638267908E7E1000183136373236373031.mp3"},{"id":"0614067908E7E1000183930323230353731","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"才闭关没几天，大伙儿头顶上的毛怎么都变白了？","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0614067908E7E1000183930323230353731.mp3"},{"id":"0695867908E7E1000183130333730313834","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"昨日下山讨美食，今日千里斗邪魔，都有小狼陪着我。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0695867908E7E1000183130333730313834.mp3"},{"id":"0670667908E7B1000183633303836373230","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"大厅语音","category":"大厅","seq":null,"text":"生而无畏，战至终章！","hasText":true,"duration":20.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0670667908E7B1000183633303836373230.mp3"},{"id":"0679767908E7E1000183132373533343739","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"过去难以挽回，未来犹可追。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0679767908E7E1000183132373533343739.mp3"},{"id":"0674267908E7D1000183537333739333731","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"祥瑞的意思嘛，大概就是……这儿，归我罩了！","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0674267908E7D1000183537333739333731.mp3"},{"id":"0695667908E7C1000183135353833323730","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"大厅语音","category":"大厅","seq":null,"text":"哪里来的妖邪，够胆跟我碰一碰！","hasText":true,"duration":18.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0695667908E7C1000183135353833323730.mp3"},{"id":"0646367908E7D1000183537363234353039","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"无论在山顶待了多久，都不能忘了山脚是什么样。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0646367908E7D1000183537363234353039.mp3"},{"id":"0613167908E7D1000183137313237383733","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"天地灵气可填不饱肚子，还是山下的烤鸡腿更好吃。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0613167908E7D1000183137313237383733.mp3"},{"id":"0667367908E7C1000183132313239313030","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"大厅语音","category":"大厅","seq":null,"text":"上达九天伴明月，下至人间踏亨衢。","hasText":true,"duration":20,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0667367908E7C1000183132313239313030.mp3"},{"id":"0648967908E7C1000183536353630393438","heroId":"268","skinId":"1436","skinName":"祥瑞亨通","title":"移动语音","category":"移动","seq":null,"text":"陆吾一族，驻昆仑之巅，守一方太平。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/0648967908E7C1000183536353630393438.mp3"},{"id":"06146692952A11000183134363336313533","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎-拾年声藏贺文","category":"台词","seq":null,"text":"嘿！朋友！我们长一双拳头，不就是为了保护弱小吗？\n所以，来和我一起惩恶扬善吧！\n什么？\n哼，我可没忘记当初来长安的目的！\n放心吧，无论要用多久，无论需要付出什么代价。\n我都会让真相大白！\n等着瞧吧！","hasText":true,"duration":23.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06146692952A11000183134363336313533.mp3"},{"id":"06407648077D91000183433313635353730","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"六合虎拳","category":"台词","seq":null,"text":"六合虎拳","hasText":false,"duration":191.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06407648077D91000183433313635353730.mp3"},{"id":"06688648BE5FC1000183135363630373531","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"有人还能理直气壮的生存，因为缺少灵魂。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06688648BE5FC1000183135363630373531.mp3"},{"id":"06224648BE5FC1000183132383335303037","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"哇，简直就是在违法的边缘试探嘛","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06224648BE5FC1000183132383335303037.mp3"},{"id":"06760648BE5FC1000183138313831323135","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，俺们从来没见过，俺不是你认识的那个人。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06760648BE5FC1000183138313831323135.mp3"},{"id":"06551648BE5FC1000183136383134393134","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，你的人生观会被俺的拳头颠覆！","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06551648BE5FC1000183136383134393134.mp3"},{"id":"06191648BE5FC1000183335363731363735","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，这家伙做饭贼难吃","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06191648BE5FC1000183335363731363735.mp3"},{"id":"06808648BE5FB1000183234333236393634","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，阴险的敌人永远不敢来场堂堂正正的对决","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06808648BE5FB1000183234333236393634.mp3"},{"id":"06771648BE5FB1000183133303535313032","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，你将后悔自己的无能，后悔无法拯救长城","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06771648BE5FB1000183133303535313032.mp3"},{"id":"06727648BE5FB1000183136313939333834","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"眼泪，不知不觉流下来……琴声里燃烧着的，是长城的篝火","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06727648BE5FB1000183136313939333834.mp3"},{"id":"06460648BE5FB1000183137353035303038","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"眼泪，不知不觉流下来……琴声里燃烧着的，是长城的篝火","hasText":true,"duration":7.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06460648BE5FB1000183137353035303038.mp3"},{"id":"06082648BE5FB1000183136363139383434","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"打个赌，小矮子通常都扮演领便当的龙套","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06082648BE5FB1000183136363139383434.mp3"},{"id":"06056648BE5FA1000183331363236303334","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"裴擒虎：小星子！再遇到这种事，俺们男子汉可得一起承担！\n弈星：好，男子汉间的约定","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06056648BE5FA1000183331363236303334.mp3"},{"id":"06170648BE5FA1000183333353338323134","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"裴擒虎：今天输了，明天也要卷土重来\n弈星：一力降十会","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06170648BE5FA1000183333353338323134.mp3"},{"id":"06784648BE5FA1000183832323431333335","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_敌方对白","category":"台词","seq":null,"text":"裴擒虎：哎哎，这步俺下错了，重来一次！\n弈星：在我这里，可没有悔棋的规矩啊（略带笑意）","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06784648BE5FA1000183832323431333335.mp3"},{"id":"06454648BE5FA1000183636333036333736","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"裴擒虎：刚出锅的包子！给你买了10个~\n弈星：虎子，我（被烫到的语气词）……谢谢","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06454648BE5FA1000183636333036333736.mp3"},{"id":"06043648BE5FA1000183333313737363137","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"连厨子都没有，真是个冷漠的组织","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06043648BE5FA1000183333313737363137.mp3"},{"id":"06250648BE5FA1000183138303534323537","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"胜负心强烈的家伙！","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06250648BE5FA1000183138303534323537.mp3"},{"id":"06759648BE5F91000183830373130323030","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"哇，这堪比老姐的黑暗料理，拿俺试毒吗？","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06759648BE5F91000183830373130323030.mp3"},{"id":"06384648BE5F91000183134353531353431","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"比你的料理更恐怖，比明的占卜更致命，比星的棋盘更惊天动地，唯有俺老姐","hasText":true,"duration":8,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06384648BE5F91000183134353531353431.mp3"},{"id":"06312648BE5F91000183133353334353134","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"同情很廉价，别用可怜的眼神瞧俺","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06312648BE5F91000183133353334353134.mp3"},{"id":"06189648BE5F91000183432333937373130","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"公孙离：流浪的，伤痕累累的虎，离会照顾你的！\n虎：可你连做饭都不会呀……","hasText":true,"duration":8.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06189648BE5F91000183432333937373130.mp3"},{"id":"06646648BE5F91000183134383433303239","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_友方对白","category":"台词","seq":null,"text":"梦想什么的，不重要了。那里还有等着俺的兄弟！","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/268/06646648BE5F91000183134383433303239.mp3"},{"id":"06152648BE5F81000183133373434343837","heroId":"268","skinId":"339","skinName":"六合虎拳","title":"裴擒虎_六合虎拳_挑衅","category":"挑衅","seq":null,"text":"老虎不发威，当俺是病猫吗！","hasText":true,"duratio
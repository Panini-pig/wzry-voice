p3"},{"id":"06858698C3E011000183137383534393136","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"被动收枪第二枪","category":"技能","seq":null,"text":"吾枪","hasText":true,"duration":0.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06858698C3E011000183137383534393136.mp3"},{"id":"06894698C3DFE1000183838343932353839","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"死亡","category":"死亡","seq":null,"text":"遍野灯火，如日如昼……","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06894698C3DFE1000183838343932353839.mp3"},{"id":"06834698C3DFF1000183131313639343137","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"IDLE","category":"台词","seq":null,"text":"来！找找山里最鲜的菌子！","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06834698C3DFF1000183131313639343137.mp3"},{"id":"06785698C3DFE1000183130353239323938","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"挑衅","category":"挑衅","seq":null,"text":"山野小怪，也敢在此装神弄鬼？","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06785698C3DFE1000183130353239323938.mp3"},{"id":"06556698C3DFE1000183134343230373237","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"击杀","category":"击杀","seq":null,"text":"百鬼莫行！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06556698C3DFE1000183134343230373237.mp3"},{"id":"06475698C3DFE1000183438343339383933","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话8","category":"移动","seq":null,"text":"路遇山菌需仔细辨认，否则……或见五色小人","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06475698C3DFE1000183438343339383933.mp3"},{"id":"06989698C3DFF1000183135323336393437","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"回城","category":"回城","seq":null,"text":"天涯有信，四海同归","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06989698C3DFF1000183135323336393437.mp3"},{"id":"06376698C3DFC1000183136363132393230","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话2","category":"移动","seq":null,"text":"此道雾重难行，商旅持火相映，驱马易物，已承千年。","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06376698C3DFC1000183136363132393230.mp3"},{"id":"06123698C3DFC1000183133363236333635","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话4","category":"移动","seq":null,"text":"一人之火尚小，连绵千里成光。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06123698C3DFC1000183133363236333635.mp3"},{"id":"06824698C3DFD1000183132323238333530","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话7","category":"移动","seq":null,"text":"我看见，人们穿过瘴岭蛇谷，踏出山外的第一步。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06824698C3DFD1000183132323238333530.mp3"},{"id":"06831698C3DFD1000183132333539393332","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话6","category":"移动","seq":null,"text":"听这山寨铃音，乱跑的小鬼头们，都平安归家了吧？","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06831698C3DFD1000183132333539393332.mp3"},{"id":"06589698C3DFD1000183130313937393736","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话5","category":"移动","seq":null,"text":"无星无月之际，识我银枪足矣！","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06589698C3DFD1000183130313937393736.mp3"},{"id":"06631698C3DFC1000183536323638313535","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话3","category":"移动","seq":null,"text":"行夤（yín）夜，消厉瘴，洞照十方，百鬼伏藏！","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06631698C3DFC1000183536323638313535.mp3"},{"id":"06525698C3DFC1000183438373135303936","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"移动喊话1","category":"移动","seq":null,"text":"燃枪照夜，驱散万邪！","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06525698C3DFC1000183438373135303936.mp3"},{"id":"06990698C3DFB1000183133303636353538","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"大厅喊话3","category":"大厅","seq":null,"text":"九尺银枪穿云雾，十万驿铃醒山魂。","hasText":true,"duration":20.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06990698C3DFB1000183133303636353538.mp3"},{"id":"06700698C3DFA1000183135313832323938","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"大厅喊话1","category":"大厅","seq":null,"text":"神骥踏长风，丝路启千秋！","hasText":true,"duration":20,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06700698C3DFA1000183135313832323938.mp3"},{"id":"06973698C3DFB1000183732343034373033","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"大厅喊话2","category":"大厅","seq":null,"text":"开叠嶂之道，耀长夜冥冥！","hasText":true,"duration":20,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06973698C3DFB1000183732343034373033.mp3"},{"id":"06646698C3DFB1000183233363632343932","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"泉水喊话","category":"大厅","seq":null,"text":"乘风起，驰万里","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06646698C3DFB1000183233363632343932.mp3"},{"id":"06422698C2AB01000183133333634353635","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"马超-云缨2","category":"台词","seq":null,"text":"马超：雨后山珍，清水烹调，方能存其本味。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06422698C2AB01000183133333634353635.mp3"},{"id":"06249698C2AB01000183132323535373832","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"马超-云缨1","category":"台词","seq":null,"text":"马超：……又来？","hasText":true,"duration":0.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06249698C2AB01000183132323535373832.mp3"},{"id":"06890698C1F251000183633303537363037","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"狄仁杰-马超2","category":"台词","seq":null,"text":"马超：（嘶/哈——）舌尖发麻，面如着火，这就是她口中的“微辣”？","hasText":true,"duration":6.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06890698C1F251000183633303537363037.mp3"},{"id":"06297698C1F251000183132303431313639","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"狄仁杰-马超1","category":"台词","seq":null,"text":"马超：天光已晦，当夜狩百鬼。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06297698C1F251000183132303431313639.mp3"},{"id":"06894698BF92D1000183331303939333236","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"朵莉亚-马超2","category":"台词","seq":null,"text":"马超：这是你今天的第五次“保证”了。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06894698BF92D1000183331303939333236.mp3"},{"id":"06724698BF92C1000183133313532363030","heroId":"168","skinId":"1704","skinName":"神骥·逐星野","title":"朵莉亚-马超1","category":"台词","seq":null,"text":"马超：……那一定不是我。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06724698BF92C1000183133313532363030.mp3"},{"id":"06689648BEA721000183135333934373539","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音3-1","category":"技能","seq":1,"text":"再持战枪，银芒乍亮。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06689648BEA721000183135333934373539.mp3"},{"id":"06642648BEA711000183836323038393933","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音2-1","category":"技能","seq":1,"text":"看见我的枪了吗？","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06642648BEA711000183836323038393933.mp3"},{"id":"06684648BEA701000183637333233363034","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音1-1","category":"技能","seq":1,"text":"游刃有余","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06684648BEA701000183637333233363034.mp3"},{"id":"06360648BEA721000183435363336343134","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音3-2","category":"技能","seq":2,"text":"枪若白狼，一收一放。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06360648BEA721000183435363336343134.mp3"},{"id":"06927648BEA711000183131383237393135","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音2-2","category":"技能","seq":2,"text":"始祖庇佑","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06927648BEA711000183131383237393135.mp3"},{"id":"06148648BEA711000183135363530373333","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音1-2","category":"技能","seq":2,"text":"长驱直入","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06148648BEA711000183135363530373333.mp3"},{"id":"06391648BEA711000183132373832383231","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音1-3","category":"技能","seq":3,"text":"狼啸于天","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06391648BEA711000183132373832383231.mp3"},{"id":"06005648BEA711000183131333639393737","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_技能语音2-3","category":"技能","seq":3,"text":"从天而降","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06005648BEA711000183131333639393737.mp3"},{"id":"06760648BEA741000183137303633313137","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_遇见队友-冠军飞将","category":"台词","seq":null,"text":"感谢你曾给予我力量，愿你永远以我为荣光。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06760648BEA741000183137303633313137.mp3"},{"id":"06128648BEA741000183134393338313631","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_遇见队友-云鹰飞将","category":"台词","seq":null,"text":"携你之力，迎战未来。","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06128648BEA741000183134393338313631.mp3"},{"id":"06252648BEA731000183130333632333334","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_五杀","category":"击杀","seq":null,"text":"华城，现在我说了算。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06252648BEA731000183130333632333334.mp3"},{"id":"06196648BEA731000183733383537353239","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_特殊动作","category":"动作","seq":null,"text":"大将军与我，唔，恰好一局！","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06196648BEA731000183733383537353239.mp3"},{"id":"06850648BEA731000183738373539383033","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_拿到一血","category":"台词","seq":null,"text":"以狼之名，重铸荣光。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06850648BEA731000183738373539383033.mp3"},{"id":"06898648BEA731000183136343833393139","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_挑衅","category":"挑衅","seq":null,"text":"嘴硬，可不能帮你战胜我。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06898648BEA731000183136343833393139.mp3"},{"id":"06747648BEA721000183633333537343132","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_收枪被动普攻（第三枪）","category":"技能","seq":null,"text":"为枪","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06747648BEA721000183633333537343132.mp3"},{"id":"06823648BEA721000183130393834363632","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_收枪被动普攻（第二枪）","category":"技能","seq":null,"text":"以吾","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06823648BEA721000183130393834363632.mp3"},{"id":"06856648BEA721000183930343736323733","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_收枪被动普攻（第四枪）","category":"技能","seq":null,"text":"荡穿魍魉","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06856648BEA721000183930343736323733.mp3"},{"id":"06334648BEA721000183130303230353132","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_击杀语音","category":"击杀","seq":null,"text":"凭这点能耐也想阻止我？","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06334648BEA721000183130303230353132.mp3"},{"id":"06286648BEA701000183737373331303934","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_死亡语音","category":"死亡","seq":null,"text":"短暂的失败而已……","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06286648BEA701000183737373331303934.mp3"},{"id":"06473648BEA701000183334323337343137","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音7","category":"移动","seq":null,"text":"狼魂指引我归家之路。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06473648BEA701000183334323337343137.mp3"},{"id":"06324648BEA6F1000183135363333393634","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音4","category":"移动","seq":null,"text":"替我保管一下集团，属于我的我会亲自来取。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06324648BEA6F1000183135363333393634.mp3"},{"id":"06130648BEA6F1000183131303335363838","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音6","category":"移动","seq":null,"text":"若结果并非所愿，那就在尘埃落定前奋力一博。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06130648BEA6F1000183131303335363838.mp3"},{"id":"06419648BEA6F1000183134343733343030","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音5","category":"移动","seq":null,"text":"一切纷争与对抗的尽头，有我在。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06419648BEA6F1000183134343733343030.mp3"},{"id":"06018648BEA6F1000183935333931373033","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音1","category":"移动","seq":null,"text":"他们以为击败我就是终结，而我必归来将之改写。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06018648BEA6F1000183935333931373033.mp3"},{"id":"06307648BEA6F1000183733303931383038","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音2","category":"移动","seq":null,"text":"月映枪冷，战甲在身。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06307648BEA6F1000183733303931383038.mp3"},{"id":"06177648BEA6F1000183130343332343939","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_移动语音3","category":"移动","seq":null,"text":"（哼笑）前后铺垫，没有一件事那么简单。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06177648BEA6F1000183130343332343939.mp3"},{"id":"06157648BEA6E1000183139343438373230","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_大厅语音2","category":"大厅","seq":null,"text":"当人生无可失去……不过重来而已……从初始开始，才有意思。","hasText":true,"duration":21,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06157648BEA6E1000183139343438373230.mp3"},{"id":"06882648BEA6E1000183935353635353830","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_大厅语音1","category":"大厅","seq":null,"text":"失败曾令人想要逃离，但绝境重生，方为宿命。生而无畏，战至终章。","hasText":true,"duration":21,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06882648BEA6E1000183935353635353830.mp3"},{"id":"06207648BEA6E1000183138313136363632","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将_大厅语音3","category":"大厅","seq":null,"text":"跟随白狼足迹……这是……？我们回来了。","hasText":true,"duration":21,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06207648BEA6E1000183138313136363632.mp3"},{"id":"0620064786A6B1000183135333435383134","heroId":"168","skinId":"171","skinName":"无双飞将","title":"马超_无双飞将","category":"台词","seq":null,"text":"马超_无双飞将","hasText":false,"duration":129.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/0620064786A6B1000183135333435383134.mp3"},{"id":"06500697B1BC81000183339373730313432","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_营地春节语音","category":"台词","seq":null,"text":"只和理想结盟，只与纯洁立誓","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06500697B1BC81000183339373730313432.mp3"},{"id":"061216929529A1000183135393931333938","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超-拾年声藏贺文","category":"台词","seq":null,"text":"练就一门技艺很难，可一旦学成，就不会忘记。\n枪法如此，人生也是一样。\n从过去一路走来，这两者对你而言。\n想必都已不再是难题。\n今后的路只问决心，不问归途。\n现在，再次拿起枪，与我并肩破敌！","hasText":true,"duration":23.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/061216929529A1000183135393931333938.mp3"},{"id":"060186481481E1000183233343134363634","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"萧索孤枪","category":"台词","seq":null,"text":"萧索孤枪","hasText":false,"duration":225.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/060186481481E1000183233343134363634.mp3"},{"id":"06375648BEA671000183735323538303235","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_击杀语音","category":"击杀","seq":null,"text":"猜猜，我从何处来？","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06375648BEA671000183735323538303235.mp3"},{"id":"06139648BEA671000183532333039303938","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_挑衅","category":"挑衅","seq":null,"text":"别争了，我一直是狩猎大赛的冠军。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06139648BEA671000183532333039303938.mp3"},{"id":"06761648BEA651000183733343732323531","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音3","category":"技能","seq":null,"text":"我的枪去而复返，你的生命有去无回。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06761648BEA651000183733343732323531.mp3"},{"id":"06975648BEA651000183134393334353130","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音3","category":"技能","seq":null,"text":"归来无恙！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06975648BEA651000183134393334353130.mp3"},{"id":"06848648BEA651000183132333532333237","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音3","category":"技能","seq":null,"text":"万无一失！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06848648BEA651000183132333532333237.mp3"},{"id":"06477648BEA651000183137373831353832","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音2","category":"技能","seq":null,"text":"收割比正义来得快。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06477648BEA651000183137373831353832.mp3"},{"id":"06299648BEA641000183134343336343737","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音1","category":"技能","seq":null,"text":"穿膛而过！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06299648BEA641000183134343336343737.mp3"},{"id":"06223648BEA641000183938363135333035","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音2","category":"技能","seq":null,"text":"接受垂直领域的伤害！","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06223648BEA641000183938363135333035.mp3"},{"id":"06424648BEA641000183130383636393733","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音1","category":"技能","seq":null,"text":"如果你希望死得痛快，那倒是有希望。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06424648BEA641000183130383636393733.mp3"},{"id":"06584648BEA641000183131373134343937","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音1","category":"技能","seq":null,"text":"扎心吗？","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06584648BEA641000183131373134343937.mp3"},{"id":"06349648BEA641000183938353131303830","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_技能语音2","category":"技能","seq":null,"text":"别动，动也是死。","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06349648BEA641000183938353131303830.mp3"},{"id":"06472648BEA631000183835303430303037","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_移动语音3","category":"移动","seq":null,"text":"我和我的父亲一样聪明，但比他多些判断力。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06472648BEA631000183835303430303037.mp3"},{"id":"06423648BEA631000183134363036313438","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_移动语音5","category":"移动","seq":null,"text":"与子同袍，与我同行~","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06423648BEA631000183134363036313438.mp3"},{"id":"06738648BEA631000183135303139393135","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_移动语音4","category":"移动","seq":null,"text":"故人已往，故国未逝。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06738648BEA631000183135303139393135.mp3"},{"id":"06078648BEA631000183435333432313230","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_死亡语音","category":"死亡","seq":null,"text":"河水已经静止，树上已经结冰……","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06078648BEA631000183435333432313230.mp3"},{"id":"06800648BEA621000183132373530363833","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_移动语音1","category":"移动","seq":null,"text":"只和理想结盟，只与纯洁立誓。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06800648BEA621000183132373530363833.mp3"},{"id":"06395648BEA621000183137343337323135","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_大厅语音3","category":"大厅","seq":null,"text":"从未遗忘。","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06395648BEA621000183137343337323135.mp3"},{"id":"06743648BEA621000183134313431323833","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_大厅语音2","category":"大厅","seq":null,"text":"头脑和心灵一样清楚。","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06743648BEA621000183134313431323833.mp3"},{"id":"06631648BEA621000183130333335363735","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_移动语音2","category":"移动","seq":null,"text":"为失去的东西活着。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06631648BEA621000183130333335363735.mp3"},{"id":"06617648BEA621000183634363835363137","heroId":"168","skinId":"819","skinName":"冷晖之枪","title":"马超_冷晖之枪_大厅语音1","category":"大厅","seq":null,"text":"不必辨认我，识我的枪吧！","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/168/06617648BEA621000183634363835363137.mp3"}]
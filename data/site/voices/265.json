udio/265/06421698E95EB1000183132383137373833.mp3"},{"id":"06181698E95E91000183136313131303439","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音8","category":"移动","seq":null,"text":"风起于郊，武林不安呐……","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06181698E95E91000183136313131303439.mp3"},{"id":"06934698E95E81000183839303235303831","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音3","category":"移动","seq":null,"text":"我楼中消息可左右武林变局，求之，何吝千金？","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06934698E95E81000183839303235303831.mp3"},{"id":"06679698E95E81000183131393935333637","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音4","category":"移动","seq":null,"text":"方寸丝缕，杀人于无形——当心，可别让我抓到你。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06679698E95E81000183131393935333637.mp3"},{"id":"06604698E95E71000183133333735333333","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音1","category":"移动","seq":null,"text":"与其求神问仙，不如与百晓楼——做个交易。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06604698E95E71000183133333735333333.mp3"},{"id":"06432698E95E91000183132323234343335","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音5","category":"移动","seq":null,"text":"此花名为醉心，闻之辄醉，永眠于江湖大梦——","hasText":true,"duration":6.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06432698E95E91000183132323234343335.mp3"},{"id":"06030698E95E91000183433363830363237","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音7","category":"移动","seq":null,"text":"消逝的黄金砂乡？你竟听过那个地方……","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06030698E95E91000183433363830363237.mp3"},{"id":"06953698E95E91000183431333733343038","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音6","category":"移动","seq":null,"text":"名门，望族，豪富……百年兴替不过楼中几页书。","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06953698E95E91000183431333733343038.mp3"},{"id":"06475698E95E81000183134373536353232","heroId":"265","skinId":"1707","skinName":"百晓客","title":"移动语音2","category":"移动","seq":null,"text":"知晓的秘密太多，偶尔我也会觉得有些吵闹。","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06475698E95E81000183134373536353232.mp3"},{"id":"06004698E95E61000183137353735313835","heroId":"265","skinId":"1707","skinName":"百晓客","title":"大厅出现1","category":"大厅","seq":null,"text":"遥望玉京十二楼，重整寰瀛洗天穹。","hasText":true,"duration":14.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06004698E95E61000183137353735313835.mp3"},{"id":"06791698E95E71000183738343139343337","heroId":"265","skinId":"1707","skinName":"百晓客","title":"大厅出现3","category":"大厅","seq":null,"text":"纵晓天下之事，然而人心叵测。","hasText":true,"duration":14.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06791698E95E71000183738343139343337.mp3"},{"id":"06224698E95E71000183135383834373732","heroId":"265","skinId":"1707","skinName":"百晓客","title":"大厅出现2","category":"大厅","seq":null,"text":"掌覆江湖晓生死，袖拢飞花判去留——在下百晓客，想问些什么？","hasText":true,"duration":16.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06224698E95E71000183135383834373732.mp3"},{"id":"061686929529D1000183132353930303435","heroId":"265","skinId":"355","skinName":"灵魂劫卜","title":"明世隐-拾年声藏贺文","category":"台词","seq":null,"text":"人心如花，盛放或凋零，皆会在卦象间流转。\n这十年来，你所走的每一步，我都清清楚楚。\n呵呵~别那么警惕~\n你我可是朋友呢，未来还有很多事情在等着我们~\n难道你不想知道……\n你我故事的最终结局吗？","hasText":true,"duration":26.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/061686929529D1000183132353930303435.mp3"},{"id":"06227648BE6101000183631333736373933","heroId":"265","skinId":"355","skinName":"灵魂劫卜","title":"明世隐_灵魂劫卜_大厅语音3","category":"大厅","seq":null,"text":"复卦，万物亨通，逆境可再兴。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/265/06227648BE6101000183631333736373933.mp3"},{"id":"06107648076BE1000183135303433303131","heroId":"265","skinId":"355","skinName":"灵魂劫卜
0183938363639323236","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"三技能语音","category":"技能","seq":null,"text":"在启程之后，在抵达以前","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0690466F513361000183938363639323236.mp3"},{"id":"0669666F513351000183937343830393839","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"二技能语音","category":"技能","seq":null,"text":"万类复苏","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0669666F513351000183937343830393839.mp3"},{"id":"0681666F513351000183430333539353033","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"二技能语音","category":"技能","seq":null,"text":"和风细雨","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0681666F513351000183430333539353033.mp3"},{"id":"0655566F513351000183434353433393732","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"一技能语音","category":"技能","seq":null,"text":"羊来啦！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0655566F513351000183434353433393732.mp3"},{"id":"0699966F513351000183439303430383034","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"一技能语音","category":"技能","seq":null,"text":"跑快些！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0699966F513351000183439303430383034.mp3"},{"id":"0623366F513341000183136333239383934","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音7","category":"移动","seq":null,"text":"雪过天晴，小羊抖落糖霜。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0623366F513341000183136333239383934.mp3"},{"id":"0623166F513341000183135323939383139","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"死亡语音","category":"死亡","seq":null,"text":"风停了……","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0623166F513341000183135323939383139.mp3"},{"id":"0689866F513341000183131333231343935","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音8","category":"移动","seq":null,"text":"回家吧，忙忙碌碌的孩子，回家吧，黄昏已经降临。","hasText":true,"duration":7.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0689866F513341000183131333231343935.mp3"},{"id":"0698766F513331000183232333139393332","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音5","category":"移动","seq":null,"text":"天气不可捉摸，因为这些小家伙的心情本就不可捉摸。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0698766F513331000183232333139393332.mp3"},{"id":"0693966F513331000183334323939313639","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音4","category":"移动","seq":null,"text":"挤挤毛里的水，地上禾苗就喝饱啦。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0693966F513331000183334323939313639.mp3"},{"id":"0642066F513331000183135303432343538","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音6","category":"移动","seq":null,"text":"田野麦穗饱满，大地涌出蜜浆，看来农神正忙。","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0642066F513331000183135303432343538.mp3"},{"id":"0636066F513331000183633393231393937","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音3","category":"移动","seq":null,"text":"前行的方向，就是风的方向。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0636066F513331000183633393231393937.mp3"},{"id":"0629966F513321000183131343238373530","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音2","category":"移动","seq":null,"text":"天空从我手心溜走，化作脚底的一片湖泊。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0629966F513321000183131343238373530.mp3"},{"id":"0601666F513321000183138323839363039","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"大厅语音","category":"大厅","seq":null,"text":"此时情绪此时天。","hasText":true,"duration":26,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0601666F513321000183138323839363039.mp3"},{"id":"0662366F513321000183135333239303538","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"移动语音1","category":"移动","seq":null,"text":"剪掉羊毛，阳光也瘦了下来。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0662366F513321000183135333239303538.mp3"},{"id":"0670966F513311000183532313936373636","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"大厅语音","category":"大厅","seq":null,"text":"云朵化身小羊，天空是自由的牧场。","hasText":true,"duration":19.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0670966F513311000183532313936373636.mp3"},{"id":"0695766F513311000183530393731383630","heroId":"193","skinId":"1392","skinName":"牧神诗旅","title":"大厅语音","category":"大厅","seq":null,"text":"众神从未离去，我们藏在山巅，隐于梦中，栖身白云之上。","hasText":true,"duration":26.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0695766F513311000183530393731383630.mp3"},{"id":"06132697B1ABE1000183732303839343339","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_营地春节语音","category":"台词","seq":null,"text":"何必追求与众不同，你本就独一无二","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06132697B1ABE1000183732303839343339.mp3"},{"id":"06414692952B71000183136343338313839","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周-拾年声藏贺文","category":"台词","seq":null,"text":"啦啦啦啦啦...历练十年，如今可弄清了。\n和你对话的是蝴蝶，还是我？\n分不清也没关系，继续去做你想做的事情吧。\n早晚有一天你会明白的~\n哈~这句可不是梦话~","hasText":true,"duration":25.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06414692952B71000183136343338313839.mp3"},{"id":"0664465C2F48C1000183138333136353430","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_我福了","category":"台词","seq":null,"text":"我福了","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0664465C2F48C1000183138333136353430.mp3"},{"id":"0641665C2F4BA1000183137383233393230","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_新年快乐","category":"台词","seq":null,"text":"新年快乐","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0641665C2F4BA1000183137383233393230.mp3"},{"id":"0644865C2F4DD1000183537333333333239","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_烦恼忧愁追不上你，开心蝴蝶围绕着你~","category":"台词","seq":null,"text":"烦恼忧愁追不上你，开心蝴蝶围绕着你~","hasText":true,"duration":31,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/0644865C2F4DD1000183537333333333239.mp3"},{"id":"06651648BED731000183138313836303739","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_挑衅","category":"挑衅","seq":null,"text":"你在做梦。嗯，就是那个做梦的做梦。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06651648BED731000183138313836303739.mp3"},{"id":"06634648BED731000183232303430353234","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_技能语音3","category":"技能","seq":null,"text":"最近脑洞太大，得补补~","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06634648BED731000183232303430353234.mp3"},{"id":"06436648BED731000183438393434393439","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_击杀语音","category":"击杀","seq":null,"text":"醒醒吧，少年！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06436648BED731000183438393434393439.mp3"},{"id":"06265648BED721000183637363734313935","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_移动语音5","category":"移动","seq":null,"text":"一群人在人家梦里打来打去，有意思么？","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06265648BED721000183637363734313935.mp3"},{"id":"06303648BED721000183938363634323036","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_技能语音2","category":"技能","seq":null,"text":"这就是蝴蝶效应。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06303648BED721000183938363634323036.mp3"},{"id":"06851648BED721000183231323835353634","heroId":"193","skinId":"530","skinName":"逍遥幻梦","title":"庄周_逍遥幻梦_技能语音2","category":"技能","seq":null,"text":"美梦成真","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/193/06851648BED721000
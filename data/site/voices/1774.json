[{"id":"065076A8677021000183134313330303030","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"回城语音-1","category":"回城","seq":1,"text":"别着急，我的怒火，见者有份。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/065076A8677021000183134313330303030.mp3"},{"id":"061596A8677021000183637343939373937","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"Rest语音-1","category":"台词","seq":1,"text":"玩火的人，脾气都不会太好。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/061596A8677021000183637343939373937.mp3"},{"id":"063776A8677031000183130313039353331","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"复活语音-1","category":"复活","seq":1,"text":"灰烬赋予新生","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063776A8677031000183130313039353331.mp3"},{"id":"062516A8677021000183630353630303435","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"挑衅语音-1","category":"挑衅","seq":1,"text":"要我给你签个名吗？在你的墓志铭上。","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/062516A8677021000183630353630303435.mp3"},{"id":"062676A8677001000183131313131363739","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音-1","category":"击杀","seq":1,"text":"焦味，让人愉悦和安心。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/062676A8677001000183131313131363739.mp3"},{"id":"066356A8676FF1000183837303831363432","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（被动）-1","category":"技能","seq":1,"text":"送上门的。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066356A8676FF1000183837303831363432.mp3"},{"id":"064496A8676FF1000183335363730303839","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（C）-1","category":"技能","seq":1,"text":"卢雅那：我的怒火，无穷无尽！\n蛇：不止不息！","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/064496A8676FF1000183335363730303839.mp3"},{"id":"060646A8676FE1000183733343139323236","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（B）-1","category":"技能","seq":1,"text":"要跳舞吗？","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/060646A8676FE1000183733343139323236.mp3"},{"id":"069326A8676FD1000183332343835343036","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"死亡语音-1","category":"死亡","seq":1,"text":"残躯焚于烈火","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/069326A8676FD1000183332343835343036.mp3"},{"id":"066336A8676FD1000183839303438303739","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（A）-1","category":"技能","seq":1,"text":"不够！还是不够！","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066336A8676FD1000183839303438303739.mp3"},{"id":"063716A8676FA1000183131363232313630","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"开始语音-1","category":"台词","seq":1,"text":"我，就是虹湾的规矩。","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063716A8676FA1000183131363232313630.mp3"},{"id":"065466A8676FA1000183135303635313631","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"大厅语音-1","category":"大厅","seq":1,"text":"以我之名，腥风血雨。","hasText":true,"duration":10,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/065466A8676FA1000183135303635313631.mp3"},{"id":"066096A8676FB1000183235383330363039","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-1","category":"移动","seq":1,"text":"火被关得越紧，烧起来就越猛烈。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066096A8676FB1000183235383330363039.mp3"},{"id":"061126A8676F41000183336353631383838","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击破防御塔语音-1","category":"台词","seq":1,"text":"这地方归我了。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/061126A8676F41000183336353631383838.mp3"},{"id":"063536A8676F41000183636333037353437","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"助攻语音-1","category":"台词","seq":1,"text":"看来，有人活腻了。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063536A8676F41000183636333037353437.mp3"},{"id":"067216A8677021000183137303534353830","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"回城语音-2","category":"回城","seq":2,"text":"蛇：血雨将至，狂风乍起。\n卢雅那：翻译一下，你们死到临头了。","hasText":true,"duration":8.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/067216A8677021000183137303534353830.mp3"},{"id":"069306A8677001000183130303536323633","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音-2","category":"击杀","seq":2,"text":"瞧瞧，这灰烬的盛宴。","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/069306A8677001000183130303536323633.mp3"},{"id":"066056A8676FF1000183131303336353839","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（C）-2","category":"技能","seq":2,"text":"卢雅那：回应我！博伊塔塔！\n蛇：目之所及，燃烧殆尽！","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066056A8676FF1000183131303336353839.mp3"},{"id":"069356A8677001000183931393037313039","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（被动）-2","category":"技能","seq":2,"text":"我即是你，你即是我。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/069356A8677001000183931393037313039.mp3"},{"id":"066106A8676FD1000183136323339303135","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（A）-2","category":"技能","seq":2,"text":"可恶！可恶！可恶！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066106A8676FD1000183136323339303135.mp3"},{"id":"067816A8676FE1000183933353939313137","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（B）-2","category":"技能","seq":2,"text":"看着我的眼睛！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/067816A8676FE1000183933353939313137.mp3"},{"id":"066996A8676FB1000183134393838393632","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-2","category":"移动","seq":2,"text":"曾经我只能在灰薪堆里打滚儿，如今整个虹湾都要背诵我的大名。","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066996A8676FB1000183134393838393632.mp3"},{"id":"065156A8676FA1000183138313636303231","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"大厅语音-2","category":"大厅","seq":2,"text":"土地，尊严。属于我的，终将归还。","hasText":true,"duration":9.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/065156A8676FA1000183138313636303231.mp3"},{"id":"068396A8676F31000183134333135303430","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"挑衅语音-2","category":"挑衅","seq":2,"text":"谁这么不长眼，往我的地盘闯？","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/068396A8676F31000183134333135303430.mp3"},{"id":"061366A8677001000183132313834323138","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音-3","category":"击杀","seq":3,"text":"以牙还牙。","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/061366A8677001000183132313834323138.mp3"},{"id":"063286A8676FE1000183137353733373133","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（B）-3","category":"技能","seq":3,"text":"蛇在盯着你呢，我也一样。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063286A8676FE1000183137353733373133.mp3"},{"id":"066596A8676FF1000183839393039373231","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（C）-3","category":"技能","seq":3,"text":"卢雅那：拥抱颤抖！\n蛇：直面恐惧！","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066596A8676FF1000183839393039373231.mp3"},{"id":"069676A8676FD1000183130353534303231","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"技能语音（A）-3","category":"技能","seq":3,"text":"战！战！战！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/069676A8676FD1000183130353534303231.mp3"},{"id":"061146A8676FB1000183939373237303231","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-3","category":"移动","seq":3,"text":"混乱是阶梯，有人掉下来了，而我爬上去了。","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/061146A8676FB1000183939373237303231.mp3"},{"id":"066616A8676FA1000183136313434353134","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"大厅语音-3","category":"大厅","seq":3,"text":"生于尘土，根扎深林；与火同源，光照大地。","hasText":true,"duration":12.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066616A8676FA1000183136313434353134.mp3"},{"id":"061666A8676F41000183338343536353530","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"挑衅语音-3","category":"挑衅","seq":3,"text":"惹怒我，你可付不起代价。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/061666A8676F41000183338343536353530.mp3"},{"id":"066676A8676FB1000183830333534393231","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-4","category":"移动","seq":4,"text":"火蛇一族不会被遗忘，我和族人将不再躲藏。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066676A8676FB1000183830333534393231.mp3"},{"id":"066226A8676FC1000183330313033363434","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-5","category":"移动","seq":5,"text":"我们站在这里，昂起头颅，站在这里。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/066226A8676FC1000183330313033363434.mp3"},{"id":"063426A8676FC1000183130353634383135","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-6","category":"移动","seq":6,"text":"再贵重的生命，也终将化为尘埃。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063426A8676FC1000183130353634383135.mp3"},{"id":"065936A8676FC1000183335383832383633","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-7","category":"移动","seq":7,"text":"果然还是轰掉这里好了。谁反对？你反对？","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/065936A8676FC1000183335383832383633.mp3"},{"id":"063516A8676FC1000183132343536313235","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"移动语音-8","category":"移动","seq":8,"text":"别小瞧那些一无所有的人，他们都无所畏惧。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063516A8676FC1000183132343536313235.mp3"},{"id":"068786A8677011000183133333435323930","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音（双杀）","category":"击杀","seq":null,"text":"一击两命。","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/068786A8677011000183133333435323930.mp3"},{"id":"062836A8677011000183331383534313032","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音（三杀）","category":"击杀","seq":null,"text":"烈火无情。","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/062836A8677011000183331383534313032.mp3"},{"id":"069456A8677011000183738363030303638","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音（五杀）","category":"击杀","seq":null,"text":"才刚开始呢！","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/069456A8677011000183738363030303638.mp3"},{"id":"068096A8677011000183137323534383435","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀语音（四杀）","category":"击杀","seq":null,"text":"蛇的獠牙，比刀更锋利。","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/068096A8677011000183137323534383435.mp3"},{"id":"062296A8676F91000183939383836333636","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"相遇语音（友方-卢雅那|莱西奥）-S1_L1","category":"相遇","seq":null,"text":"海都的人怎么喜欢取一样的外号，那破地就火鹰一种鸟吗？","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/062296A8676F91000183939383836333636.mp3"},{"id":"060936A8676F61000183633343139323933","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"相遇语音（友方-卢雅那|米莱狄）-S1_L1","category":"相遇","seq":null,"text":"听说高棚区那群外来的，在海都时就很嚣张。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/060936A8676F61000183633343139323933.mp3"},{"id":"060406A8676F71000183231343433333633","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"相遇语音（友方-卢雅那|米莱狄）-S2_L2","category":"相遇","seq":null,"text":"也记得想想，正式见面时需要准备的价码。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/060406A8676F71000183231343433333633.mp3"},{"id":"063916A8676F81000183733373632333638","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"相遇语音（友方-卢雅那|马可波罗）-S2_L2","category":"相遇","seq":null,"text":"不用等太久，我就会让它们重新生长。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/063916A8676F81000183733373632333638.mp3"},{"id":"065076A8676F71000183134303530393234","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"相遇语音（友方-卢雅那|马可波罗）-S1_L1","category":"相遇","seq":null,"text":"有趣。你这个外来的，没有博伊塔塔讨厌的气息。","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/065076A8676F71000183134303530393234.mp3"},{"id":"068146A8676F51000183331343739313937","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"回城语音-低血量","category":"回城","seq":null,"text":"放心，没死。","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/068146A8676F51000183331343739313937.mp3"},{"id":"064176A8676F51000183936323936383139","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀野怪语音-蓝buff","category":"击杀","seq":null,"text":"我的耐心不多了。","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/064176A8676F51000183936323936383139.mp3"},{"id":"064156A8676F51000183236353830393738","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"击杀野怪语音-红buff","category":"击杀","seq":null,"text":"来给这把火添添料。","hasText":true,"duration":2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/064156A8676F51000183236353830393738.mp3"},{"id":"067096A8676F61000183136303635373332","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"MVP语音-失败","category":"MVP","seq":null,"text":"这个结果，可没完。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/067096A8676F61000183136303635373332.mp3"},{"id":"060566A8676F61000183137363434333833","heroId":"1774","skinId":"1775","skinName":"蛇焰使者","title":"MVP语音-胜利","category":"MVP","seq":null,"text":"一点小教训。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1774/060566A8676F61000183137363434333833.mp3"}]
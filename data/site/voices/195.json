93232343133.mp3"},{"id":"0608867E644081000183134323633363138","heroId":"195","skinId":"1468","skinName":"鸭鸭历险记","title":"移动喊话1","category":"移动","seq":null,"text":"（嘿嘿）最有趣的人，才能收到B.Duck小黄鸭的邀请~","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0608867E644081000183134323633363138.mp3"},{"id":"0662867E644071000183637313837393430","heroId":"195","skinId":"1468","skinName":"鸭鸭历险记","title":"大厅喊话2","category":"大厅","seq":null,"text":"车到山前必有路，开到哪路是哪路！","hasText":true,"duration":12.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0662867E644071000183637313837393430.mp3"},{"id":"0640969F098F21000183231363439353335","heroId":"195","skinId":"1744","skinName":"超级夜猫侠","title":"技能语音3_01","category":"技能","seq":1,"text":"这就是江湖！","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0640969F098F21000183231363439353335.mp3"},{"id":"0671169F098F11000183136393639313934","heroId":"195","skinId":"1744","skinName":"超级夜猫侠","title":"技能语音2_01","category":"技能","seq":1,"text":"好东西！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0671169F098F11000183136393639313934.mp3"},{"id":"0608069F098F11000183734343837363938","heroId":"195","skinId":"1744","skinName":"超级夜猫侠","title":"技能语音1_01","category":"技能","seq":1,"text":"站住，劫富济贫！","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0608069F098F11000183734343837363938.mp3"},{"id":"0678769F098F21000183333313032343139","heroId":"195","skinId":"1744","skinName":"超级夜猫侠","title":"技能语音3_02","category":"技能","seq":2,"text":"身兼多职，游刃有余~","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0678769F098F21000183333313032343139.mp3"},{"id":"0638269F098F21000183830343332363038","heroId":"195","skinId":"1744","skinName":"超级夜猫侠","title":"技能语音2_02","category":"技能","seq":2,"text":"宝贝拿来！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/195/0638269F098F21000183830343332363038.mp3"},{
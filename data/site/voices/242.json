百相守梦","title":"张飞_百相守梦_技能语音1_04","category":"技能","seq":4,"text":"休要猖狂","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06089648BEA8A1000183231373430363930.mp3"},{"id":"06530695F2F631000183136313936353035","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇-吕布（敌方）","category":"相遇","seq":null,"text":"张飞：每一只梦兽都是与我心意相通的战友，你不会懂！","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06530695F2F631000183136313936353035.mp3"},{"id":"06424695F2F621000183136393135373838","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇-吕布（敌方）","category":"相遇","seq":null,"text":"张飞：别得意，击败你只需要派出我的梦兽！","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06424695F2F621000183136393135373838.mp3"},{"id":"06005688B1CCA1000183132303832323838","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇友-黄忠2","category":"相遇","seq":null,"text":"张飞：我的梦兽说，它闻到了一种倒胃口的味道——魇兽就在前面。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06005688B1CCA1000183132303832323838.mp3"},{"id":"06338688B1CCA1000183939373333353633","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇友-黄忠1","category":"相遇","seq":null,"text":"张飞：守梦司早晚会实现这个美好愿望，这还是前辈你教我的。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06338688B1CCA1000183939373333353633.mp3"},{"id":"064796864D0041000183736353130363439","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇语音-周瑜","category":"相遇","seq":null,"text":"张飞：来了桃源街就是朋友，既是朋友，自然要好酒好菜招待。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/064796864D0041000183736353130363439.mp3"},{"id":"060286864D0031000183134303935353030","heroId":"242","skinId":"887","skinName":"百相守梦","title":"相遇语音-周瑜","category":"相遇","seq":null,"text":"张飞：给——梦兽说，这是它们跑遍了百相城，标注出的最佳作战线路。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/060286864D0031000183134303935353030.mp3"},{"id":"06081648BEA8D1000183237313636343339","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_个性动作","category":"动作","seq":null,"text":"节庆之时，俺偶尔也客串一下鼓手","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06081648BEA8D1000183237313636343339.mp3"},{"id":"06090648BEA8D1000183132313338313639","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_待机","category":"待机","seq":null,"text":"淘气的梦兽，总喜欢藏在城市的各个角落","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06090648BEA8D1000183132313338313639.mp3"},{"id":"06805648BEA8C1000183133333430323434","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_出生","category":"台词","seq":null,"text":"桃源不在远方，就在身边","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06805648BEA8C1000183133333430323434.mp3"},{"id":"06963648BEA8C1000183135333536383832","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_回城","category":"回城","seq":null,"text":"一日为兄弟，终生为兄弟","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06963648BEA8C1000183135333536383832.mp3"},{"id":"06520648BEA8C1000183131373234343137","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_回城","category":"回城","seq":null,"text":"大哥答应了，你可以暂时住后院","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06520648BEA8C1000183131373234343137.mp3"},{"id":"06631648BEA8C1000183233323236343434","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_重生","category":"复活","seq":null,"text":"笔力点透眉心，神面绘制于身","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06631648BEA8C1000183233323236343434.mp3"},{"id":"06506648BEA8A1000183236353932363930","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_击杀语音","category":"击杀","seq":null,"text":"我制住你了","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06506648BEA8A1000183236353932363930.mp3"},{"id":"06319648BEA891000183332393633303736","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_挑衅","category":"挑衅","seq":null,"text":"男儿不为热血而战，反畏畏不前，是何男儿","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06319648BEA891000183332393633303736.mp3"},{"id":"06814648BEA891000183137373339323735","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_击杀语音","category":"击杀","seq":null,"text":"小家伙们，别四处捣乱","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06814648BEA891000183137373339323735.mp3"},{"id":"06256648BEA851000183136333231343732","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_死亡语音","category":"死亡","seq":null,"text":"这些梦兽，太调皮了","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06256648BEA851000183136333231343732.mp3"},{"id":"06220648BEA851000183135313936343030","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_死亡语音","category":"死亡","seq":null,"text":"歇一下...再来","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06220648BEA851000183135313936343030.mp3"},{"id":"06699648BEA841000183135343033393432","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音11","category":"移动","seq":null,"text":"危难当头，唤我名字便是","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06699648BEA841000183135343033393432.mp3"},{"id":"06756648BEA841000183137393536303838","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音9","category":"移动","seq":null,"text":"欺负我哥哥，就是欺负我","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06756648BEA841000183137393536303838.mp3"},{"id":"06869648BEA841000183137363337393335","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音7","category":"移动","seq":null,"text":"梦里的百兽之王，进入人间，却变成了一只张牙舞爪的小猫咪","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06869648BEA841000183137363337393335.mp3"},{"id":"06279648BEA841000183130363736383831","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音5","category":"移动","seq":null,"text":"有大哥在，一切就不用操心","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06279648BEA841000183130363736383831.mp3"},{"id":"06107648BEA841000183434393534313736","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音10","category":"移动","seq":null,"text":"守护梦兽与人的和平，就是守梦人","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06107648BEA841000183434393534313736.mp3"},{"id":"06041648BEA841000183135303034313831","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音6","category":"移动","seq":null,"text":"二哥说了，打不过就找他","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06041648BEA841000183135303034313831.mp3"},{"id":"06162648BEA831000183134373932303531","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音1","category":"移动","seq":null,"text":"让我来看看，又有哪只迷糊的梦兽跑到人间了","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06162648BEA831000183134373932303531.mp3"},{"id":"06946648BEA831000183433343037353932","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音3","category":"移动","seq":null,"text":"梦兽易受负面情绪侵染，性情巨变","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06946648BEA831000183433343037353932.mp3"},{"id":"06221648BEA831000183132373634303538","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_大厅语音3","category":"大厅","seq":null,"text":"鼓声震慑的，不仅是梦兽，还有昏聩的心","hasText":true,"duration":14.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06221648BEA831000183132373634303538.mp3"},{"id":"06691648BEA831000183534313336373034","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音4","category":"移动","seq":null,"text":"小时候，因为能看到梦兽，他们都叫我怪物","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06691648BEA831000183534313336373034.mp3"},{"id":"06999648BEA831000183933373234323639","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_移动语音2","category":"移动","seq":null,"text":"人面相似，人心却不同，兽面各异，兽心却都类似","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06999648BEA831000183933373234323639.mp3"},{"id":"06107648BEA821000183132353334323732","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_大厅语音2","category":"大厅","seq":null,"text":"怪物，会亮出獠牙，却也有温暖的胸膛","hasText":true,"duration":14.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06107648BEA821000183132353334323732.mp3"},{"id":"06335648BEA821000183430353737323339","heroId":"242","skinId":"887","skinName":"百相守梦","title":"张飞_百相守梦_大厅语音1","category":"大厅","seq":null,"text":"兄长即让我做灵兽官，我就会好好看管那些误入人间的梦兽","hasText":true,"duration":15.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/06335648BEA821000183430353737323339.mp3"}]
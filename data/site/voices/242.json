2/0673767F8D31D1000183130323031303533.mp3"},{"id":"0698267F8D31C1000183933373438333131","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"击杀喊话","category":"击杀","seq":null,"text":"擅闯他人领地的后果！","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0698267F8D31C1000183933373438333131.mp3"},{"id":"0684167F8D31D1000183539363236323433","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"回城语音","category":"回城","seq":null,"text":"锁定！飞扑！练习的不错！","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0684167F8D31D1000183539363236323433.mp3"},{"id":"0612067F8D31D1000183730393431303939","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"个性动作","category":"动作","seq":null,"text":"捣蛋鬼...看我的！","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0612067F8D31D1000183730393431303939.mp3"},{"id":"0638667F8D31B1000183131353830393139","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话9","category":"移动","seq":null,"text":"捕猎的秘诀就是…慢一点…再慢一点…然后突然加速！","hasText":true,"duration":8.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0638667F8D31B1000183131353830393139.mp3"},{"id":"0659667F8D31B1000183835373431343338","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话7","category":"移动","seq":null,"text":"风雪再大，也不曾掩盖心中的故乡","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0659667F8D31B1000183835373431343338.mp3"},{"id":"0666867F8D31A1000183635393030333438","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话5","category":"移动","seq":null,"text":"即便是打雪仗也要拿出以一敌百的气势来！","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0666867F8D31A1000183635393030333438.mp3"},{"id":"0656667F8D31B1000183135363138303234","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话8","category":"移动","seq":null,"text":"玩耍时别遛太远，那群偷猎的家伙可不会心慈手软","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0656667F8D31B1000183135363138303234.mp3"},{"id":"0675267F8D31A1000183135303637313833","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话4","category":"移动","seq":null,"text":"猎物不会自己撞上来，所以再冻脚的天气也要学着主动出击","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0675267F8D31A1000183135303637313833.mp3"},{"id":"0697667F8D31A1000183131303935383937","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话3","category":"移动","seq":null,"text":"外形不过伪装，勇猛才是真相！喵！\n小兔狲们鼓足劲儿：“喵~~”","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0697667F8D31A1000183131303935383937.mp3"},{"id":"0682667F8D31B1000183539323939313030","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话6","category":"移动","seq":null,"text":"难道没人告诉你，野外的石缝里偶尔也会“长出”猫科动物吗？","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0682667F8D31B1000183539323939313030.mp3"},{"id":"0676267F8D3191000183130363030333832","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话2","category":"移动","seq":null,"text":"遇到任何危险都可以喊我的名字，但和隔壁的小藏狐们打架除外","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0676267F8D3191000183130363030333832.mp3"},{"id":"0638167F8D3191000183136373332363132","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"移动喊话1","category":"移动","seq":null,"text":"御寒，只是尾巴的用法之一~","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0638167F8D3191000183136373332363132.mp3"},{"id":"0679767F8D3191000183136303133353431","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"大厅出现3","category":"大厅","seq":null,"text":"我们和群山一体，与自然共息","hasText":true,"duration":23.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/242/0679767F8D3191000183136303133353431.mp3"},{"id":"0646667F8D3181000183335373834303735","heroId":"242","skinId":"1479","skinName":"兔狲·蓬尾","title":"大厅出现1","category":"大厅","seq":null,"text":"传说中可令高原安宁祥和的神明啊——正是生于此地的我们"
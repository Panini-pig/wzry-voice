n":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/068486645D3AD1000183934393139393536.mp3"},{"id":"062006645D3AC1000183239353738353739","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"移动喊话3","category":"移动","seq":null,"text":"谁歪歪扭扭的字迹，宣告故事开场。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062006645D3AC1000183239353738353739.mp3"},{"id":"065836645D3AC1000183130363833313333","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"移动喊话2","category":"移动","seq":null,"text":"有位读者，又弄混了图书的编号。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/065836645D3AC1000183130363833313333.mp3"},{"id":"063816645D3AB1000183935313830393830","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"移动喊话1","category":"移动","seq":null,"text":"书架三排第四列，藏着无人知晓的暗语。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/063816645D3AB1000183935313830393830.mp3"},{"id":"061746645D3AB1000183130333934363335","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"大厅出现3","category":"大厅","seq":null,"text":"小船在夜空漂流……等一场夏日的焰火。","hasText":true,"duration":15.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/061746645D3AB1000183130333934363335.mp3"},{"id":"062386645D3AC1000183130363531363039","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"移动喊话4","category":"移动","seq":null,"text":"一只翅膀的纸鹤……也很好。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062386645D3AC1000183130363531363039.mp3"},{"id":"063566645D3AA1000183134313536373434","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"大厅出现1","category":"大厅","seq":null,"text":"我有一个不曾会面的笔友……喜欢把稿纸折成小船的形状。","hasText":true,"duration":9.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/063566645D3AA1000183134313536373434.mp3"},{"id":"062756645D3AB1000183132343538383532","heroId":"1054","skinId":"1242","skinName":"心动手记","title":"大厅出现2","category":"大厅","seq":null,"text":"《我的故事》~读者有你，作者也有你。","hasText":true,"duration":18.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062756645D3AB1000183132343538383532.mp3"},{"id":"061396AB0E2791000183135373534393139","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（B）-1","category":"技能","seq":1,"text":"去见证。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/061396AB0E2791000183135373534393139.mp3"},{"id":"069686AB0E27A1000183531353233373931","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（C）-1","category":"技能","seq":1,"text":"于不可能中，开创奇迹。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/069686AB0E27A1000183531353233373931.mp3"},{"id":"065546AB0E27A1000183131373331303830","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"挑衅语音-1","category":"挑衅","seq":1,"text":"凡自弃者，皆止步于此。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/065546AB0E27A1000183131373331303830.mp3"},{"id":"060516AB0E2781000183337373331303630","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（A远程）-1","category":"技能","seq":1,"text":"纷争止步。","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/060516AB0E2781000183337373331303630.mp3"},{"id":"064426AB0E2781000183133383731303034","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（A近战）-1","category":"技能","seq":1,"text":"星佑","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/064426AB0E2781000183133383731303034.mp3"},{"id":"062236AB0E2751000183932363636393831","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"个性动作语音-1","category":"动作","seq":1,"text":"母神赐我圣骑士之名，令我守望人间。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062236AB0E2751000183932363636393831.mp3"},{"id":"066466AB0E2751000183137363933323530","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"击杀语音-1","category":"击杀","seq":1,"text":"你挡不住黎明。","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/066466AB0E2751000183137363933323530.mp3"},{"id":"063756AB0E2761000183333393233363639","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-1","category":"移动","seq":1,"text":"大地为证，星芒为誓，圣骑士当永护和平。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/063756AB0E2761000183333393233363639.mp3"},{"id":"061486AB0E2751000183735343437373239","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"死亡语音-1","category":"死亡","seq":1,"text":"愿星光长明、和平永续……","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/061486AB0E2751000183735343437373239.mp3"},{"id":"069976AB0E2741000183130373531353838","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"大厅语音-1","category":"大厅","seq":1,"text":"永夜中，我以长枪宣告，人类永不言败。","hasText":true,"duration":12.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/069976AB0E2741000183130373531353838.mp3"},{"id":"064026AB0E2791000183133323730333034","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（A近战）-2","category":"技能","seq":2,"text":"圣裁","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/064026AB0E2791000183133323730333034.mp3"},{"id":"060456AB0E2791000183536313435393431","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（B）-2","category":"技能","seq":2,"text":"去超越。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/060456AB0E2791000183536313435393431.mp3"},{"id":"066616AB0E27A1000183135323031383439","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（C）-2","category":"技能","seq":2,"text":"信念未灭，绝境非终。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/066616AB0E27A1000183135323031383439.mp3"},{"id":"062166AB0E2781000183134383839363639","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（A远程）-2","category":"技能","seq":2,"text":"终结永夜。","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062166AB0E2781000183134383839363639.mp3"},{"id":"062116AB0E2761000183138303635383339","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-2","category":"移动","seq":2,"text":"胜利，有时来自于最轻巧的一击。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/062116AB0E2761000183138303635383339.mp3"},{"id":"069306AB0E2741000183431353431373535","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"大厅语音-2","category":"大厅","seq":2,"text":"在最瞩目的赛场，让世界看见我和我们。","hasText":true,"duration":10.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/069306AB0E2741000183431353431373535.mp3"},{"id":"065456AB0E27A1000183832323238373036","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"技能语音（C）-3","category":"技能","seq":3,"text":"尽情欣赏吧，这最后一击。","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/065456AB0E27A1000183832323238373036.mp3"},{"id":"063716AB0E2761000183937303532353436","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-3","category":"移动","seq":3,"text":"于有限的边缘，抵达人类的无限。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/063716AB0E2761000183937303532353436.mp3"},{"id":"068746AB0E2751000183230313234363539","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"大厅语音-3","category":"大厅","seq":3,"text":"纷争止于赛场、荣耀生于此刻。","hasText":true,"duration":10.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/068746AB0E2751000183230313234363539.mp3"},{"id":"069156AB0E2771000183132303835343834","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-4","category":"移动","seq":4,"text":"战胜质疑、跨过仇恨、超越输赢。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/069156AB0E2771000183132303835343834.mp3"},{"id":"061076AB0E2771000183135303537393931","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-5","category":"移动","seq":5,"text":"在诸神消隐的时代，人类以团结照亮前路。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/061076AB0E2771000183135303537393931.mp3"},{"id":"069206AB0E2771000183530363231363334","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-6","category":"移动","seq":6,"text":"我见过城邦因争斗沉默，也见过世人因喝彩相拥。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/069206AB0E2771000183530363231363334.mp3"},{"id":"068746AB0E2771000183133383635353430","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-7","category":"移动","seq":7,"text":"星芒一程程传递，和平与希望便一代代延续。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/068746AB0E2771000183133383635353430.mp3"},{"id":"061166AB0E2781000183338303939383836","heroId":"1054","skinId":"1789","skinName":"星光竞辉","title":"移动语音-8","category":"移动","seq":8,"text":"我们建起赛场，不为划分敌我，只为彼此靠近。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1054/061166AB0E2781000183338303939383836.mp3"}]
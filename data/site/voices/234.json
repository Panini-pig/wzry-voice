io.wzry.panini-pigs.cn/audio/234/06583648BEE561000183131303938393138.mp3"},{"id":"06130648BEE561000183132323833393535","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_移动语音8","category":"移动","seq":null,"text":"世事频更替，寻觅终有重逢时","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06130648BEE561000183132323833393535.mp3"},{"id":"06009648BEE551000183137373136393130","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_大厅语音3","category":"大厅","seq":null,"text":"夜叩门扉无需惧，吾等所求，唯有寻回真心","hasText":true,"duration":16.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06009648BEE551000183137373136393130.mp3"},{"id":"06470648BEE551000183739353834313133","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_大厅语音2","category":"大厅","seq":null,"text":"世人以物寄凡情，长此生妖影，今宵逐月行","hasText":true,"duration":21.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06470648BEE551000183739353834313133.mp3"},{"id":"06756648BEE551000183135303031313735","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_移动语音2","category":"移动","seq":null,"text":"人貌似而心不同，妖各异却各相知","hasText":true,"duration":7,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06756648BEE551000183135303031313735.mp3"},{"id":"06419648BEE551000183531333130333132","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_大厅语音1","category":"大厅","seq":null,"text":"红月正当空，凡尘千年寻故友，百妖俱相从","hasText":true,"duration":16.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06419648BEE551000183531333130333132.mp3"},{"id":"06981648BEE551000183634353837363235","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行_移动语音1","category":"移动","seq":null,"text":"凡世七情六欲，化妖之百态千姿","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/06981648BEE551000183634353837363235.mp3"},{"id":"065416478696E1000183135343736313333","heroId":"234","skinId":"641","skinName":"绯月行","title":"不知火舞_绯月行","category":"台词","seq":null,"text":"不知火舞_绯月行","hasText":false,"duration":185.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/234/065416478696E1000183135343736313333.mp3"}]
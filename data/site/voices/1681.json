83936323037313932.mp3"},{"id":"06320695F205A1000183131363934323732","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"技能1-治疗","category":"技能","seq":null,"text":"家园就在身后。","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06320695F205A1000183131363934323732.mp3"},{"id":"06896695F20591000183433323539383932","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"idle待机2","category":"待机","seq":null,"text":"往昔峥嵘岁月，唯余下崇山间不灭的星火。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06896695F20591000183433323539383932.mp3"},{"id":"06129695F20591000183136373639343235","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"idle待机1","category":"待机","seq":null,"text":"故人青山埋冢，人间几度星霜。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06129695F20591000183136373639343235.mp3"},{"id":"06107695F20581000183137313936363439","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"挑衅2","category":"挑衅","seq":null,"text":"小小浪花，还能掀起什么波澜？","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06107695F20581000183137313936363439.mp3"},{"id":"06905695F205A1000183838363034343139","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"技能语音1","category":"技能","seq":null,"text":"越千山。","hasText":true,"duration":0.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06905695F205A1000183838363034343139.mp3"},{"id":"06386695F205A1000183835313639383335","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"技能1-治疗","category":"技能","seq":null,"text":"我们始终都在。","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06386695F205A1000183835313639383335.mp3"},{"id":"06355695F205A1000183235393632383237","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"技能语音1","category":"技能","seq":null,"text":"铄金为誓。","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06355695F205A1000183235393632383237.mp3"},{"id":"06899695F20591000183134363739393133","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"技能语音1","category":"技能","seq":null,"text":"脩戎戈。","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06899695F20591000183134363739393133.mp3"},{"id":"06962695F20581000183837343535333239","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"击杀语音1","category":"击杀","seq":null,"text":"这样，就畅通无碍了。","hasText":true,"duration":2.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06962695F20581000183837343535333239.mp3"},{"id":"06317695F20581000183133313832343937","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"击杀语音2","category":"击杀","seq":null,"text":"逆乱者，见诛于此！","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06317695F20581000183133313832343937.mp3"},{"id":"06929695F20581000183337353337343336","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"挑衅1","category":"挑衅","seq":null,"text":"战场险恶，回去再磨砺一番吧。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06929695F20581000183337353337343336.mp3"},{"id":"06438695F20571000183630303133373731","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"死亡语音1","category":"死亡","seq":null,"text":"向前走，别回头……","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06438695F20571000183630303133373731.mp3"},{"id":"06353695F20571000183132303933313633","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音8","category":"移动","seq":null,"text":"鼎之所铸，非金非铁；鼎之所命，非王非神。","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06353695F20571000183132303933313633.mp3"},{"id":"06966695F20571000183132323931393230","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"死亡语音2","category":"死亡","seq":null,"text":"别怕，大禹（雨）过后……总会天晴……","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06966695F20571000183132323931393230.mp3"},{"id":"06932695F20571000183136303637363935","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音9","category":"移动","seq":null,"text":"蝴蝶吃胖了会变成什么?\n会变成……发福蝶！哈哈哈哈……\n不好笑吗？","hasText":true,"duration":10.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06932695F20571000183136303637363935.mp3"},{"id":"06174695F20551000183437393830323332","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音3","category":"移动","seq":null,"text":"搞砸了也没关系，从头再来就是了~","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06174695F20551000183437393830323332.mp3"},{"id":"06241695F20561000183131393736313931","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音6","category":"移动","seq":null,"text":"害怕的话，就站在我身后吧。","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06241695F20561000183131393736313931.mp3"},{"id":"06567695F20561000183330393636333431","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音5","category":"移动","seq":null,"text":"总有人得走在最前方，好在我的骨头依旧硬朗！","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06567695F20561000183330393636333431.mp3"},{"id":"06945695F20551000183130363333393238","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音1","category":"移动","seq":null,"text":"灾难当前，那我们就战胜灾难！","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06945695F20551000183130363333393238.mp3"},{"id":"06062695F20551000183532313030313731","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音2","category":"移动","seq":null,"text":"何须逃离怒海？九鼎所到之处，自有新的河道铺开。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06062695F20551000183532313030313731.mp3"},{"id":"06113695F20561000183435343035323932","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音4","category":"移动","seq":null,"text":"我们疏通的不止紊流，还有归山一族绵延万世的生路。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06113695F20561000183435343035323932.mp3"},{"id":"06813695F20561000183135393831343733","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"移动语音7","category":"移动","seq":null,"text":"攀岳登天，平治紊流，非禹一人之功。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06813695F20561000183135393831343733.mp3"},{"id":"06890695F20541000183334373134313837","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"大厅语音3","category":"大厅","seq":null,"text":"辟山河乾坤，肇万世太平！","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06890695F20541000183334373134313837.mp3"},{"id":"06535695F20541000183135303937383838","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"大厅语音2","category":"大厅","seq":null,"text":"昊天失命，九鼎是征！","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06535695F20541000183135303937383838.mp3"},{"id":"06288695F20541000183132393331373138","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"大厅语音1","category":"大厅","seq":null,"text":"山海镇伏，前路昭彰！","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06288695F20541000183132393331373138.mp3"}]
[{"id":"06623695F20681000183134343937383538","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"盘古友1","category":"台词","seq":null,"text":"大禹：昔年紊流从天而降，破晓圣山为建木撑起了第一道防线。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06623695F20681000183134343937383538.mp3"},{"id":"06178695F20691000183436313137303231","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"盘古友5","category":"台词","seq":null,"text":"大禹：千万人的呼声，比紊流更震耳欲聋……有时我也会害怕，若我引众人治水一生，终点仍是一片汪洋……","hasText":true,"duration":15.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06178695F20691000183436313137303231.mp3"},{"id":"06407695F20691000183135303533373631","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"盘古友3","category":"台词","seq":null,"text":"大禹：一代代归山之民攀越圣山，撕开紊流，他们的名字如星火寂灭，却将自身骨血刻入这条登天之路。","hasText":true,"duration":11.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06407695F20691000183135303533373631.mp3"},{"id":"06758695F20681000183138303333393936","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"姜子牙敌1","category":"台词","seq":null,"text":"大禹：你眼里的“人偶”，已找到“心”的方向。你的心，如今还依旧吗？","hasText":true,"duration":6.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06758695F20681000183138303333393936.mp3"},{"id":"06323695F20681000183930333333383039","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"盘古友2","category":"台词","seq":null,"text":"大禹：千百年过去，最初的“山”始终屹立于此，庇佑归山一族。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06323695F20681000183930333333383039.mp3"},{"id":"06913695F20691000183132303934393139","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"盘古友4","category":"台词","seq":null,"text":"大禹：您的牺牲，从没有白费。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06913695F20691000183132303934393139.mp3"},{"id":"06511695F20661000183131383130363933","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"空空儿友1","category":"台词","seq":null,"text":"大禹：你的戏法很好，但还比不上你妈妈。她一挥手，就能把天上的云捏成活蹦乱跳的小动物。","hasText":true,"duration":10,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06511695F20661000183131383130363933.mp3"},{"id":"06060695F20671000183136373036393730","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"空空儿友2","category":"台词","seq":null,"text":"大禹：雪化成了水，水汇聚成河。河流奔涌向前，从不问自己是否清澈，只问能否滋养一方——你们根本就是一样的人，何来“不像”？","hasText":true,"duration":16.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06060695F20671000183136373036393730.mp3"},{"id":"06428695F20671000183136303032363230","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"老夫子友1","category":"台词","seq":null,"text":"大禹：之前来建木的考古小队，都满载而归了吧？","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06428695F20671000183136303032363230.mp3"},{"id":"06279695F20641000183132363731363135","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"杨戬友1","category":"台词","seq":null,"text":"大禹：哈哈，霜雪霁夜，难得故人相逢，来尝尝新出锅的饺子。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06279695F20641000183132363731363135.mp3"},{"id":"06150695F20651000183633373932353232","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"杨戬友2","category":"台词","seq":null,"text":"大禹：哮天，快吃！别被杨二发现了！","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06150695F20651000183633373932353232.mp3"},{"id":"06912695F20631000183130313630323739","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"哪吒友2","category":"台词","seq":null,"text":"大禹：饺子来喽！喂喂喂，这次你是要“接哮天放学”？还是“给太乙修炉子”？","hasText":true,"duration":8.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06912695F20631000183130313630323739.mp3"},{"id":"06902695F20611000183632393031383932","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"妲己友1","category":"台词","seq":null,"text":"大禹：你在看……《大禹治紊流》？咳咳……这写得也太夸张了！应该说，归山这个家，是我们共同建立起来的。","hasText":true,"duration":12.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06902695F20611000183632393031383932.mp3"},{"id":"06686695F20621000183937383338383434","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"哪吒友1","category":"台词","seq":null,"text":"大禹：你总算来了！那帮小家伙们穿上长安的冬衣，整天闹着要哪吒哥哥来看。","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06686695F20621000183937383338383434.mp3"},{"id":"06526695F20611000183730373739333438","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"太乙友1","category":"台词","seq":null,"text":"大禹：太二，你那新发明对付紊流果然好用！不过，偶尔也给炉子放个假吧，别太辛苦了。","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06526695F20611000183730373739333438.mp3"},{"id":"06772695F205F1000183336353539373531","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"胜方MVP","category":"MVP","seq":null,"text":"此番大胜，为你我共铸！","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06772695F205F1000183336353539373531.mp3"},{"id":"06802695F20601000183739393430363032","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"蚩奼友1","category":"台词","seq":null,"text":"大禹：至少又排除了一个错误选项！下次在我的鼎旁边铸造，因为……指定（鼎）能成！哈哈哈哈……","hasText":true,"duration":11.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06802695F20601000183739393430363032.mp3"},{"id":"06916695F205E1000183130373137363634","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"五杀","category":"击杀","seq":null,"text":"乾坤明赫，四野攸同，隆我归山！","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06916695F205E1000183130373137363634.mp3"},{"id":"06055695F20601000183137303539383237","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"蚩奼友2","category":"台词","seq":null,"text":"大禹：你出门在外太危险了，带上这本我压箱底的《开心手册》吧～","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06055695F20601000183137303539383237.mp3"},{"id":"06142695F205F1000183233373138373931","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"败方MVP","category":"MVP","seq":null,"text":"无需忧愁，与我一同前行吧。","hasText":true,"duration":2.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06142695F205F1000183233373138373931.mp3"},{"id":"06490695F205D1000183130303430353938","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"学习满级1技能","category":"技能","seq":null,"text":"九鼎既成。","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06490695F205D1000183130303430353938.mp3"},{"id":"06306695F205D1000183133353738303132","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"学习大招","category":"技能","seq":null,"text":"未来并非渺远。","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06306695F205D1000183133353738303132.mp3"},{"id":"06719695F205D1000183136323230313931","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"回城","category":"回城","seq":null,"text":"那些无光的暗夜，篝火照亮了家的方向。","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06719695F205D1000183136323230313931.mp3"},{"id":"06498695F205E1000183233343039303236","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"重生","category":"复活","seq":null,"text":"此身终有尽时，但脚下的道路会不断延伸。","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06498695F205E1000183233343039303236.mp3"},{"id":"06084695F205E1000183137333037333637","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"首杀","category":"击杀","seq":null,"text":"波澜未兴，胜负已定。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06084695F205E1000183137333037333637.mp3"},{"id":"06543695F205C1000183231353435373330","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"小鼎传送","category":"台词","seq":null,"text":"万山无阻。","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/1681/06543695F205C1000183231353435373330.mp3"},{"id":"06379695F205E1000183734343939313634","heroId":"1681","skinId":"1682","skinName":"鼎镇山河","title":"低血量回城","category":"回城","seq":null,"text":"竟成了这副狼狈的模样……请帮我保密吧。","hasText":true,"duration":4.8,"audio":"https://aud
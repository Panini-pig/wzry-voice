ry.panini-pigs.cn/audio/113/0693967AB271C1000183739383035323439.mp3"},{"id":"0692367AB271B1000183131303935343535","heroId":"113","skinId":"1451","skinName":"器灵·浮梦炉","title":"大厅出现1","category":"大厅","seq":null,"text":"阴阳交感，万物遂生，随器而蕴，与人偕存。","hasText":true,"duration":17.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/0692367AB271B1000183131303935343535.mp3"},{"id":"0661067AB271D1000183134303138353435","heroId":"113","skinId":"1451","skinName":"器灵·浮梦炉","title":"移动语音2","category":"移动","seq":null,"text":"敛诸天濯濯清气于斗室之间。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/0661067AB271D1000183134303138353435.mp3"},{"id":"0652067AB271C1000183732363338313837","heroId":"113","skinId":"1451","skinName":"器灵·浮梦炉","title":"大厅出现3","category":"大厅","seq":null,"text":"器无堪用处，何日可止我忧心殷殷？","hasText":true,"duration":12.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/0652067AB271C1000183732363338313837.mp3"},{"id":"062066A390F701000183537363031333632","heroId":"113","skinId":"1757","skinName":"逢春序","title":"三技能语音1-1","category":"技能","seq":1,"text":"存希望于人间","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/062066A390F701000183537363031333632.mp3"},{"id":"062106A390F6F1000183931383335333535","heroId":"113","skinId":"1757","skinName":"逢春序","title":"三技能语音1-1","category":"技能","seq":1,"text":"护一方春境","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/062106A390F6F1000183931383335333535.mp3"},{"id":"066236A390F701000183638323137373037","heroId":"113","skinId":"1757","skinName":"逢春序","title":"三技能语音1-2","category":"技能","seq":2,"text":"甘霖至","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/066236A390F701000183638323137373037.mp3"},{"id":"065036A390F701000183539353737343433","heroId":"113","skinId":"1757","skinName":"逢春序","title":"三技能语音1-2","category":"技能","seq":2,"text":"润物细无声","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/065
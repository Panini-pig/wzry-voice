113","skinId":"1757","skinName":"逢春序","title":"死亡","category":"死亡","seq":null,"text":"扎过根的地方，青绿定会归来……","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/069616A390F6C1000183133323238393033.mp3"},{"id":"068216A390F6D1000183737313433363131","heroId":"113","skinId":"1757","skinName":"逢春序","title":"击杀","category":"击杀","seq":null,"text":"枯荣有时，自然之律。","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/068216A390F6D1000183737313433363131.mp3"},{"id":"064456A390F6C1000183537323133313330","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词8","category":"移动","seq":null,"text":"那些枯枝并非死去,只是在静待醒来。","hasText":true,"duration":5.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/064456A390F6C1000183537323133313330.mp3"},{"id":"068926A390F6B1000183934343330383231","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词5","category":"移动","seq":null,"text":"这方仙境很小，但春风无限。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/068926A390F6B1000183934343330383231.mp3"},{"id":"064646A390F6B1000183135343938323633","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词4","category":"移动","seq":null,"text":"把心放轻些，你可听见新叶正悄悄舒展？","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/064646A390F6B1000183135343938323633.mp3"},{"id":"060256A390F6C1000183930343734303431","heroId":"113","skinId":"1757","skinName":"逢春序","title":"出生","category":"台词","seq":null,"text":"仙境难寻，自有心怀执着者，为人间带回四季的传说。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/060256A390F6C1000183930343734303431.mp3"},{"id":"065426A390F6B1000183238363738333938","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词6","category":"移动","seq":null,"text":"草木破土，是一场雨到另一场雨。","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/065426A390F6B1000183238363738333938.mp3"},{"id":"068016A390F6C1000183134313537333935","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词7","category":"移动","seq":null,"text":"慢一点，春天不会跑。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/068016A390F6C1000183134313537333935.mp3"},{"id":"066026A390F6A1000183637323538303939","heroId":"113","skinId":"1757","skinName":"逢春序","title":"大厅出现3","category":"大厅","seq":null,"text":"山火焚尽万物，却焚不尽藏于泥土的生机。","hasText":true,"duration":11.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/066026A390F6A1000183637323538303939.mp3"},{"id":"068256A390F6A1000183234343430323531","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词2","category":"移动","seq":null,"text":"人类真有趣，折的是柳，道不尽的是留。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/068256A390F6A1000183234343430323531.mp3"},{"id":"065136A390F691000183132363835303134","heroId":"113","skinId":"1757","skinName":"逢春序","title":"大厅出现2","category":"大厅","seq":null,"text":"从一片柳叶中窥见新生，从一粒嫩芽里唤醒春日。","hasText":true,"duration":11.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/065136A390F691000183132363835303134.mp3"},{"id":"060296A390F6A1000183136363930303831","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词3","category":"移动","seq":null,"text":"越是深陷绝境，越要相信春光已近。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/060296A390F6A1000183136363930303831.mp3"},{"id":"063226A390F6A1000183736393231343634","heroId":"113","skinId":"1757","skinName":"逢春序","title":"移动台词1","category":"移动","seq":null,"text":"夜调风雨，昼理晴光，愿仍为焦土处早著绿妆。","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/063226A390F6A1000183736393231343634.mp3"},{"id":"060566A390F691000183330393937383634","heroId":"113","skinId":"1757","skinName":"逢春序","title":"大厅出现1","category":"大厅","seq":null,"text":"人生四季，各有其景。花叶之间，别有洞天。","hasText":true,"duration":11.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/060566A390F691000183330393937383634.mp3"},{"id":"06328648BE6991000183136383034353739","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3-1","category":"技能","seq":1,"text":"气随心动，变化万千","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06328648BE6991000183136383034353739.mp3"},{"id":"06619648BE6981000183136383933363033","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2-1","category":"技能","seq":1,"text":"观心","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06619648BE6981000183136383933363033.mp3"},{"id":"06873648BE6971000183137323330383939","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音1-1","category":"技能","seq":1,"text":"云气来","hasText":true,"duration":1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06873648BE6971000183137323330383939.mp3"},{"id":"06160648BE6991000183130383033363935","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3-2","category":"技能","seq":2,"text":"一气之变，所适万形","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06160648BE6991000183130383033363935.mp3"},{"id":"06878648BE6981000183436373935373436","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2-2","category":"技能","seq":2,"text":"以静制动","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06878648BE6981000183436373935373436.mp3"},{"id":"06374648BE6971000183835383139363139","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音1-2","category":"技能","seq":2,"text":"秋风扫落叶","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06374648BE6971000183835383139363139.mp3"},{"id":"06488648BE69A1000183533373439363639","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3-3","category":"技能","seq":3,"text":"天地合气，万物自生","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06488648BE69A1000183533373439363639.mp3"},{"id":"06542648BE6981000183137363435373235","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2-3","category":"技能","seq":3,"text":"心如止水","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06542648BE6981000183137363435373235.mp3"},{"id":"06275648BE6971000183537363235323336","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音1-3","category":"技能","seq":3,"text":"拨云见明","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06275648BE6971000183537363235323336.mp3"},{"id":"06118648BE6981000183135333931313735","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2-4","category":"技能","seq":4,"text":"虚怀若谷","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06118648BE6981000183135333931313735.mp3"},{"id":"06220648BE6971000183136353639363034","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音1-4","category":"技能","seq":4,"text":"折转","hasText":true,"duration":0.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06220648BE6971000183136353639363034.mp3"},{"id":"066426AB32DB71000183633373730343538","heroId":"113","skinId":"790","skinName":"自在之心","title":"相遇语音（友方-王维|赵怀真）-S1_L2","category":"相遇","seq":null,"text":"……学生尝过了，都是五仁的……","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/066426AB32DB71000183633373730343538.mp3"},{"id":"06652692952B31000183936303734383637","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真-拾年声藏贺文","category":"台词","seq":null,"text":"小友近来可好？\n玄都观里的晨曦，比之长安，的确少了几分烟火气。\n不必替怀真难过，人生如寄，遗憾或圆满皆是修行。\n继续往前去游历山河吧，会有清风明月与你同行。\n倘若遇到趣事，亦可来信分享与我。","hasText":true,"duration":27.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06652692952B31000183936303734383637.mp3"},{"id":"06212648BEF1B1000183437323133343630","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_五杀","category":"击杀","seq":null,"text":"阴阳中和，归太极一气。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06212648BEF1B1000183437323133343630.mp3"},{"id":"06956648BEF1B1000183135333738343338","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_双杀","category":"击杀","seq":null,"text":"无形无相，虚静无为。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06956648BEF1B1000183135333738343338.mp3"},{"id":"06573648BE69F1000183332303035393736","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“魔女斗篷”","category":"台词","seq":null,"text":"人间一角，聊我暂存，无须满城云霞。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06573648BE69F1000183332303035393736.mp3"},{"id":"06024648BE69F1000183133353731333536","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“不死鸟”","category":"台词","seq":null,"text":"生死无定论，万事缘有道。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06024648BE69F1000183133353731333536.mp3"},{"id":"06339648BE69F1000183133313235343033","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“学者宝石”","category":"台词","seq":null,"text":"知易行难。","hasText":true,"duration":1.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06339648BE69F1000183133313235343033.mp3"},{"id":"06785648BE69F1000183734393938303031","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“不祥征兆”","category":"台词","seq":null,"text":"生死间，有大恐怖，就算看不透，又有什么办法。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06785648BE69F1000183734393938303031.mp3"},{"id":"06468648BE69F1000183131363634313035","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“反甲”","category":"台词","seq":null,"text":"孤独者，自省，热闹者，自迷。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06468648BE69F1000183131363634313035.mp3"},{"id":"06911648BE69F1000183138303238343333","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_拿到一血","category":"台词","seq":null,"text":"守我之静，待人之动。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06911648BE69F1000183138303238343333.mp3"},{"id":"06556648BE69E1000183135333839343733","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“宗师之力”","category":"台词","seq":null,"text":"人非圣贤，孰能无过，掸落尘埃，继续向前。","hasText":true,"duration":7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06556648BE69E1000183135333839343733.mp3"},{"id":"06709648BE69E1000183131363433303934","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“复活甲”","category":"复活","seq":null,"text":"万物得一以生（选自《道德经》第三十九章）","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06709648BE69E1000183131363433303934.mp3"},{"id":"06972648BE69E1000183132363939393730","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“血魔之怒”","category":"台词","seq":null,"text":"每个人都有自己的底线，温和是休养，不是没有原则。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06972648BE69E1000183132363939393730.mp3"},{"id":"06802648BE69E1000183133353134363536","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“极寒风暴”","category":"台词","seq":null,"text":"人生如雪中赶路，总要回头，才觉其美。","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06802648BE69E1000183133353134363536.mp3"},{"id":"06298648BE69E1000183235383237373235","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“永夜守护”","category":"台词","seq":null,"text":"终日活在情绪的高阁，不如脚踏实地，触摸生活。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06298648BE69E1000183235383237373235.mp3"},{"id":"06101648BE69D1000183135333835363135","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过对抗路草丛","category":"台词","seq":null,"text":"独对一方草木，更见光阴多情。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06101648BE69D1000183135333835363135.mp3"},{"id":"06220648BE69D1000183736353430393335","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“冰痕之握”","category":"台词","seq":null,"text":"心中介怀，盈满于胸，若无开解，便常成执念。","hasText":true,"duration":7.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06220648BE69D1000183736353430393335.mp3"},{"id":"06013648BE69D1000183134373732323135","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“抵抗靴”","category":"台词","seq":null,"text":"明月清风，纵情山水，徒自羡矣。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06013648BE69D1000183134373732323135.mp3"},{"id":"06930648BE69D1000183533323136383532","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过发育路草丛","category":"台词","seq":null,"text":"肩上担清风，眉间无愁云。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06930648BE69D1000183533323136383532.mp3"},{"id":"06151648BE69D1000183437353930363035","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“巨人之握”","category":"台词","seq":null,"text":"清闲愈久，愈觉心中清明。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06151648BE69D1000183437353930363035.mp3"},{"id":"06014648BE69D1000183935333239373937","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_购买“暗影战斧”","category":"台词","seq":null,"text":"生命就是人身上的光。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06014648BE69D1000183935333239373937.mp3"},{"id":"06648648BE69C1000183836303538383832","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过我方红区","category":"台词","seq":null,"text":"以前我总想学父亲，看遍天下，走遍天下。","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06648648BE69C1000183836303538383832.mp3"},{"id":"06540648BE69C1000183131343038343832","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过河道","category":"台词","seq":null,"text":"回首看来路，山河忽已秋。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06540648BE69C1000183131343038343832.mp3"},{"id":"06148648BE69C1000183133343235323137","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过敌方蓝区","category":"台词","seq":null,"text":"夜来风雨，花落无算，竹笛清风，碧草横天。","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06148648BE69C1000183133343235323137.mp3"},{"id":"06872648BE69C1000183635343537353336","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过敌方红区","category":"台词","seq":null,"text":"家，对于我来说，就是天边月，越来越可望不可即。","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06872648BE69C1000183635343537353336.mp3"},{"id":"06213648BE69C1000183136363330373235","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_路过我方蓝区","category":"台词","seq":null,"text":"无事此静坐，一日似两日。（选自苏轼《司命宫杨道士息轩》）","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06213648BE69C1000183136363330373235.mp3"},{"id":"06982648BE69B1000183833373030393837","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_闲置-待机1","category":"待机","seq":null,"text":"静坐竹林白石，只觉漫天山色，皆来相就。","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06982648BE69B1000183833373030393837.mp3"},{"id":"06143648BE69B1000183132323333363130","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_重生语音","category":"复活","seq":null,"text":"死亡，不过是一场经常误入的梦。","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06143648BE69B1000183132323333363130.mp3"},{"id":"06097648BE69B1000183136353836323437","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_低血量回城1","category":"回城","seq":null,"text":"当年寻常事，回首只此身。","hasText":true,"duration":5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06097648BE69B1000183136353836323437.mp3"},{"id":"06035648BE69B1000183136303331343439","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_出生语音","category":"台词","seq":null,"text":"清夜无尘，月色如银，何人叹隙中驹，石中火，梦中身。（改编自苏轼《行香子·述怀》）","hasText":true,"duration":9.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06035648BE69B1000183136303331343439.mp3"},{"id":"06594648BE69B1000183733353436363931","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_闲置-待机2","category":"待机","seq":null,"text":"这些桃花，有时没一个人来看，只是静静开着，却也很好。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06594648BE69B1000183733353436363931.mp3"},{"id":"06801648BE69A1000183439333939353237","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3二段3","category":"技能","seq":null,"text":"物换星移","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06801648BE69A1000183439333939353237.mp3"},{"id":"06997648BE69A1000183233353530383338","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3二段1","category":"技能","seq":null,"text":"阴阳逆转","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06997648BE69A1000183233353530383338.mp3"},{"id":"06287648BE69A1000183133393034343333","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3二段4","category":"技能","seq":null,"text":"万川归一","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06287648BE69A1000183133393034343333.mp3"},{"id":"06454648BE69A1000183530383832363435","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音3二段2","category":"技能","seq":null,"text":"扭转乾坤","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06454648BE69A1000183530383832363435.mp3"},{"id":"06884648BE6991000183430333435303033","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段反击1","category":"技能","seq":null,"text":"物极必反","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06884648BE6991000183430333435303033.mp3"},{"id":"06900648BE6991000183535313238353839","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段爆气3","category":"技能","seq":null,"text":"散","hasText":true,"duration":0.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06900648BE6991000183535313238353839.mp3"},{"id":"06469648BE6991000183134393532313533","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段反击3","category":"技能","seq":null,"text":"断","hasText":true,"duration":0.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06469648BE6991000183134393532313533.mp3"},{"id":"06770648BE6991000183133333033343431","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段反击2","category":"技能","seq":null,"text":"破","hasText":true,"duration":0.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06770648BE6991000183133333033343431.mp3"},{"id":"06402648BE6981000183834333336313938","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段爆气2","category":"技能","seq":null,"text":"震","hasText":true,"duration":0.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06402648BE6981000183834333336313938.mp3"},{"id":"06971648BE6981000183134373130373537","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_技能语音2二段爆气1","category":"技能","seq":null,"text":"气动山河","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06971648BE6981000183134373130373537.mp3"},{"id":"06195648BE6901000183131373632383331","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_死亡语音2","category":"死亡","seq":null,"text":"气散风止……","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06195648BE6901000183131373632383331.mp3"},{"id":"06963648BE6901000183134353932353833","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_死亡语音3","category":"死亡","seq":null,"text":"返璞归真……","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06963648BE6901000183134353932353833.mp3"},{"id":"06609648BE6901000183130353135333239","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_死亡语音1","category":"死亡","seq":null,"text":"对不起，我食言了……","hasText":true,"duration":2.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06609648BE6901000183130353135333239.mp3"},{"id":"06300648BE6901000183839313434313436","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_大招击杀（高光）","category":"击杀","seq":null,"text":"芸芸众生，各复其归根。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06300648BE6901000183839313434313436.mp3"},{"id":"06018648BE68F1000183835313431363033","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音11","category":"移动","seq":null,"text":"能见广阔天地之眼，必是低首俯察之目。","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06018648BE68F1000183835313431363033.mp3"},{"id":"06014648BE68F1000183133333436353731","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_击杀语音2","category":"击杀","seq":null,"text":"大象无形，道隐无名。（选自《道德经》第四十一章）","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06014648BE68F1000183133333436353731.mp3"},{"id":"06739648BE68F1000183137393737343237","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_击杀语音1","category":"击杀","seq":null,"text":"一气融结，万象胚浑。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06739648BE68F1000183137393737343237.mp3"},{"id":"06740648BE68F1000183131313532313630","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_击杀语音3","category":"击杀","seq":null,"text":"和其光，同其尘。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06740648BE68F1000183131313532313630.mp3"},{"id":"06217648BE68F1000183336323431343737","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_挑衅","category":"挑衅","seq":null,"text":"尊驾来如风雨，为何去似微尘。","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06217648BE68F1000183336323431343737.mp3"},{"id":"06200648BE68E1000183135303830313538","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音8","category":"移动","seq":null,"text":"生死悠悠尔，一气聚散之。（选自柳宗元《掩役夫张进骸》）","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06200648BE68E1000183135303830313538.mp3"},{"id":"06893648BE68E1000183339333531353636","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音6","category":"移动","seq":null,"text":"就算欲望再多，也不要迷失本心。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06893648BE68E1000183339333531353636.mp3"},{"id":"06464648BE68E1000183938333632313238","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音7","category":"移动","seq":null,"text":"人生天地，若白驹过隙，忽然而已。","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06464648BE68E1000183938333632313238.mp3"},{"id":"06424648BE68E1000183131383037373039","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音5","category":"移动","seq":null,"text":"阴阳变化万千，大道亘古恒常。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06424648BE68E1000183131383037373039.mp3"},{"id":"06273648BE68E1000183531303933363636","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音10","category":"移动","seq":null,"text":"修行，亦是修心。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06273648BE68E1000183531303933363636.mp3"},{"id":"06316648BE68E1000183236353035353931","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音9","category":"移动","seq":null,"text":"人生如寄，皆是归人。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06316648BE68E1000183236353035353931.mp3"},{"id":"06318648BE68D1000183132383435323131","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_大厅语音3","category":"大厅","seq":null,"text":"生有时，死有命，顺本心，当无憾。","hasText":true,"duration":10.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06318648BE68D1000183132383435323131.mp3"},{"id":"06251648BE68D1000183332333934323434","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音1","category":"移动","seq":null,"text":"人非草木，孰能无情。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06251648BE68D1000183332333934323434.mp3"},{"id":"06265648BE68D1000183130363433363932","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音3","category":"移动","seq":null,"text":"人生一世，总有许多不能十全十美之事。","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06265648BE68D1000183130363433363932.mp3"},{"id":"06305648BE68D1000183133323130353131","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音2","category":"移动","seq":null,"text":"生和死，我早已徘徊过无数次。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06305648BE68D1000183133323130353131.mp3"},{"id":"06689648BE68D1000183133303137343537","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_移动语音4","category":"移动","seq":null,"text":"不为无益之事，何以悦有涯之生。","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06689648BE68D1000183133303137343537.mp3"},{"id":"06943648BE68C1000183838303832313534","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_大厅语音2","category":"大厅","seq":null,"text":"红尘万象，诸多烦恼，既是修行，也是乐事。","hasText":true,"duration":9.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06943648BE68C1000183838303832313534.mp3"},{"id":"06684648BE68C1000183933323438303634","heroId":"113","skinId":"790","skinName":"自在之心","title":"赵怀真_自在之心_大厅语音1","category":"大厅","seq":null,"text":"心在寰宇，自得自在。","hasText":true,"duration":12.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/113/06684648BE68C1000183933323438303634.mp3"}]
3F01000183131373736393930.mp3"},{"id":"06356648BE3F01000183438353831333032","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_first move","category":"台词","seq":null,"text":"在梦里没有禁地守护者，我只是个寻找四叶草的普通人……为了，什么愿望呢？","hasText":true,"duration":9.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06356648BE3F01000183438353831333032.mp3"},{"id":"06051648BE3F01000183136393232313138","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_移动语音4","category":"移动","seq":null,"text":"来路与归途，有时比想象中更接近","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06051648BE3F01000183136393232313138.mp3"},{"id":"06238648BE3F01000183238363536343433","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_移动语音1","category":"移动","seq":null,"text":"但凡存在，必有迹可循","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06238648BE3F01000183238363536343433.mp3"},{"id":"06293648BE3EF1000183132393636333234","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_大厅语音1","category":"大厅","seq":null,"text":"（嗯）....以守护者之名，桎梏于传说中的魔法禁地……\n我是否，也曾许下愿望？","hasText":true,"duration":20.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06293648BE3EF1000183132393636333234.mp3"},{"id":"06372648BE3EF1000183132393931353339","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_大厅语音3","category":"大厅","seq":null,"text":"嗯....(配合画面）仿佛一个似曾相识的梦……危险！……（瑶做背景音：解开记忆之锁）……过往会被封印，但未来不会","hasText":true,"duration":20.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06372648BE3EF1000183132393931353339.mp3"},{"id":"06240648BE3EF1000183134383432393336","heroId":"177","skinId":"183","skinName":"时之祈愿","title":"云中君_时之祈愿_大厅语音2","category":"大厅","seq":null,"text":"（她是）…穿越无尽迷雾……所有偶遇，皆为重逢","hasText":true,"duration":20.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06240648BE3EF1000183134383432393336.mp3"},{"id":"06495692952B21000183334383435393630","heroId":"177","skinId":"821","skinName":"流云之翼","title":"云中君-拾年声藏贺文","category":"台词","seq":null,"text":"我从未见过你的模样。\n但我记得一同飞越河流与山峦的时光。\n你我相交，何必执着于眼睛呢？\n真正的情谊，在目光难及的高处。\n随我来，飞上云梦泽最高的云端。\n迎面而来的风会告诉我，那些你一路而来的故事。","hasText":true,"duration":23,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06495692952B21000183334383435393630.mp3"},{"id":"0686565C2F6681000183238353935313833","heroId":"177","skinId":"821","skinName":"流云之翼","title":"云中君_新年快乐","category":"台词","seq":null,"text":"新年快乐","hasText":true,"duration":0.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/0686565C2F6681000183238353935313833.mp3"},{"id":"0632165C2F61E1000183333343639373230","heroId":"177","skinId":"821","skinName":"流云之翼","title":"云中君_我福了","category":"台词","seq":null,"text":"我福了","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/0632165C2F61E1000183333343639373230.mp3"},{"id":"0658865C2F68A1000183631333631373432","heroId":"177","skinId":"821","skinName":"流云之翼","title":"云中君_不必为未知的未来担心，有风保护你","category":"台词","seq":null,"text":"不必为未知的未来担心，有风保护你","hasText":true,"duration":16.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/0658865C2F68A1000183631333631373432.mp3"},{"id":"06643659E83791000183134313336303135","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方4","category":"台词","seq":null,"text":"鬼谷子：背负起沉重的职责，是云梦泽九神巫的宿命，你也不例外。","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06643659E83791000183134313336303135.mp3"},{"id":"06447659E837A1000183135323530363736","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方4","category":"台词","seq":null,"text":"云中君：东神说，那职责的名字不叫“宿命”，叫“巫神祝的虚伪”。","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06447659E837A1000183135323530363736.mp3"},{"id":"06981659E83791000183638323039303239","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方3","category":"台词","seq":null,"text":"云中君：它也永远不会停止追寻自由的答案","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06981659E83791000183638323039303239.mp3"},{"id":"06580659E83781000183839363439343033","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方2","category":"台词","seq":null,"text":"云中君：听说你是个需要仰视的男人","hasText":true,"duration":2.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06580659E83781000183839363439343033.mp3"},{"id":"06155659E83771000183137353237373831","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一-友方4","category":"台词","seq":null,"text":"云中君：窗户已经派人在修了","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06155659E83771000183137353237373831.mp3"},{"id":"06819659E83791000183632333034323636","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方2","category":"台词","seq":null,"text":"鬼谷子：听说你不曾失去一切","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06819659E83791000183632333034323636.mp3"},{"id":"06199659E83771000183132353032303735","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一-友方4","category":"台词","seq":null,"text":"东皇太一：要我说第二遍吗？砸碎玻璃的某个捣蛋鬼，你去管。","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06199659E83771000183132353032303735.mp3"},{"id":"06040659E83791000183235323537303336","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-敌方3","category":"台词","seq":null,"text":"鬼谷子：被赋予云珀的飞鸟，永远不能真正翱翔于天际。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06040659E83791000183235323537303336.mp3"},{"id":"06434659E83781000183531393836353231","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-友方1","category":"台词","seq":null,"text":"鬼谷子：阿瑶去云梦城，没有四处捣蛋吧？","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06434659E83781000183531393836353231.mp3"},{"id":"06244659E83781000183135373733333034","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到鬼谷子-友方1","category":"台词","seq":null,"text":"云中君：没有，她很好","hasText":true,"duration":2.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06244659E83781000183135373733333034.mp3"},{"id":"06834659E83761000183131343834343539","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一-友方2","category":"台词","seq":null,"text":"东皇太一：（笑声）那可真是一个……太长太“精彩”的故事，让我慢慢讲给整个云梦泽听","hasText":true,"duration":12.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06834659E83761000183131343834343539.mp3"},{"id":"06208659E83761000183133363939323634","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一-友方2","category":"台词","seq":null,"text":"云中君：天缺之祸时，上一代神巫之间到底发生了什么？","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06208659E83761000183133363939323634.mp3"},{"id":"06104659E83771000183132373136383635","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一友方3","category":"台词","seq":null,"text":"云中君：但东神你……似乎也不是第一代？","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06104659E83771000183132373136383635.mp3"},{"id":"06428659E83761000183131323733313535","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一敌方1","category":"台词","seq":null,"text":"云中君：但获得这份自由的代价，是被神巫与全知者身份束缚，对吗？","hasText":true,"duration":5.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06428659E83761000183131323733313535.mp3"},{"id":"06539659E83761000183136363335373734","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一敌方1","category":"台词","seq":null,"text":"东皇太一：鸟儿只有在天空中，才能找到所向往的自由","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06539659E83761000183136363335373734.mp3"},{"id":"06190659E83771000183137313935373932","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到东皇太一友方3","category":"台词","seq":null,"text":"东皇太一：那只小鹿是鬼谷子派来的吧？老师的学生，真是一代不如一代","hasText":true,"duration":8.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06190659E83771000183137313935373932.mp3"},{"id":"06156659E83751000183539353639393534","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶6","category":"台词","seq":null,"text":"云中君：如果…有谁特别想讲给我听的话","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06156659E83751000183539353639393534.mp3"},{"id":"06550659E83751000183333353939373830","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶6","category":"台词","seq":null,"text":"瑶：老师给我讲了一个关于小鸟的故事，你是不是也特别想听？","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06550659E83751000183333353939373830.mp3"},{"id":"06174659E83741000183334393831373330","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶4","category":"台词","seq":null,"text":"云中君：前日是虎、昨日是豹、今日是狼……我竟不知，东神城何时变得这样热闹？","hasText":true,"duration":7.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06174659E83741000183334393831373330.mp3"},{"id":"06283659E83741000183133353039373138","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶5","category":"台词","seq":null,"text":"瑶：我可没有怕黑！你……你别怕啊！（硬撑）有我保护你呢！","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06283659E83741000183133353039373138.mp3"},{"id":"06884659E83751000183131303634323235","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶5","category":"台词","seq":null,"text":"云中君：嗯，现在不怕了","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06884659E83751000183131303634323235.mp3"},{"id":"06915659E83741000183830383638363036","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶4","category":"台词","seq":null,"text":"瑶：狼来啦——云中神君，让我在你这里躲一下！","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06915659E83741000183830383638363036.mp3"},{"id":"06347659E83741000183135303330323239","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶3","category":"台词","seq":null,"text":"云中君：……想让我帮你保住诚实的话，最近别去东神面前乱晃","hasText":true,"duration":5.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06347659E83741000183135303330323239.mp3"},{"id":"06942659E83731000183639333435353433","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶2","category":"台词","seq":null,"text":"瑶：嘘——悄悄地……悄悄吓他一跳……啊（被吓到，小吸气的惊呼）","hasText":true,"duration":6.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06942659E83731000183639333435353433.mp3"},{"id":"06423659E83731000183933313933343630","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶2","category":"台词","seq":null,"text":"云中君：在背后吓人，总要先把自己的心跳收好","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06423659E83731000183933313933343630.mp3"},{"id":"06880659E83731000183133373034313433","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶1","category":"台词","seq":null,"text":"云中君：东神说，谁再捣乱就把她的鹿角割下来","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06880659E83731000183133373034313433.mp3"},{"id":"06101659E83731000183134353636383432","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶3","category":"台词","seq":null,"text":"瑶：我和小蛇打赌说你的羽毛是用云做的，赌上了我的诚实呢","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06101659E83731000183134353636383432.mp3"},{"id":"06909659E83711000183137363830323136","heroId":"177","skinId":"821","skinName":"流云之翼","title":"购买装备-贪婪之噬","category":"装备","seq":null,"text":"从未消逝的贪婪，诞生一如既往的悲剧","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06909659E83711000183137363830323136.mp3"},{"id":"06598659E83721000183937323139393235","heroId":"177","skinId":"821","skinName":"流云之翼","title":"购买装备-泣血之刃","category":"装备","seq":null,"text":"梦里，天穹毁于战火，至爱终于离散……","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06598659E83721000183937323139393235.mp3"},{"id":"06908659E83721000183235373233393239","heroId":"177","skinId":"821","skinName":"流云之翼","title":"购买装备-暗影战斧","category":"装备","seq":null,"text":"（轻笑）上次有人对我说，暗影是光芒万丈，黑色是五彩斑斓","hasText":true,"duration":5.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06908659E83721000183235373233393239.mp3"},{"id":"06945659E83721000183536363730363932","heroId":"177","skinId":"821","skinName":"流云之翼","title":"购买装备-无尽战刃","category":"装备","seq":null,"text":"或许寻回记忆，才能寻回自己","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06945659E83721000183536363730363932.mp3"},{"id":"06218659E83711000183133353036393531","heroId":"177","skinId":"821","skinName":"流云之翼","title":"购买装备-铸梦·逐风","category":"装备","seq":null,"text":"云上寂静，只得风声。不过更多时候，风也是安静的","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06218659E83711000183133353036393531.mp3"},{"id":"06069659E83721000183135393932343136","heroId":"177","skinId":"821","skinName":"流云之翼","title":"遇到瑶1","category":"台词","seq":null,"text":"瑶：昨晚我偷了你的翅膀，在天上玩了一圈~","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06069659E83721000183135393932343136.mp3"},{"id":"06228659E83701000183130313431363232","heroId":"177","skinId":"821","skinName":"流云之翼","title":"重生","category":"复活","seq":null,"text":"没有过去之人，是否真正拥有现在？","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06228659E83701000183130313431363232.mp3"},{"id":"06265659E836F1000183133313234343333","heroId":"177","skinId":"821","skinName":"流云之翼","title":"一杀","category":"台词","seq":null,"text":"又一个捣乱的家伙","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06265659E836F1000183133313234343333.mp3"},{"id":"06569659E83701000183134343634333235","heroId":"177","skinId":"821","skinName":"流云之翼","title":"出生语音\n（云中君和瑶一起出生）","category":"台词","seq":null,"text":"云中君：小鹿女么，是个最诚实的孩子。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06569659E83701000183134343634333235.mp3"},{"id":"06778659E83701000183130393537373539","heroId":"177","skinId":"821","skinName":"流云之翼","title":"低血量回城","category":"回城","seq":null,"text":"羽毛有些脏了。","hasText":true,"duration":1.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06778659E83701000183130393537373539.mp3"},{"id":"06040659E83711000183132353936303635","heroId":"177","skinId":"821","skinName":"流云之翼","title":"出生语音\n（云中君和瑶一起出生）","category":"台词","seq":null,"text":"瑶：云中神君呀，他什么都看得见！","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06040659E83711000183132353936303635.mp3"},{"id":"06347659E836F1000183934333832333733","heroId":"177","skinId":"821","skinName":"流云之翼","title":"路过野怪-鸟","category":"台词","seq":null,"text":"小鸟，你也有一颗渴望翱翔的心吗？","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06347659E836F1000183934333832333733.mp3"},{"id":"06995659E836C1000183132303934323733","heroId":"177","skinId":"821","skinName":"流云之翼","title":"击杀语音2","category":"击杀","seq":null,"text":"不如随风归去，自由无羁","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06995659E836C1000183132303934323733.mp3"},{"id":"06656659E836C1000183738363531383731","heroId":"177","skinId":"821","skinName":"流云之翼","title":"死亡语音1","category":"死亡","seq":null,"text":"这不是死，是回天上","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06656659E836C1000183738363531383731.mp3"},{"id":"06371659E836D1000183538393535393931","heroId":"177","skinId":"821","skinName":"流云之翼","title":"挑衅2","category":"挑衅","seq":null,"text":"有些人空有一双好眼睛，心却是盲的","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06371659E836D1000183538393535393931.mp3"},{"id":"06181659E836B1000183938363039323233","heroId":"177","skinId":"821","skinName":"流云之翼","title":"移动语音9","category":"移动","seq":null,"text":"当森林开始歌唱，清晨便降临了……听，声声鹿鸣","hasText":true,"duration":7,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06181659E836B1000183938363039323233.mp3"},{"id":"06377659E836C1000183739313638313832","heroId":"177","skinId":"821","skinName":"流云之翼","title":"死亡语音2","category":"死亡","seq":null,"text":"孤云只影…向谁去……","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06377659E836C1000183739313638313832.mp3"},{"id":"06220659E836C1000183732333237373733","heroId":"177","skinId":"821","skinName":"流云之翼","title":"挑衅1","category":"挑衅","seq":null,"text":"光脚的不怕穿鞋的~","hasText":true,"duration":2.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06220659E836C1000183732333237373733.mp3"},{"id":"06287659E836B1000183132333935313939","heroId":"177","skinId":"821","skinName":"流云之翼","title":"移动语音8","category":"移动","seq":null,"text":"闭上双眼，才能看清世间","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06287659E836B1000183132333935313939.mp3"},{"id":"06148659E836A1000183132383134303236","heroId":"177","skinId":"821","skinName":"流云之翼","title":"移动语音6","category":"移动","seq":null,"text":"传闻有种鸟属于天空，一生只落地一次","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06148659E836A1000183132383134303236.mp3"},{"id":"06032659E836B1000183134313534363537","heroId":"177","skinId":"821","skinName":"流云之翼","title":"移动语音7","category":"移动","seq":null,"text":"梦见过流云，又怎能安然栖居于大地","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/177/06032659E836B1000183134313534363537.mp3"}]
23130.mp3"},{"id":"06992648BE42E1000183835363536303536","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_个性动作","category":"动作","seq":null,"text":"君子怀刑，久治以永宁。","hasText":true,"duration":3.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06992648BE42E1000183835363536303536.mp3"},{"id":"06077648BE42D1000183834313730313136","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_死亡语音","category":"死亡","seq":null,"text":"微芒既现，无愧此生。","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06077648BE42D1000183834313730313136.mp3"},{"id":"06098648BE42D1000183134343837393632","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音9","category":"移动","seq":null,"text":"待到阴霾驱尽时，地上地下，共沐天光","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06098648BE42D1000183134343837393632.mp3"},{"id":"06835648BE42D1000183331353539373537","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音8","category":"移动","seq":null,"text":"邪魔乱心，非人本意，岂忍妄加罪名？","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06835648BE42D1000183331353539373537.mp3"},{"id":"06531648BE42D1000183133333436373832","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音7","category":"移动","seq":null,"text":"身处昭昭之殿，勿忘冥冥之渊。","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06531648BE42D1000183133333436373832.mp3"},{"id":"06324648BE42C1000183130303634333631","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音3","category":"移动","seq":null,"text":"书冤录百卷，奉公道常行。","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06324648BE42C1000183130303634333631.mp3"},{"id":"06835648BE42C1000183137353837323733","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音4","category":"移动","seq":null,"text":"除恶行令强者不欺弱，明法度使弱者不畏强。","hasText":true,"duration":6.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06835648BE42C1000183137353837323733.mp3"},{"id":"06450648BE42C1000183131303137343036","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音1","category":"移动","seq":null,"text":"掌审判之令，上不负浩浩青冥，下不负万象市井。","hasText":true,"duration":5.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06450648BE42C1000183131303137343036.mp3"},{"id":"06607648BE42C1000183439313539353739","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音2","category":"移动","seq":null,"text":"察其言，观其行，识其骨，辨其心。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06607648BE42C1000183439313539353739.mp3"},{"id":"06105648BE42C1000183331363036373736","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_移动语音5","category":"移动","seq":null,"text":"神器无恒心，唯以百姓之心为心。（改编自《道德经》第四十九章）","hasText":true,"duration":3.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06105648BE42C1000183331363036373736.mp3"},{"id":"06195648BE42B1000183536323437313837","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_大厅语音1","category":"大厅","seq":null,"text":"镇邪魔，守太平。","hasText":true,"duration":19.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06195648BE42B1000183536323437313837.mp3"},{"id":"06494648BE42B1000183238383730343831","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_大厅语音3","category":"大厅","seq":null,"text":"辨善恶，定人心——狴犴听令，魔秽肃清。","hasText":true,"duration":15.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06494648BE42B1000183238383730343831.mp3"},{"id":"06432648BE42B1000183136313238313333","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰_神器·狴犴令_大厅语音2","category":"大厅","seq":null,"text":"生为天定，命由人断。","hasText":true,"duration":20.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06432648BE42B1000183136313238313333.mp3"},{"id":"06076647868911000183134383036373439","heroId":"217","skinId":"788","skinName":"神器·狴犴令","title":"狄仁杰
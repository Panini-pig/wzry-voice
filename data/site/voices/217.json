[{"id":"0607667C0111D1000183830313439353235","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"技能语音3-1","category":"技能","seq":1,"text":"姝色自倾城！","hasText":true,"duration":1.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0607667C0111D1000183830313439353235.mp3"},{"id":"0687467C0111D1000183137333034333933","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"技能语音2-1","category":"技能","seq":1,"text":"集诸芳！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0687467C0111D1000183137333034333933.mp3"},{"id":"0697667C0111E1000183133383135303835","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"技能语音3-2","category":"技能","seq":2,"text":"韶期有限，翰墨千秋。","hasText":true,"duration":2.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0697667C0111E1000183133383135303835.mp3"},{"id":"0662867C0111D1000183134323034303732","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"技能语音2-2","category":"技能","seq":2,"text":"篆菁华！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0662867C0111D1000183134323034303732.mp3"},{"id":"0665867C0111E1000183137303535373535","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"技能语音3-3","category":"技能","seq":3,"text":"寰海清夷，天香同放。","hasText":true,"duration":2.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0665867C0111E1000183137303535373535.mp3"},{"id":"0697467C0111F1000183136313730353437","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"相遇明世隐","category":"相遇","seq":null,"text":"听闻阁下催花轶事，不若入我三尺画幅？","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0697467C0111F1000183136313730353437.mp3"},{"id":"0652367C0111E1000183134323832363230","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"个性动作","category":"动作","seq":null,"text":"花寄时人痴愿，笔传我辈高情！","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0652367C0111E1000183134323832363230.mp3"},{"id":"0664767C0111B1000183133363438353439","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话6","category":"移动","seq":null,"text":"列朝兴废皆过眼，愿留一卷，但留一卷。","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0664767C0111B1000183133363438353439.mp3"},{"id":"0680967C0111B1000183530393839383334","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话7","category":"移动","seq":null,"text":"舟载繁卉，担荷仙葩，万户楼台同胜会！","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0680967C0111B1000183530393839383334.mp3"},{"id":"0674867C0111C1000183134343333323430","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"击杀","category":"击杀","seq":null,"text":"长卷既成，宜当钤印。","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0674867C0111C1000183134343333323430.mp3"},{"id":"0650867C0111D1000183136383435343230","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"挑衅","category":"挑衅","seq":null,"text":"光阴雕琢世物，遗下长青臻萃，也留下尘垢秕糠。","hasText":true,"duration":6.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0650867C0111D1000183136383435343230.mp3"},{"id":"0664767C0111C1000183133303534383736","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"死亡","category":"死亡","seq":null,"text":"梦中犹看洛阳花……","hasText":true,"duration":3.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0664767C0111C1000183133303534383736.mp3"},{"id":"0677567C0111C1000183135383230353130","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"死亡","category":"死亡","seq":null,"text":"去吧，后世当见此太平——","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0677567C0111C1000183135383230353130.mp3"},{"id":"0603267C0111A1000183132323036333631","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"大厅喊话3","category":"大厅","seq":null,"text":"千载留观，此卷清平！","hasText":true,"duration":17.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0603267C0111A1000183132323036333631.mp3"},{"id":"0620767C0111A1000183130383030323832","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话3","category":"移动","seq":null,"text":"御衣黄，云华妆，人为花至，花应人昌。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0620767C0111A1000183130383030323832.mp3"},{"id":"0675467C0111A1000183134303533373634","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话2","category":"移动","seq":null,"text":"栏边、鬓边、诗篇，丹青画图里，生民所愿中。","hasText":true,"duration":7.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0675467C0111A1000183134303533373634.mp3"},{"id":"0663167C0111B1000183533383332393332","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话5","category":"移动","seq":null,"text":"立万象于胸怀，传千祀于毫翰。","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0663167C0111B1000183533383332393332.mp3"},{"id":"0677567C0111B1000183136363138363238","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话4","category":"移动","seq":null,"text":"名为盛世的画屏上，你我可被描绘？","hasText":true,"duration":4.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0677567C0111B1000183136363138363238.mp3"},{"id":"0644267C0111A1000183134353835343933","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"移动喊话1","category":"移动","seq":null,"text":"巍巍洛阳世无双，恰如牡丹冠群芳！","hasText":true,"duration":5.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0644267C0111A1000183134353835343933.mp3"},{"id":"0640767C011191000183135333436313738","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"大厅喊话2","category":"大厅","seq":null,"text":"观花知国事，造艺见风俗。 \n今朝图好景，赠予后来人。","hasText":true,"duration":17,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0640767C011191000183135333436313738.mp3"},{"id":"0618767C011191000183935313834323236","heroId":"217","skinId":"1459","skinName":"绮世丹青","title":"大厅喊话1","category":"大厅","seq":null,"text":"来，与这盛世相逢！","hasText":true,"duration":17.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/0618767C011191000183935313834323236.mp3"},{"id":"06923698C1F211000183136303030323835","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音3-1","category":"技能","seq":1,"text":"文牒引路！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06923698C1F211000183136303030323835.mp3"},{"id":"06957698C1F201000183533333235333535","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音1-1","category":"技能","seq":1,"text":"出祁连！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06957698C1F201000183533333235333535.mp3"},{"id":"06226698C1F211000183635373635373632","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音2-1","category":"技能","seq":1,"text":"黄沙漫道！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06226698C1F211000183635373635373632.mp3"},{"id":"06609698C1F221000183530333534343736","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音3-2","category":"技能","seq":2,"text":"途万里，关万重！","hasText":true,"duration":2.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06609698C1F221000183530333534343736.mp3"},{"id":"06992698C1F211000183438363033373833","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音2-2","category":"技能","seq":2,"text":"朔风纵横！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06992698C1F211000183438363033373833.mp3"},{"id":"06879698C1F211000183137363531373438","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音1-2","category":"技能","seq":2,"text":"越关山！","hasText":true,"duration":1.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06879698C1F211000183137363531373438.mp3"},{"id":"06776698C1F221000183134353532333831","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"技能语音3-3","category":"技能","seq":3,"text":"唯此心不移！","hasText":true,"duration":1.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06776698C1F221000183134353532333831.mp3"},{"id":"06977698C1F261000183138333635373839","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-关羽2","category":"台词","seq":null,"text":"狄仁杰：来使曾盛赞此处双石塔，历经地动而不倒。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06977698C1F261000183138333635373839.mp3"},{"id":"06529698C1F261000183134313537353530","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-关羽1","category":"台词","seq":null,"text":"狄仁杰：一如“锋刃损，海舆广”，所谓同义。","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06529698C1F261000183134313537353530.mp3"},{"id":"06048698C1F251000183234353437363333","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-马超2","category":"台词","seq":null,"text":"狄仁杰：云缨带回来的“特产”，说定要我们尝尝（嘶——）","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06048698C1F251000183234353437363333.mp3"},{"id":"06813698C1F231000183132353038333435","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-貂蝉2","category":"台词","seq":null,"text":"狄仁杰：西出阳关，此后尽是故人。","hasText":true,"duration":3.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06813698C1F231000183132353038333435.mp3"},{"id":"06114698C1F241000183431363033363330","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-云缨1","category":"台词","seq":null,"text":"狄仁杰：舞枪炫技，惊扰旅者，看来需罚抄——","hasText":true,"duration":7.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06114698C1F241000183431363033363330.mp3"},{"id":"06536698C1F251000183835303534333535","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-马超1","category":"台词","seq":null,"text":"狄仁杰：天光已晦，当息烛安睡。","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06536698C1F251000183835303534333535.mp3"},{"id":"06463698C1F241000183132383437323731","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-云缨2","category":"台词","seq":null,"text":"狄仁杰：做神应低调，首在护人，次为灭贼……","hasText":true,"duration":4.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06463698C1F241000183132383437323731.mp3"},{"id":"06507698C1F221000183131393736373631","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"个性动作","category":"动作","seq":null,"text":"远方的友人，一切安好。","hasText":true,"duration":3.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06507698C1F221000183131393736373631.mp3"},{"id":"06577698C1F231000183236303138323835","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"狄仁杰-貂蝉1","category":"台词","seq":null,"text":"狄仁杰：云缨写得实在浮夸，忍不住给她“修正”一番。","hasText":true,"duration":5.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06577698C1F231000183236303138323835.mp3"},{"id":"06155698C1F201000183833363035343338","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"IDLE","category":"台词","seq":null,"text":"万里易行，神驹难养……哎，沙砾不可食！","hasText":true,"duration":6.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06155698C1F201000183833363035343338.mp3"},{"id":"06847698C1F1F1000183134333331383438","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"挑衅","category":"挑衅","seq":null,"text":"做人做事贵在坚持，不似阁下总是“半途而废”。","hasText":true,"duration":6.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06847698C1F1F1000183134333331383438.mp3"},{"id":"06516698C1F1F1000183536393535353938","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"死亡","category":"死亡","seq":null,"text":"携我节杖，前行……","hasText":true,"duration":4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06516698C1F1F1000183536393535353938.mp3"},{"id":"06218698C1F201000183137323038333239","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"回城","category":"回城","seq":null,"text":"天涯有信，四海同归","hasText":true,"duration":3.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06218698C1F201000183137323038333239.mp3"},{"id":"06529698C1F1F1000183830323931393138","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话8","category":"移动","seq":null,"text":"此城果脯……于我略甜，但那几位朋友定会喜欢。","hasText":true,"duration":5.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06529698C1F1F1000183830323931393138.mp3"},{"id":"06583698C1F1E1000183832393536383732","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话7","category":"移动","seq":null,"text":"“寝食俱安，家中勿念……”游子离乡千里，所寄不过“平安”二字。","hasText":true,"duration":8.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06583698C1F1E1000183832393536383732.mp3"},{"id":"06500698C1F1D1000183636373037373530","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话2","category":"移动","seq":null,"text":"吾尝闻，使君此去十三载，节旌（jīng）尽落未肯拜。","hasText":true,"duration":6.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06500698C1F1D1000183636373037373530.mp3"},{"id":"06357698C1F1D1000183135383835363131","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话3","category":"移动","seq":null,"text":"涉（shè）流沙，径（jìng）千里，凿空瀚漠，白首不移。","hasText":true,"duration":6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06357698C1F1D1000183135383835363131.mp3"},{"id":"06475698C1F1E1000183933373030333430","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话5","category":"移动","seq":null,"text":"再听阳关三叠，便如故友再见。","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06475698C1F1E1000183933373030333430.mp3"},{"id":"06529698C1F1F1000183238343132353731","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"击杀","category":"击杀","seq":null,"text":"万邦皆通！","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06529698C1F1F1000183238343132353731.mp3"},{"id":"06508698C1F1E1000183339323331313838","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话4","category":"移动","seq":null,"text":"大漠无涯，积跬步（kuǐ bù）以为疆；时节如流，持恒心以为志。","hasText":true,"duration":7.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06508698C1F1E1000183339323331313838.mp3"},{"id":"06794698C1F1E1000183134363834383639","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话6","category":"移动","seq":null,"text":"昔年舆图难竟，却有后来者以步作笔，续写千秋。","hasText":true,"duration":6.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06794698C1F1E1000183134363834383639.mp3"},{"id":"06949698C1F1C1000183134373735353531","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"大厅喊话2","category":"大厅","seq":null,"text":"开朔漠之道，志百代舆图！","hasText":true,"duration":22,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06949698C1F1C1000183134373735353531.mp3"},{"id":"06531698C1F1D1000183134393236333630","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"移动喊话1","category":"移动","seq":null,"text":"持节定邦，万里无疆！","hasText":true,"duration":3.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06531698C1F1D1000183134393236333630.mp3"},{"id":"06513698C1F1C1000183634313134333534","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"大厅喊话3","category":"大厅","seq":null,"text":"万里黄沙连远塞，春风又度几重关。","hasText":true,"duration":22,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06513698C1F1C1000183634313134333534.mp3"},{"id":"06351698C1F1D1000183130383534363035","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"泉水喊话","category":"大厅","seq":null,"text":"乘风起，驰万里","hasText":true,"duration":3.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06351698C1F1D1000183130383534363035.mp3"},{"id":"06949698C1F1C1000183132343739303233","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"大厅喊话1","category":"大厅","seq":null,"text":"神骥踏长风，丝路启千秋！","hasText":true,"duration":22,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06949698C1F1C1000183132343739303233.mp3"},{"id":"06237698BF9291000183134303634313538","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"朵莉亚-狄仁杰2","category":"台词","seq":null,"text":"狄仁杰：果脯蜜饯、曲谱画卷……回京华的路这么远，你就带了这些？","hasText":true,"duration":7.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06237698BF9291000183134303634313538.mp3"},{"id":"06967698BF9281000183132383436323530","heroId":"217","skinId":"1702","skinName":"神骥·赴朔漠","title":"朵莉亚-狄仁杰1","category":"台词","seq":null,"text":"狄仁杰：哦？是我这几本——被垫在桌角下的书吗？","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06967698BF9281000183132383436323530.mp3"},{"id":"062566A8679A51000183133383631383034","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音3-1","category":"技能","seq":1,"text":"惊虹掣电！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/062566A8679A51000183133383631383034.mp3"},{"id":"069256A8679A41000183133333630333839","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音1-1","category":"技能","seq":1,"text":"挟霜！","hasText":true,"duration":1.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/069256A8679A41000183133333630333839.mp3"},{"id":"060086A8679A51000183334373539333533","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音2-1","category":"技能","seq":1,"text":"刀上无招！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/060086A8679A51000183334373539333533.mp3"},{"id":"062576A8679A51000183231383736323639","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音3-2","category":"技能","seq":2,"text":"例无虚发！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/062576A8679A51000183231383736323639.mp3"},{"id":"066476A8679A51000183136313539393430","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音2-2","category":"技能","seq":2,"text":"心中有招！","hasText":true,"duration":1.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/066476A8679A51000183136313539393430.mp3"},{"id":"064596A8679A41000183938343739363535","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音1-2","category":"技能","seq":2,"text":"飞花！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/064596A8679A41000183938343739363535.mp3"},{"id":"065666A8679A61000183938343133303634","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音3-3","category":"技能","seq":3,"text":"妙参造化！","hasText":true,"duration":1.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/065666A8679A61000183938343133303634.mp3"},{"id":"066396A8679A61000183136343033313335","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"技能语音3-4","category":"技能","seq":4,"text":"无迹可寻！","hasText":true,"duration":1.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/066396A8679A61000183136343033313335.mp3"},{"id":"068386A8679A61000183130363234323933","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"个性动作","category":"动作","seq":null,"text":"古来圣贤皆寂寞、唯有饮者留其名……但饮者又何尝不寂寞……","hasText":true,"duration":9.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/068386A8679A61000183130363234323933.mp3"},{"id":"061756A8679A31000183530333631373931","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"复活","category":"复活","seq":null,"text":"看来一个人想活固然艰苦，若要静静地死，也不容易。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/061756A8679A31000183530333631373931.mp3"},{"id":"068346A8679A41000183339393338303930","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"挑衅","category":"挑衅","seq":null,"text":"卿本佳人，奈何做贼？","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/068346A8679A41000183339393338303930.mp3"},{"id":"066026A8679A31000183836383934393931","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"死亡","category":"死亡","seq":null,"text":"生有何欢，死有何惧？","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/066026A8679A31000183836383934393931.mp3"},{"id":"060556A8679A31000183532383331393434","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"击杀","category":"击杀","seq":null,"text":"杀人者人恒杀之。","hasText":true,"duration":4.6,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/060556A8679A31000183532383331393434.mp3"},{"id":"065076A8679A11000183130313234373137","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音2","category":"移动","seq":null,"text":"我平生最怕麻烦，麻烦为什么总要找上我？","hasText":true,"duration":4.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/065076A8679A11000183130313234373137.mp3"},{"id":"065956A8679A21000183133373833303331","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音6","category":"移动","seq":null,"text":"相见争如不见，见了又能如何？","hasText":true,"duration":4.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/065956A8679A21000183133373833303331.mp3"},{"id":"062186A8679A11000183131313533333730","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音3","category":"移动","seq":null,"text":"仇人多多益善，朋友一两个便足够，因为有时朋友比仇人还要可怕得多。","hasText":true,"duration":8.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/062186A8679A11000183131313533333730.mp3"},{"id":"064146A8679A21000183334303630373332","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音5","category":"移动","seq":null,"text":"痴于剑的人，才能练成精妙的剑法；痴于情的人，才能得到别人的真情。","hasText":true,"duration":8.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/064146A8679A21000183334303630373332.mp3"},{"id":"066186A8679A31000183136313637323035","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音7","category":"移动","seq":null,"text":"月上梅梢，佳人有约，阁下又何苦煮鹤焚琴，大杀风景呢。","hasText":true,"duration":8.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/066186A8679A31000183136313637323035.mp3"},{"id":"062836A8679A21000183131313437373031","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音4","category":"移动","seq":null,"text":"醉了又有什么不好，人生难得几回醉。","hasText":true,"duration":4.2,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/062836A8679A21000183131313437373031.mp3"},{"id":"060736A8679A11000183232363837363133","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"移动语音1","category":"移动","seq":null,"text":"人予我一分，我报他三分。","hasText":true,"duration":3.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/060736A8679A11000183232363837363133.mp3"},{"id":"066706A82B2C41000183134363831393133","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"大厅语音3","category":"大厅","seq":null,"text":"起雾了，明天一定是好天气。","hasText":true,"duration":12.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/066706A82B2C41000183134363831393133.mp3"},{"id":"069296A82B2C31000183535333233313039","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"大厅语音1","category":"大厅","seq":null,"text":"只道无情却有情，情到浓时情转薄——","hasText":true,"duration":14.1,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/069296A82B2C31000183535333233313039.mp3"},{"id":"064406A82B2C41000183135333836353639","heroId":"217","skinId":"1777","skinName":"小李飞刀","title":"大厅语音2","category":"大厅","seq":null,"text":"在下李寻欢。","hasText":true,"duration":12.8,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/064406A82B2C41000183135333836353639.mp3"},{"id":"067386AB32DAD1000183230363433333134","heroId":"217","skinId":"777","skinName":"断案大师","title":"相遇语音（友方-王维|狄仁杰）-S1_L2","category":"相遇","seq":null,"text":"事有可疑，必究其源。山长所教，怀英一字不敢忘。","hasText":true,"duration":6.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/067386AB32DAD1000183230363433333134.mp3"},{"id":"06123697B1AFE1000183133313735373730","heroId":"217","skinId":"777","skinName":"断案大师","title":"狄仁杰_营地春节语音","category":"台词","seq":null,"text":"今日无事，不如对弈一局","hasText":true,"duration":3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06123697B1AFE1000183133313735373730.mp3"},{"id":"06529692952831000183137303331323134","heroId":"217","skinId":"777","skinName":"断案大师","title":"狄仁杰-拾年声藏贺文","category":"台词","seq":null,"text":"我们也算十年搭档了。\n你还是和刚来大理寺的时候一样，正义又勇敢。\n下一个十年，让我们继续并肩前行。\n用推理撕碎阴霾，让罪犯无处遁形。\n长安的和平，由你我共同守护。\n记住，正义从不妥协！","hasText":true,"duration":22.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06529692952831000183137303331323134.mp3"},{"id":"06622648BE4211000183137343134383339","heroId":"217","skinId":"777","skinName":"断案大师","title":"狄仁杰_断案大师_挑衅","category":"挑衅","seq":null,"text":"罪犯们，逍遥法外的好日子结束了！","hasText":true,"duration":4.9,"audio":"https://audio.wzry.panini-pigs.cn/audio/217/06622648BE4211000183137343134383339.mp3"},{"id":"06587648BE4211000183832303632343332","heroId":"217","skinId":"777","skinName":"断案大师","title":"狄仁杰_断案大师_击杀语音","category":"击杀","seq":null,"text":"接
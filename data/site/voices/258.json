inId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_移动语音4","category":"移动","seq":null,"text":"民为根本，食为民天，仓廪丰盈社稷安","hasText":true,"duration":6.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06422648BE3C11000183135343934353038.mp3"},{"id":"06202648BE3C11000183630323933333134","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_移动语音2","category":"移动","seq":null,"text":"气候有盈缩，阴阳自消长（改编自《陈旉农书》）","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06202648BE3C11000183630323933333134.mp3"},{"id":"06407648BE3C11000183938343336303633","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_移动语音3","category":"移动","seq":null,"text":"春晖一缕，膏壤两方，雨露淅沥三四场","hasText":true,"duration":5.4,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06407648BE3C11000183938343336303633.mp3"},{"id":"06016648BE3C11000183131383330373432","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_移动语音6","category":"移动","seq":null,"text":"他只是路过人间，却留下了种子","hasText":true,"duration":4.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06016648BE3C11000183131383330373432.mp3"},{"id":"06850648BE3C01000183138323231303831","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_大厅语音1","category":"大厅","seq":null,"text":"集天地之造化，汇农人之劳苦","hasText":true,"duration":30,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06850648BE3C01000183138323231303831.mp3"},{"id":"06952648BE3C01000183636363036313131","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_大厅语音2","category":"大厅","seq":null,"text":"丹雀衔五穗，人间始丰登","hasText":true,"duration":30,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06952648BE3C01000183636363036313131.mp3"},{"id":"06152648BE3C01000183134313237303333","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_移动语音1","category":"移动","seq":null,"text":"察天时，用地利，勤治田亩","hasText":true,"duration":4.7,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06152648BE3C01000183134313237303333.mp3"},{"id":"06044648BE3C01000183336373631343932","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年_大厅语音3","category":"大厅","seq":null,"text":"寻嘉禾，济苍生","hasText":true,"duration":30.3,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06044648BE3C01000183336373631343932.mp3"},{"id":"06732647862091000183739383633323635","heroId":"258","skinId":"406","skinName":"五谷丰年","title":"鬼谷子_五谷丰年","category":"台词","seq":null,"text":"鬼谷子_五谷丰年","hasText":false,"duration":312.5,"audio":"https://audio.wzry.panini-pigs.cn/audio/258/06732647862091000183739383633323635.mp3"}]